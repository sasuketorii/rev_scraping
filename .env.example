# =============================================================================
# rev_scraping — Environment Template
# =============================================================================
# Copy this file to `.env` (which is gitignored) and fill in real values.
#   cp .env.example .env
#   chmod 600 .env
# NEVER commit `.env` or any file containing real credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# VPN — Multi-instance Gluetun pool (Phase 6a)
# -----------------------------------------------------------------------------

# Supported providers: surfshark, mullvad, protonvpn, nordvpn, ...
# (See https://github.com/qdm12/gluetun-wiki for the full list.)
VPN_PROVIDER=surfshark

# Provider OpenVPN credentials.
# For Surfshark, obtain these from: https://my.surfshark.com/vpn/manual-setup/main/openvpn
# Keep these SECRET. The `.env` file MUST be chmod 600.
VPN_USER=your-openvpn-username-here
VPN_PASSWORD=your-openvpn-password-here

# Comma-separated list of countries Gluetun is allowed to pick exit servers in.
# Examples: "Japan", "Japan,Singapore", "United States"
VPN_COUNTRIES=Japan

# Gluetun instance topology.
# Format:  <container_name>:<http_proxy_port>:<control_port>[,<next>...]
#   - container_name : docker container/service name (must match compose service)
#   - http_proxy_port: host port that exposes Gluetun's HTTP proxy (8888 inside)
#   - control_port   : host port that exposes Gluetun's control API (8000 inside)
# The three-instance default below is what `docker-compose.vpn.yml` ships with.
VPN_INSTANCES=vpn-1:8001:8881,vpn-2:8002:8882,vpn-3:8003:8883

# -----------------------------------------------------------------------------
# Optional knobs (uncomment to override defaults)
# -----------------------------------------------------------------------------

# Threshold for LazyOnFail rotation strategy (vpn-rotate crate).
#REV_STEALTH_VPN_FAIL_THRESHOLD=3

# Enable docker-touching unit tests (off by default).
#REV_STEALTH_RUN_DOCKER_TESTS=0
