          "ready_for_next",
          "needs_fix",
          "needs_more_context",
          "blocked"
        ],
        "consumers": [
          "docs/prompts/_archive/role-operating-templates-v0.md",
          "docs/roles/coder/specialties/*.md",
          "docs/roles/reviewer/specialties/*.md",
          "docs/roles/orchestrator/specialties/*.md",
          ".agent/active/plan_*.md handoff yaml"
        ]
      },
      "execplan_state": {
        "rationale": "ExecPlan artifact lifecycle state; separates plan-artifact disposition (proposed/accepted/superseded) from matrix review status.",
        "values": [
          "proposed",
          "accepted",
          "superseded"
        ],
        "consumers": [
          ".agent/active/plan_*.md front-matter"
        ]
      }
    }
  },
