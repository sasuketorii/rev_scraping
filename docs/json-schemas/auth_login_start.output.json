{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "auth_login_start.output",
  "description": "Phase-1 response from `auth_login_start`. Carries the single-use session_token the agent must pass back into `auth_login_complete`. Cookie values are never returned.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "session_token",
    "login_window_pid",
    "profile",
    "domain",
    "cookie_values_returned"
  ],
  "properties": {
    "ok": {
      "type": "boolean",
      "description": "True when rev-auth was spawned successfully and a session_token was minted.",
      "examples": [
        true
      ]
    },
    "session_token": {
      "type": "string",
      "description": "Single-use token (UUIDv4 or opaque) that must be passed to `auth_login_complete`. Invalidated after one successful complete call.",
      "examples": [
        "sess_b2f9b1c0e2"
      ]
    },
    "login_window_pid": {
      "type": "integer",
      "description": "OS PID of the spawned rev-auth helper window. The agent does not own this PID; surfaced for diagnostics only.",
      "examples": [
        12345
      ]
    },
    "profile": {
      "type": "string",
      "description": "Auth profile name the cookies will be saved under on successful completion.",
      "examples": [
        "example_main"
      ]
    },
    "domain": {
      "type": "string",
      "description": "Resolved cookie scope domain (caller-supplied or derived from URL host).",
      "examples": [
        "example.com"
      ]
    },
    "hint": {
      "type": "string",
      "description": "Human-readable next-step hint for the agent to relay to the user.",
      "examples": [
        "Complete login in opened browser, then call auth_login_complete."
      ]
    },
    "cookie_values_returned": {
      "type": "boolean",
      "description": "Always false. Present as a contract marker that cookie material is never exposed via MCP.",
      "examples": [
        false
      ]
    },
    "_meta": {
      "type": "object",
      "description": "P13.4: sanitize-pass metadata attached by stealth-mcp before this payload becomes LLM-visible. Always present; agents can ignore it unless inspecting prompt-injection telemetry. Shape stable per `stealth-sanitize::SanitizationReport` (schema_version=1).",
      "additionalProperties": true,
      "properties": {
        "sanitize": {
          "type": "object",
          "description": "Resolved sanitize report. See `stealth_sanitize::SanitizationReport` for the canonical shape.",
          "additionalProperties": true,
          "properties": {
            "schema_version": {
              "type": "integer",
              "examples": [
                1
              ]
            },
            "policy_name": {
              "type": "string",
              "examples": [
                "strict",
                "balanced",
                "passthrough"
              ]
            },
            "mode": {
              "type": "string",
              "enum": [
                "off",
                "warn",
                "enforce"
              ],
              "examples": [
                "warn"
              ]
            },
            "bytes_in": {
              "type": "integer",
              "examples": [
                128
              ]
            },
            "bytes_out": {
              "type": "integer",
              "examples": [
                180
              ]
            },
            "truncated": {
              "type": "boolean",
              "examples": [
                false
              ]
            },
            "aborted": {
              "type": "boolean",
              "examples": [
                false
              ]
            },
            "layers_applied": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "examples": [
                [
                  "L4:unicode",
                  "L2:envelope",
                  "L7:meta"
                ]
              ]
            },
            "canary_hits": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "examples": [
                []
              ]
            },
            "sanitize_id": {
              "type": "string",
              "description": "64-bit hex nonce.",
              "examples": [
                "a1b2c3d4e5f60718"
              ]
            }
          }
        }
      },
      "examples": [
        {
          "sanitize": {
            "schema_version": 1,
            "policy_name": "balanced",
            "mode": "warn",
            "bytes_in": 12,
            "bytes_out": 60,
            "truncated": false,
            "aborted": false,
            "layers_applied": [
              "L2:envelope",
              "L7:meta"
            ],
            "canary_hits": [],
            "sanitize_id": "a1b2c3d4e5f60718"
          }
        }
      ]
    }
  }
}
