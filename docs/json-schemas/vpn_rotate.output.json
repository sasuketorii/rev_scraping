{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "vpn_rotate.output",
  "description": "Envelope returned by the `vpn_rotate` MCP tool. stealth-cli `vpn rotate --format json` emits two variants: success `{ok:true, operation:\"vpn.rotate\", result:{rotated,container,previous_ip,new_ip,elapsed_ms,reason}}` and failure `{ok:false, operation:\"vpn.rotate\", exit_code, error}`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "operation"
  ],
  "properties": {
    "ok": {
      "type": "boolean",
      "description": "True on success, false on CLI error.",
      "examples": [
        true,
        false
      ]
    },
    "operation": {
      "type": "string",
      "description": "Operation tag emitted by stealth-cli. Always `vpn.rotate` (with dot, NOT hyphen).",
      "examples": [
        "vpn.rotate"
      ]
    },
    "result": {
      "type": "object",
      "description": "Success-only rotation payload mirroring `vpn_rotate::RotationReport` plus the echoed `reason`. Absent on failure.",
      "additionalProperties": false,
      "required": [
        "rotated",
        "container",
        "reason"
      ],
      "properties": {
        "rotated": {
          "type": "boolean",
          "description": "True when the VPN exit was actually changed. False for no-op rotations (e.g. lazy-on-fail when no failure was detected).",
          "examples": [
            true,
            false
          ]
        },
        "container": {
          "type": "string",
          "description": "Docker container name that hosts the VPN client (typically `gluetun`).",
          "examples": [
            "gluetun"
          ]
        },
        "previous_ip": {
          "type": [
            "string",
            "null"
          ],
          "description": "Exit IP observed before rotation. Null on the first probe or when probing failed.",
          "examples": [
            "198.51.100.42"
          ]
        },
        "new_ip": {
          "type": [
            "string",
            "null"
          ],
          "description": "Exit IP observed after rotation. Null when post-rotation probing failed.",
          "examples": [
            "203.0.113.17"
          ]
        },
        "elapsed_ms": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Wall-clock milliseconds spent on the rotation (including probes).",
          "examples": [
            4231
          ]
        },
        "reason": {
          "type": "string",
          "description": "Echoed reason from the request (free-form audit string).",
          "examples": [
            "cf-challenge",
            "manual"
          ]
        }
      }
    },
    "exit_code": {
      "type": "integer",
      "description": "Failure-only CLI exit code.",
      "examples": [
        1,
        2
      ]
    },
    "error": {
      "type": "string",
      "description": "Failure-only human-readable message.",
      "examples": [
        "rotation failed: gluetun not running"
      ]
    },
    "_meta": {
      "type": "object",
      "description": "P13.4: sanitize-pass metadata attached by stealth-mcp before this payload becomes LLM-visible. Always present; agents can ignore it unless inspecting prompt-injection telemetry. Shape stable per `stealth-sanitize::SanitizationReport` (schema_version=1).",
      "additionalProperties": true,
      "properties": {
        "sanitize": {
          "type": "object",
          "description": "Resolved sanitize report. See `stealth_sanitize::SanitizationReport` for the canonical shape.",
          "additionalProperties": true,
          "properties": {
            "schema_version": {
              "type": "integer",
              "examples": [
                1
              ]
            },
            "policy_name": {
              "type": "string",
              "examples": [
                "strict",
                "balanced",
                "passthrough"
              ]
            },
            "mode": {
              "type": "string",
              "enum": [
                "off",
                "warn",
                "enforce"
              ],
              "examples": [
                "warn"
              ]
            },
            "bytes_in": {
              "type": "integer",
              "examples": [
                128
              ]
            },
            "bytes_out": {
              "type": "integer",
              "examples": [
                180
              ]
            },
            "truncated": {
              "type": "boolean",
              "examples": [
                false
              ]
            },
            "aborted": {
              "type": "boolean",
              "examples": [
                false
              ]
            },
            "layers_applied": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "examples": [
                [
                  "L4:unicode",
                  "L2:envelope",
                  "L7:meta"
                ]
              ]
            },
            "canary_hits": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "examples": [
                []
              ]
            },
            "sanitize_id": {
              "type": "string",
              "description": "64-bit hex nonce.",
              "examples": [
                "a1b2c3d4e5f60718"
              ]
            }
          }
        }
      },
      "examples": [
        {
          "sanitize": {
            "schema_version": 1,
            "policy_name": "balanced",
            "mode": "warn",
            "bytes_in": 12,
            "bytes_out": 60,
            "truncated": false,
            "aborted": false,
            "layers_applied": [
              "L2:envelope",
              "L7:meta"
            ],
            "canary_hits": [],
            "sanitize_id": "a1b2c3d4e5f60718"
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "required": [
        "ok",
        "operation",
        "result"
      ],
      "properties": {
        "ok": {
          "const": true
        }
      }
    },
    {
      "required": [
        "ok",
        "operation",
        "exit_code",
        "error"
      ],
      "properties": {
        "ok": {
          "const": false
        }
      }
    }
  ]
}
