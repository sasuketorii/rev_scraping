{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "auth_list.output",
  "description": "Response from `auth_list`. Enumerates ProfileMeta for every stored auth profile. Cookie values are never disclosed; only SHA-256-prefix hashes of cookie names feed the `cookie_count`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profiles",
    "total",
    "cookie_values_returned"
  ],
  "properties": {
    "profiles": {
      "type": "array",
      "description": "Per-profile metadata. Empty when no profiles are stored or the auth_dir does not yet exist.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile",
          "domains",
          "created_at",
          "last_used",
          "cookie_count",
          "status"
        ],
        "properties": {
          "profile": {
            "type": "string",
            "description": "Profile name.",
            "examples": [
              "example_main"
            ]
          },
          "domains": {
            "type": "array",
            "description": "Cookie scope domains covered by this profile.",
            "items": {
              "type": "string"
            },
            "examples": [
              [
                "example.com"
              ]
            ]
          },
          "created_at": {
            "type": "string",
            "description": "RFC-3339 timestamp of profile creation.",
            "examples": [
              "2026-03-04T12:00:00+00:00"
            ]
          },
          "last_used": {
            "type": "string",
            "description": "RFC-3339 timestamp of the most recent profile use.",
            "examples": [
              "2026-05-21T09:15:42+00:00"
            ]
          },
          "cookie_count": {
            "type": "integer",
            "description": "Number of cookies recorded (derived from SHA-256 name-prefix metadata).",
            "examples": [
              5
            ]
          },
          "status": {
            "type": "string",
            "description": "Freshness classification for the profile.",
            "enum": [
              "Valid",
              "ExpiringSoon",
              "ExpiringCritical",
              "PartiallyExpired",
              "AllExpired",
              "Missing"
            ],
            "examples": [
              "Valid",
              "ExpiringSoon"
            ]
          }
        }
      },
      "examples": [
        []
      ]
    },
    "total": {
      "type": "integer",
      "description": "Total profiles returned. Equals profiles.length.",
      "examples": [
        0,
        3
      ]
    },
    "cookie_values_returned": {
      "type": "boolean",
      "description": "Always false. Contract marker.",
      "examples": [
        false
      ]
    },
    "_meta": {
      "type": "object",
      "description": "P13.4: sanitize-pass metadata attached by stealth-mcp before this payload becomes LLM-visible. Always present; agents can ignore it unless inspecting prompt-injection telemetry. Shape stable per `stealth-sanitize::SanitizationReport` (schema_version=1).",
      "additionalProperties": true,
      "properties": {
        "sanitize": {
          "type": "object",
          "description": "Resolved sanitize report. See `stealth_sanitize::SanitizationReport` for the canonical shape.",
          "additionalProperties": true,
          "properties": {
            "schema_version": {
              "type": "integer",
              "examples": [
                1
              ]
            },
            "policy_name": {
              "type": "string",
              "examples": [
                "strict",
                "balanced",
                "passthrough"
              ]
            },
            "mode": {
              "type": "string",
              "enum": [
                "off",
                "warn",
                "enforce"
              ],
              "examples": [
                "warn"
              ]
            },
            "bytes_in": {
              "type": "integer",
              "examples": [
                128
              ]
            },
            "bytes_out": {
              "type": "integer",
              "examples": [
                180
              ]
            },
            "truncated": {
              "type": "boolean",
              "examples": [
                false
              ]
            },
            "aborted": {
              "type": "boolean",
              "examples": [
                false
              ]
            },
            "layers_applied": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "examples": [
                [
                  "L4:unicode",
                  "L2:envelope",
                  "L7:meta"
                ]
              ]
            },
            "canary_hits": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "examples": [
                []
              ]
            },
            "sanitize_id": {
              "type": "string",
              "description": "64-bit hex nonce.",
              "examples": [
                "a1b2c3d4e5f60718"
              ]
            }
          }
        }
      },
      "examples": [
        {
          "sanitize": {
            "schema_version": 1,
            "policy_name": "balanced",
            "mode": "warn",
            "bytes_in": 12,
            "bytes_out": 60,
            "truncated": false,
            "aborted": false,
            "layers_applied": [
              "L2:envelope",
              "L7:meta"
            ],
            "canary_hits": [],
            "sanitize_id": "a1b2c3d4e5f60718"
          }
        }
      ]
    }
  }
}
