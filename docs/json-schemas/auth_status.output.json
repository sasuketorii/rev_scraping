{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "auth_status.output",
  "description": "Response from `auth_status`. Returns freshness classification for an auth profile without exposing cookie values.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "status",
    "cookie_values_returned"
  ],
  "properties": {
    "profile": {
      "type": "string",
      "description": "Auth profile name that was queried.",
      "examples": [
        "example_main"
      ]
    },
    "status": {
      "type": "string",
      "description": "Freshness classification. `Missing` is returned when the profile (or auth_dir) does not exist.",
      "enum": [
        "Valid",
        "ExpiringSoon",
        "ExpiringCritical",
        "PartiallyExpired",
        "AllExpired",
        "Missing"
      ],
      "examples": [
        "Valid",
        "Missing"
      ]
    },
    "cookie_values_returned": {
      "type": "boolean",
      "description": "Always false. Contract marker that cookie values are never disclosed via MCP.",
      "examples": [
        false
      ]
    },
    "_meta": {
      "type": "object",
      "description": "P13.4: sanitize-pass metadata attached by stealth-mcp before this payload becomes LLM-visible. Always present; agents can ignore it unless inspecting prompt-injection telemetry. Shape stable per `stealth-sanitize::SanitizationReport` (schema_version=1).",
      "additionalProperties": true,
      "properties": {
        "sanitize": {
          "type": "object",
          "description": "Resolved sanitize report. See `stealth_sanitize::SanitizationReport` for the canonical shape.",
          "additionalProperties": true,
          "properties": {
            "schema_version": {
              "type": "integer",
              "examples": [
                1
              ]
            },
            "policy_name": {
              "type": "string",
              "examples": [
                "strict",
                "balanced",
                "passthrough"
              ]
            },
            "mode": {
              "type": "string",
              "enum": [
                "off",
                "warn",
                "enforce"
              ],
              "examples": [
                "warn"
              ]
            },
            "bytes_in": {
              "type": "integer",
              "examples": [
                128
              ]
            },
            "bytes_out": {
              "type": "integer",
              "examples": [
                180
              ]
            },
            "truncated": {
              "type": "boolean",
              "examples": [
                false
              ]
            },
            "aborted": {
              "type": "boolean",
              "examples": [
                false
              ]
            },
            "layers_applied": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "examples": [
                [
                  "L4:unicode",
                  "L2:envelope",
                  "L7:meta"
                ]
              ]
            },
            "canary_hits": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "examples": [
                []
              ]
            },
            "sanitize_id": {
              "type": "string",
              "description": "64-bit hex nonce.",
              "examples": [
                "a1b2c3d4e5f60718"
              ]
            }
          }
        }
      },
      "examples": [
        {
          "sanitize": {
            "schema_version": 1,
            "policy_name": "balanced",
            "mode": "warn",
            "bytes_in": 12,
            "bytes_out": 60,
            "truncated": false,
            "aborted": false,
            "layers_applied": [
              "L2:envelope",
              "L7:meta"
            ],
            "canary_hits": [],
            "sanitize_id": "a1b2c3d4e5f60718"
          }
        }
      ]
    }
  }
}
