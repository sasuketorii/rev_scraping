{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cf_evaluate.output",
  "description": "Envelope returned by the `cf_evaluate` MCP tool. Two variants: success `{ok:true, operation:\"cf-evaluate\", result}` and failure `{ok:false, operation:\"cf-evaluate\", exit_code, error}`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "operation"
  ],
  "properties": {
    "ok": {
      "type": "boolean",
      "description": "True on success, false on CLI error.",
      "examples": [
        true,
        false
      ]
    },
    "operation": {
      "type": "string",
      "description": "Operation tag. Always `cf-evaluate` (CLI form, with hyphen).",
      "examples": [
        "cf-evaluate"
      ]
    },
    "result": {
      "type": "object",
      "description": "Success-only evaluator payload. Absent on failure.",
      "additionalProperties": true,
      "properties": {
        "url": {
          "type": "string",
          "description": "URL that was evaluated.",
          "examples": [
            "https://example.com/login"
          ]
        },
        "session_id": {
          "type": "string",
          "description": "UUIDv4 correlating this evaluation with a spider session.",
          "examples": [
            "7c3e3b8a-3b2e-4e57-9a8a-1e1c1f6d7a01"
          ]
        },
        "verdict": {
          "type": "string",
          "description": "Resilience verdict produced by the evaluator. Typical values include `pass`, `challenge`, `block`, `error`.",
          "examples": [
            "pass",
            "challenge",
            "block"
          ]
        },
        "challenge_type": {
          "type": [
            "string",
            "null"
          ],
          "description": "Detected challenge type when present (e.g. `turnstile`, `managed`, `jschallenge`). Null when no challenge fired.",
          "examples": [
            "turnstile"
          ]
        },
        "elapsed_ms": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Total elapsed time in milliseconds.",
          "examples": [
            1342
          ]
        }
      }
    },
    "exit_code": {
      "type": "integer",
      "description": "Failure-only CLI exit code (1 user error, 2 transient, 3 permanent, 7 leak detected).",
      "examples": [
        1,
        7
      ]
    },
    "error": {
      "type": "string",
      "description": "Failure-only human-readable message.",
      "examples": [
        "AUP: target not on allowlist",
        "vpn leak detected mid-navigate"
      ]
    },
    "_meta": {
      "type": "object",
      "description": "P13.4: sanitize-pass metadata attached by stealth-mcp before this payload becomes LLM-visible. Always present; agents can ignore it unless inspecting prompt-injection telemetry. Shape stable per `stealth-sanitize::SanitizationReport` (schema_version=1).",
      "additionalProperties": true,
      "properties": {
        "sanitize": {
          "type": "object",
          "description": "Resolved sanitize report. See `stealth_sanitize::SanitizationReport` for the canonical shape.",
          "additionalProperties": true,
          "properties": {
            "schema_version": {
              "type": "integer",
              "examples": [
                1
              ]
            },
            "policy_name": {
              "type": "string",
              "examples": [
                "strict",
                "balanced",
                "passthrough"
              ]
            },
            "mode": {
              "type": "string",
              "enum": [
                "off",
                "warn",
                "enforce"
              ],
              "examples": [
                "warn"
              ]
            },
            "bytes_in": {
              "type": "integer",
              "examples": [
                128
              ]
            },
            "bytes_out": {
              "type": "integer",
              "examples": [
                180
              ]
            },
            "truncated": {
              "type": "boolean",
              "examples": [
                false
              ]
            },
            "aborted": {
              "type": "boolean",
              "examples": [
                false
              ]
            },
            "layers_applied": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "examples": [
                [
                  "L4:unicode",
                  "L2:envelope",
                  "L7:meta"
                ]
              ]
            },
            "canary_hits": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "examples": [
                []
              ]
            },
            "sanitize_id": {
              "type": "string",
              "description": "64-bit hex nonce.",
              "examples": [
                "a1b2c3d4e5f60718"
              ]
            }
          }
        }
      },
      "examples": [
        {
          "sanitize": {
            "schema_version": 1,
            "policy_name": "balanced",
            "mode": "warn",
            "bytes_in": 12,
            "bytes_out": 60,
            "truncated": false,
            "aborted": false,
            "layers_applied": [
              "L2:envelope",
              "L7:meta"
            ],
            "canary_hits": [],
            "sanitize_id": "a1b2c3d4e5f60718"
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "required": [
        "ok",
        "operation",
        "result"
      ],
      "properties": {
        "ok": {
          "const": true
        }
      }
    },
    {
      "required": [
        "ok",
        "operation",
        "exit_code",
        "error"
      ],
      "properties": {
        "ok": {
          "const": false
        }
      }
    }
  ]
}
