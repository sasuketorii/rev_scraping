{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "recipe_export.output",
  "description": "Response from `recipe_export`. Carries a base64-encoded JSON array of every SiteRecipe in the store plus a count for sanity-checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload",
    "count",
    "encoding"
  ],
  "properties": {
    "payload": {
      "type": "string",
      "description": "Base64-encoded UTF-8 JSON array of SiteRecipe entries. Decode with standard base64, then parse as JSON.",
      "examples": [
        "W3sieyJzaXRlIjp7ImRvbWFpbiI6ImV4YW1wbGUuY29tIn19XQ=="
      ]
    },
    "count": {
      "type": "integer",
      "description": "Number of recipes encoded in the payload.",
      "examples": [
        0,
        12
      ]
    },
    "encoding": {
      "type": "string",
      "description": "Encoding marker. Always `base64-json` for this tool.",
      "examples": [
        "base64-json"
      ]
    },
    "_meta": {
      "type": "object",
      "description": "P13.4: sanitize-pass metadata attached by stealth-mcp before this payload becomes LLM-visible. Always present; agents can ignore it unless inspecting prompt-injection telemetry. Shape stable per `stealth-sanitize::SanitizationReport` (schema_version=1).",
      "additionalProperties": true,
      "properties": {
        "sanitize": {
          "type": "object",
          "description": "Resolved sanitize report. See `stealth_sanitize::SanitizationReport` for the canonical shape.",
          "additionalProperties": true,
          "properties": {
            "schema_version": {
              "type": "integer",
              "examples": [
                1
              ]
            },
            "policy_name": {
              "type": "string",
              "examples": [
                "strict",
                "balanced",
                "passthrough"
              ]
            },
            "mode": {
              "type": "string",
              "enum": [
                "off",
                "warn",
                "enforce"
              ],
              "examples": [
                "warn"
              ]
            },
            "bytes_in": {
              "type": "integer",
              "examples": [
                128
              ]
            },
            "bytes_out": {
              "type": "integer",
              "examples": [
                180
              ]
            },
            "truncated": {
              "type": "boolean",
              "examples": [
                false
              ]
            },
            "aborted": {
              "type": "boolean",
              "examples": [
                false
              ]
            },
            "layers_applied": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "examples": [
                [
                  "L4:unicode",
                  "L2:envelope",
                  "L7:meta"
                ]
              ]
            },
            "canary_hits": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "examples": [
                []
              ]
            },
            "sanitize_id": {
              "type": "string",
              "description": "64-bit hex nonce.",
              "examples": [
                "a1b2c3d4e5f60718"
              ]
            }
          }
        }
      },
      "examples": [
        {
          "sanitize": {
            "schema_version": 1,
            "policy_name": "balanced",
            "mode": "warn",
            "bytes_in": 12,
            "bytes_out": 60,
            "truncated": false,
            "aborted": false,
            "layers_applied": [
              "L2:envelope",
              "L7:meta"
            ],
            "canary_hits": [],
            "sanitize_id": "a1b2c3d4e5f60718"
          }
        }
      ]
    }
  }
}
