{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "relocate.output",
  "description": "Envelope returned by the `relocate` MCP tool. Two variants: success `{ok:true, operation:\"relocate\", result}` and failure `{ok:false, operation:\"relocate\", exit_code, error}`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "operation"
  ],
  "properties": {
    "ok": {
      "type": "boolean",
      "description": "True on success, false on CLI error.",
      "examples": [
        true,
        false
      ]
    },
    "operation": {
      "type": "string",
      "description": "Operation tag. Always `relocate`.",
      "examples": [
        "relocate"
      ]
    },
    "result": {
      "type": "object",
      "description": "Success-only relocate payload. Absent on failure.",
      "additionalProperties": true,
      "properties": {
        "session_id": {
          "type": "string",
          "description": "UUIDv4 from the originating spider session.",
          "examples": [
            "7c3e3b8a-3b2e-4e57-9a8a-1e1c1f6d7a01"
          ]
        },
        "stable_id": {
          "type": "string",
          "description": "Stable element ID that was searched for.",
          "examples": [
            "sid_8d3a"
          ]
        },
        "selector": {
          "type": [
            "string",
            "null"
          ],
          "description": "Best-match selector for the relocated element, or null when not found.",
          "examples": [
            "#product-42 .price"
          ]
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "description": "Similarity score in [0.0, 1.0] for the best match. Null when not found.",
          "examples": [
            0.93
          ]
        },
        "threshold": {
          "type": "number",
          "description": "Threshold that was applied during this run.",
          "examples": [
            0.85
          ]
        },
        "found": {
          "type": "boolean",
          "description": "Convenience boolean derived from score >= threshold.",
          "examples": [
            true,
            false
          ]
        }
      }
    },
    "exit_code": {
      "type": "integer",
      "description": "Failure-only CLI exit code.",
      "examples": [
        1,
        2
      ]
    },
    "error": {
      "type": "string",
      "description": "Failure-only human-readable message.",
      "examples": [
        "aup_denied: target not on allowlist"
      ]
    },
    "_meta": {
      "type": "object",
      "description": "P13.4: sanitize-pass metadata attached by stealth-mcp before this payload becomes LLM-visible. Always present; agents can ignore it unless inspecting prompt-injection telemetry. Shape stable per `stealth-sanitize::SanitizationReport` (schema_version=1).",
      "additionalProperties": true,
      "properties": {
        "sanitize": {
          "type": "object",
          "description": "Resolved sanitize report. See `stealth_sanitize::SanitizationReport` for the canonical shape.",
          "additionalProperties": true,
          "properties": {
            "schema_version": {
              "type": "integer",
              "examples": [
                1
              ]
            },
            "policy_name": {
              "type": "string",
              "examples": [
                "strict",
                "balanced",
                "passthrough"
              ]
            },
            "mode": {
              "type": "string",
              "enum": [
                "off",
                "warn",
                "enforce"
              ],
              "examples": [
                "warn"
              ]
            },
            "bytes_in": {
              "type": "integer",
              "examples": [
                128
              ]
            },
            "bytes_out": {
              "type": "integer",
              "examples": [
                180
              ]
            },
            "truncated": {
              "type": "boolean",
              "examples": [
                false
              ]
            },
            "aborted": {
              "type": "boolean",
              "examples": [
                false
              ]
            },
            "layers_applied": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "examples": [
                [
                  "L4:unicode",
                  "L2:envelope",
                  "L7:meta"
                ]
              ]
            },
            "canary_hits": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "examples": [
                []
              ]
            },
            "sanitize_id": {
              "type": "string",
              "description": "64-bit hex nonce.",
              "examples": [
                "a1b2c3d4e5f60718"
              ]
            }
          }
        }
      },
      "examples": [
        {
          "sanitize": {
            "schema_version": 1,
            "policy_name": "balanced",
            "mode": "warn",
            "bytes_in": 12,
            "bytes_out": 60,
            "truncated": false,
            "aborted": false,
            "layers_applied": [
              "L2:envelope",
              "L7:meta"
            ],
            "canary_hits": [],
            "sanitize_id": "a1b2c3d4e5f60718"
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "required": [
        "ok",
        "operation",
        "result"
      ],
      "properties": {
        "ok": {
          "const": true
        }
      }
    },
    {
      "required": [
        "ok",
        "operation",
        "exit_code",
        "error"
      ],
      "properties": {
        "ok": {
          "const": false
        }
      }
    }
  ]
}
