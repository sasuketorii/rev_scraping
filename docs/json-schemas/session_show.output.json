{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "session_show.output",
  "description": "Response from `session_show`. Returns the on-disk metadata captured for a session id by the stealth CLI: VPN instance binding, recipe hit history, auth profile (if any), and the unix timestamp when the session record was first persisted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "vpn_instance",
    "recipe_hits",
    "started_at"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Session identifier echoed back from the request.",
      "examples": [
        "7e23b58c-9c2c-44bd-9a4d-7b6b32f04d1e"
      ]
    },
    "vpn_instance": {
      "type": [
        "string",
        "null"
      ],
      "description": "Name of the VPN instance bound to this session, or null if the session has no VPN binding.",
      "examples": [
        "vpn-2",
        null
      ]
    },
    "recipe_hits": {
      "type": "array",
      "description": "Domains hit during this session, if recipe-hit tracking is enabled. Empty array when no hits have been recorded.",
      "items": {
        "type": "string"
      },
      "examples": [
        [],
        [
          "example.com"
        ]
      ]
    },
    "auth_profile": {
      "type": [
        "string",
        "null"
      ],
      "description": "Auth profile name bound to this session, or null if none.",
      "examples": [
        "example_main",
        null
      ]
    },
    "started_at": {
      "type": "integer",
      "description": "Unix epoch seconds when this session record was first persisted.",
      "minimum": 0,
      "examples": [
        1700000000
      ]
    },
    "_meta": {
      "type": "object",
      "description": "P13.4: sanitize-pass metadata attached by stealth-mcp before this payload becomes LLM-visible. Always present; agents can ignore it unless inspecting prompt-injection telemetry. Shape stable per `stealth-sanitize::SanitizationReport` (schema_version=1).",
      "additionalProperties": true,
      "properties": {
        "sanitize": {
          "type": "object",
          "description": "Resolved sanitize report. See `stealth_sanitize::SanitizationReport` for the canonical shape.",
          "additionalProperties": true,
          "properties": {
            "schema_version": {
              "type": "integer",
              "examples": [
                1
              ]
            },
            "policy_name": {
              "type": "string",
              "examples": [
                "strict",
                "balanced",
                "passthrough"
              ]
            },
            "mode": {
              "type": "string",
              "enum": [
                "off",
                "warn",
                "enforce"
              ],
              "examples": [
                "warn"
              ]
            },
            "bytes_in": {
              "type": "integer",
              "examples": [
                128
              ]
            },
            "bytes_out": {
              "type": "integer",
              "examples": [
                180
              ]
            },
            "truncated": {
              "type": "boolean",
              "examples": [
                false
              ]
            },
            "aborted": {
              "type": "boolean",
              "examples": [
                false
              ]
            },
            "layers_applied": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "examples": [
                [
                  "L4:unicode",
                  "L2:envelope",
                  "L7:meta"
                ]
              ]
            },
            "canary_hits": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "examples": [
                []
              ]
            },
            "sanitize_id": {
              "type": "string",
              "description": "64-bit hex nonce.",
              "examples": [
                "a1b2c3d4e5f60718"
              ]
            }
          }
        }
      },
      "examples": [
        {
          "sanitize": {
            "schema_version": 1,
            "policy_name": "balanced",
            "mode": "warn",
            "bytes_in": 12,
            "bytes_out": 60,
            "truncated": false,
            "aborted": false,
            "layers_applied": [
              "L2:envelope",
              "L7:meta"
            ],
            "canary_hits": [],
            "sanitize_id": "a1b2c3d4e5f60718"
          }
        }
      ]
    }
  }
}
