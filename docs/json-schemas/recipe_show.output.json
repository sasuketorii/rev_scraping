{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "recipe_show.output",
  "description": "Response from `recipe_show`: the full SiteRecipe JSON for the requested domain. Root keys are pinned to the SiteRecipe struct surface for strict-mode compliance; inner blocks remain permissive because SiteRecipe sub-types evolve with `schema_version`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "site"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "description": "SiteRecipe schema version. Agents should branch on this when handling backward-incompatible recipe shapes.",
      "examples": [
        1
      ]
    },
    "site": {
      "type": "object",
      "description": "Site identity block (domain, rendering, optional last_verified).",
      "additionalProperties": true,
      "required": [
        "domain"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "description": "Recipe domain key.",
          "examples": [
            "example.com"
          ]
        },
        "rendering": {
          "type": "string",
          "description": "Rendering mode for the site.",
          "examples": [
            "spa",
            "ssr",
            "static"
          ]
        },
        "last_verified": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional ISO-8601 last verification timestamp.",
          "examples": [
            "2026-04-12T08:30:00Z"
          ]
        }
      }
    },
    "api": {
      "type": [
        "object",
        "null"
      ],
      "description": "Discovered API endpoints. Null when the site is HTML-only.",
      "additionalProperties": true
    },
    "scraping_strategy": {
      "type": [
        "object",
        "null"
      ],
      "description": "Recommended scraping strategy (HTML vs. API vs. hybrid). Null when unset.",
      "additionalProperties": true
    },
    "rate_limits": {
      "type": [
        "object",
        "null"
      ],
      "description": "Per-site rate-limit hints. Null when unset.",
      "additionalProperties": true
    },
    "selectors": {
      "type": [
        "object",
        "null"
      ],
      "description": "Stable selector / stable_id table. Null when unset.",
      "additionalProperties": true
    },
    "fingerprint": {
      "type": [
        "object",
        "null"
      ],
      "description": "Fingerprint hints (UA preset, viewport, locale). Null when unset.",
      "additionalProperties": true
    },
    "anti_bot": {
      "type": [
        "object",
        "null"
      ],
      "description": "Anti-bot configuration (CF tier, captcha sidecar). Null when unset.",
      "additionalProperties": true
    },
    "notes": {
      "type": [
        "object",
        "null"
      ],
      "description": "Free-form analyst notes. Null when unset.",
      "additionalProperties": true
    },
    "auth": {
      "type": [
        "object",
        "null"
      ],
      "description": "AuthRecipe block (required, login_url, refusal_policy, \u2026). Omitted by serializer when None.",
      "additionalProperties": true
    },
    "_meta": {
      "type": "object",
      "description": "P13.4: sanitize-pass metadata attached by stealth-mcp before this payload becomes LLM-visible. Always present; agents can ignore it unless inspecting prompt-injection telemetry. Shape stable per `stealth-sanitize::SanitizationReport` (schema_version=1).",
      "additionalProperties": true,
      "properties": {
        "sanitize": {
          "type": "object",
          "description": "Resolved sanitize report. See `stealth_sanitize::SanitizationReport` for the canonical shape.",
          "additionalProperties": true,
          "properties": {
            "schema_version": {
              "type": "integer",
              "examples": [
                1
              ]
            },
            "policy_name": {
              "type": "string",
              "examples": [
                "strict",
                "balanced",
                "passthrough"
              ]
            },
            "mode": {
              "type": "string",
              "enum": [
                "off",
                "warn",
                "enforce"
              ],
              "examples": [
                "warn"
              ]
            },
            "bytes_in": {
              "type": "integer",
              "examples": [
                128
              ]
            },
            "bytes_out": {
              "type": "integer",
              "examples": [
                180
              ]
            },
            "truncated": {
              "type": "boolean",
              "examples": [
                false
              ]
            },
            "aborted": {
              "type": "boolean",
              "examples": [
                false
              ]
            },
            "layers_applied": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "examples": [
                [
                  "L4:unicode",
                  "L2:envelope",
                  "L7:meta"
                ]
              ]
            },
            "canary_hits": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "examples": [
                []
              ]
            },
            "sanitize_id": {
              "type": "string",
              "description": "64-bit hex nonce.",
              "examples": [
                "a1b2c3d4e5f60718"
              ]
            }
          }
        }
      },
      "examples": [
        {
          "sanitize": {
            "schema_version": 1,
            "policy_name": "balanced",
            "mode": "warn",
            "bytes_in": 12,
            "bytes_out": 60,
            "truncated": false,
            "aborted": false,
            "layers_applied": [
              "L2:envelope",
              "L7:meta"
            ],
            "canary_hits": [],
            "sanitize_id": "a1b2c3d4e5f60718"
          }
        }
      ]
    }
  }
}
