{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rev-stealth.local/json-schemas/cli/hermes.output.json",
  "title": "rev-stealth hermes --output-format json",
  "description": "JSON payload emitted by `rev-stealth hermes {install|uninstall|verify} --output-format json`. v1.3 Lane G.4 contract. Hermes uses its OWN envelope (kind/action/status/report|error) — distinct from the captcha/browser/vpn/etc. shared envelope. Reference emitter: `crates/stealth-cli/src/commands/hermes.rs::emit_ok`/`emit_err`. The error envelope is written to STDERR rather than STDOUT.",
  "oneOf": [
    {
      "title": "OK envelope",
      "type": "object",
      "required": ["kind", "action", "status", "report"],
      "properties": {
        "kind": { "const": "hermes" },
        "action": { "type": "string", "enum": ["install", "uninstall", "verify"] },
        "status": { "const": "ok" },
        "report": {
          "type": "object",
          "description": "Mirror of `commands::hermes::HermesReport`.",
          "required": ["prefix", "files_copied"],
          "properties": {
            "prefix": { "type": "string", "description": "Filesystem path (Display-serialised PathBuf)." },
            "source": { "type": ["string", "null"], "description": "Source scaffold path when overridden, else null." },
            "files_copied": { "type": "integer", "minimum": 0 },
            "python_check_ok": { "type": ["boolean", "null"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "title": "ERR envelope (written to STDERR)",
      "type": "object",
      "required": ["kind", "action", "status", "error"],
      "properties": {
        "kind": { "const": "hermes" },
        "action": { "type": "string", "enum": ["install", "uninstall", "verify"] },
        "status": { "const": "error" },
        "error": { "type": "string" }
      },
      "additionalProperties": false
    }
  ]
}
