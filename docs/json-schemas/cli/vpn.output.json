{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rev-stealth.local/json-schemas/cli/vpn.output.json",
  "title": "rev-stealth vpn --output-format json",
  "description": "JSON payload emitted by `rev-stealth vpn {rotate|status} --output-format json`. v1.3 Lane G.4 contract. Reference emitter: `crates/stealth-cli/src/vpn_cmd.rs::emit_ok`/`emit_err`.",
  "oneOf": [
    {
      "title": "vpn.rotate OK",
      "type": "object",
      "required": ["ok", "operation", "result"],
      "properties": {
        "ok": { "const": true },
        "operation": { "const": "vpn.rotate" },
        "result": {
          "type": "object",
          "required": ["rotated", "elapsed_ms", "reason"],
          "properties": {
            "rotated": { "type": "boolean" },
            "container": { "type": ["string", "null"] },
            "previous_ip": { "type": ["string", "null"] },
            "new_ip": { "type": ["string", "null"] },
            "elapsed_ms": { "type": "integer", "minimum": 0 },
            "reason": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    {
      "title": "vpn.status OK",
      "type": "object",
      "required": ["ok", "operation", "result"],
      "properties": {
        "ok": { "const": true },
        "operation": { "const": "vpn.status" },
        "result": {
          "type": "object",
          "required": ["provider", "running"],
          "properties": {
            "provider": { "type": "string" },
            "container": { "type": ["string", "null"] },
            "running": { "type": "boolean" },
            "current_ip": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    {
      "title": "ERR envelope",
      "type": "object",
      "required": ["ok", "operation", "exit_code", "error"],
      "properties": {
        "ok": { "const": false },
        "operation": { "type": "string", "enum": ["vpn.rotate", "vpn.status"] },
        "exit_code": { "type": "integer", "minimum": 0 },
        "error": { "type": "string" }
      },
      "additionalProperties": false
    }
  ]
}
