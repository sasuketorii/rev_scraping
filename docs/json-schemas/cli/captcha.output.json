{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rev-stealth.local/json-schemas/cli/captcha.output.json",
  "title": "rev-stealth captcha --output-format json",
  "description": "JSON payload emitted by `rev-stealth captcha {solve|verify} --output-format json`. v1.3 Lane G.4 contract. Wraps the action-specific payload in the shared {ok, operation, result|exit_code+error} envelope used by every captcha/browser/vpn/spider/relocate/cf-evaluate/auth/measure subcommand. Reference emitter: `crates/stealth-cli/src/captcha_cmd.rs::emit_ok` / `emit_err`.",
  "oneOf": [
    { "$ref": "#/$defs/ok_envelope" },
    { "$ref": "#/$defs/err_envelope" }
  ],
  "$defs": {
    "ok_envelope": {
      "type": "object",
      "required": ["ok", "operation", "result"],
      "properties": {
        "ok": { "const": true },
        "operation": { "type": "string", "enum": ["captcha.solve", "captcha.verify"] },
        "result": {
          "oneOf": [
            {
              "title": "captcha.solve result",
              "type": "object",
              "required": ["type", "site_url", "solver", "elapsed_ms", "token_len", "token_preview", "dry_run"],
              "properties": {
                "type": { "type": "string" },
                "site_url": { "type": "string" },
                "site_key": { "type": ["string", "null"] },
                "solver": { "type": "string" },
                "elapsed_ms": { "type": "integer", "minimum": 0 },
                "token_len": { "type": "integer", "minimum": 0 },
                "token_preview": { "type": "string", "description": "Truncated preview of the solved token (max 32 chars + ellipsis)." },
                "dry_run": { "type": "boolean" }
              },
              "additionalProperties": true
            },
            {
              "title": "captcha.verify result",
              "type": "object",
              "required": ["type", "valid", "errors"],
              "properties": {
                "type": { "type": "string" },
                "valid": { "type": "boolean" },
                "score": { "type": ["number", "null"] },
                "action": { "type": ["string", "null"] },
                "errors": { "type": "array", "items": { "type": "string" } }
              },
              "additionalProperties": true
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "err_envelope": {
      "type": "object",
      "required": ["ok", "operation", "exit_code", "error"],
      "properties": {
        "ok": { "const": false },
        "operation": { "type": "string" },
        "exit_code": { "type": "integer", "minimum": 0 },
        "error": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
