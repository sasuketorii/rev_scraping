{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rev-stealth.local/json-schemas/cli/relocate.output.json",
  "title": "rev-stealth relocate --output-format json",
  "description": "JSON payload emitted by `rev-stealth relocate --output-format json`. v1.3 Lane G.4 contract. Wraps the relocator outcome in the shared {ok, operation, result|exit_code+error} envelope. Reference emitter: `crates/stealth-cli/src/commands/relocate.rs::emit_ok`/`emit_err` (operation = \"relocate\"). The `result.kind` discriminates between LocateOutcome variants.",
  "oneOf": [
    {
      "title": "OK envelope (exact / fuzzy / ambiguous)",
      "type": "object",
      "required": ["ok", "operation", "result"],
      "properties": {
        "ok": { "const": true },
        "operation": { "const": "relocate" },
        "result": {
          "oneOf": [
            {
              "title": "exact match",
              "type": "object",
              "required": ["kind", "node"],
              "properties": {
                "kind": { "const": "exact" },
                "node": { "type": "string", "description": "Debug-rendered DOM node reference." }
              },
              "additionalProperties": true
            },
            {
              "title": "fuzzy match",
              "type": "object",
              "required": ["kind", "score", "node"],
              "properties": {
                "kind": { "const": "fuzzy" },
                "score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
                "node": { "type": "string" }
              },
              "additionalProperties": true
            },
            {
              "title": "ambiguous",
              "type": "object",
              "required": ["kind", "candidates"],
              "properties": {
                "kind": { "const": "ambiguous" },
                "candidates": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": true
            }
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "title": "ERR envelope (no-match / locate failure / VPN guard)",
      "type": "object",
      "required": ["ok", "operation", "exit_code", "error"],
      "properties": {
        "ok": { "const": false },
        "operation": { "const": "relocate" },
        "exit_code": { "type": "integer", "minimum": 0, "description": "1 user / 2 transient fetch / 3 permanent / 7 leak / 9 no-match / 10 ambiguous-strict." },
        "error": { "type": "string" }
      },
      "additionalProperties": false
    }
  ]
}
