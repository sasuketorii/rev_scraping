{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rev-stealth.local/json-schemas/cli/spider.output.json",
  "title": "rev-stealth spider --output-format json",
  "description": "JSON payload emitted by `rev-stealth spider --output-format json`. v1.3 Lane G.4 contract. Wraps the spider payload in the shared {ok, operation, result|exit_code+error} envelope. The `result` object is large (36 spider flags x sub-modules); documented properties below are guaranteed when applicable, additional properties are permitted for forward compatibility. Reference emitter: `crates/stealth-cli/src/commands/spider.rs::emit_ok`/`emit_err` (operation = \"spider\").",
  "oneOf": [
    {
      "title": "OK envelope",
      "type": "object",
      "required": ["ok", "operation", "result"],
      "properties": {
        "ok": { "const": true },
        "operation": { "const": "spider" },
        "result": { "$ref": "#/$defs/spider_result" }
      },
      "additionalProperties": false
    },
    {
      "title": "ERR envelope (incl. leak fail-closed)",
      "type": "object",
      "required": ["ok", "operation", "exit_code", "error"],
      "properties": {
        "ok": { "const": false },
        "operation": { "const": "spider" },
        "exit_code": { "type": "integer", "minimum": 0, "description": "1 user / 2 transient / 3 permanent / 4 auth-expired / 7 leak." },
        "error": { "type": "string" },
        "vpn_monitor": { "$ref": "#/$defs/vpn_monitor_block", "description": "Present on exit_code = 7 (leak fail-closed)." }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "spider_result": {
      "type": "object",
      "description": "Spider operation payload. Sectioned via referenced $defs (auth / cf / recipe / example) per G.1 review.",
      "required": ["session_id", "url", "url_requested", "fetcher", "used_fallback", "exit_code"],
      "properties": {
        "session_id": { "type": "string", "format": "uuid" },
        "url": { "type": "string" },
        "url_requested": { "type": "string" },
        "url_final": { "type": ["string", "null"] },
        "fetcher": { "type": "string", "enum": ["obscura", "reqwest", "http"] },
        "used_fallback": { "type": "boolean" },
        "http_status": { "type": ["integer", "null"] },
        "elapsed_ms": { "type": ["integer", "null"] },
        "html_size": { "type": ["integer", "null"], "minimum": 0 },
        "mobile_preset": { "type": ["string", "null"] },
        "vpn": { "type": ["object", "null"] },
        "vpn_probe": { "type": ["object", "null"] },
        "vpn_monitor": { "$ref": "#/$defs/vpn_monitor_block" },
        "cf_outcome": { "type": ["string", "object", "null"] },
        "relocate": { "$ref": "#/$defs/example_site_section" },
        "dumped_html_path": { "type": ["string", "null"] },
        "dumped_html_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "recipe": { "$ref": "#/$defs/recipe_section" },
        "auto_discovered_endpoints_count": { "type": ["integer", "null"], "minimum": 0 },
        "discovery_methods": { "type": ["array", "null"], "items": { "type": "string" } },
        "exit_code": { "type": "integer", "minimum": 0, "maximum": 7 }
      },
      "additionalProperties": true
    },
    "recipe_section": {
      "type": ["object", "null"],
      "description": "Recipe-runtime context (recipe id / version / hit/miss).",
      "additionalProperties": true
    },
    "example_site_section": {
      "type": ["object", "null"],
      "description": "Example adaptive relocate summary (when --stable-id is set).",
      "additionalProperties": true
    },
    "vpn_monitor_block": {
      "type": ["object", "null"],
      "description": "Built by `commands::vpn_envelope::build_vpn_monitor_json`; surfaced as both an `result.vpn_monitor` field on success paths and as a top-level field on the leak-shutdown (exit 7) error envelope.",
      "additionalProperties": true
    }
  }
}
