{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "recipe_remove.output",
  "description": "Response from `recipe_remove`. Two shapes: preview (confirm=false) and committed delete (confirm=true). Both shapes share the `removed` and `domain` keys.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "removed",
    "domain"
  ],
  "properties": {
    "removed": {
      "type": "boolean",
      "description": "True only when the recipe file was actually deleted. False on preview, including the case where the recipe did not exist.",
      "examples": [
        false,
        true
      ]
    },
    "domain": {
      "type": "string",
      "description": "Recipe domain key the request targeted.",
      "examples": [
        "example.com"
      ]
    },
    "preview": {
      "type": "boolean",
      "description": "Present only on the preview shape (confirm=false). True indicates no destructive action was performed.",
      "examples": [
        true
      ]
    },
    "would_remove": {
      "type": "boolean",
      "description": "Preview-shape only. True when the recipe exists and would be deleted on a confirm=true call.",
      "examples": [
        true,
        false
      ]
    },
    "existed": {
      "type": "boolean",
      "description": "Committed-shape only. True when the recipe existed before deletion.",
      "examples": [
        true,
        false
      ]
    },
    "_meta": {
      "type": "object",
      "description": "P13.4: sanitize-pass metadata attached by stealth-mcp before this payload becomes LLM-visible. Always present; agents can ignore it unless inspecting prompt-injection telemetry. Shape stable per `stealth-sanitize::SanitizationReport` (schema_version=1).",
      "additionalProperties": true,
      "properties": {
        "sanitize": {
          "type": "object",
          "description": "Resolved sanitize report. See `stealth_sanitize::SanitizationReport` for the canonical shape.",
          "additionalProperties": true,
          "properties": {
            "schema_version": {
              "type": "integer",
              "examples": [
                1
              ]
            },
            "policy_name": {
              "type": "string",
              "examples": [
                "strict",
                "balanced",
                "passthrough"
              ]
            },
            "mode": {
              "type": "string",
              "enum": [
                "off",
                "warn",
                "enforce"
              ],
              "examples": [
                "warn"
              ]
            },
            "bytes_in": {
              "type": "integer",
              "examples": [
                128
              ]
            },
            "bytes_out": {
              "type": "integer",
              "examples": [
                180
              ]
            },
            "truncated": {
              "type": "boolean",
              "examples": [
                false
              ]
            },
            "aborted": {
              "type": "boolean",
              "examples": [
                false
              ]
            },
            "layers_applied": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "examples": [
                [
                  "L4:unicode",
                  "L2:envelope",
                  "L7:meta"
                ]
              ]
            },
            "canary_hits": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "examples": [
                []
              ]
            },
            "sanitize_id": {
              "type": "string",
              "description": "64-bit hex nonce.",
              "examples": [
                "a1b2c3d4e5f60718"
              ]
            }
          }
        }
      },
      "examples": [
        {
          "sanitize": {
            "schema_version": 1,
            "policy_name": "balanced",
            "mode": "warn",
            "bytes_in": 12,
            "bytes_out": 60,
            "truncated": false,
            "aborted": false,
            "layers_applied": [
              "L2:envelope",
              "L7:meta"
            ],
            "canary_hits": [],
            "sanitize_id": "a1b2c3d4e5f60718"
          }
        }
      ]
    }
  }
}
