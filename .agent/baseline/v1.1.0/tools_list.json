{
  "tools": [
    {
      "description": "Scrape a URL with stealth (obscura) + optional CF evaluation + adaptive relocate. AUP allowlist required.",
      "inputSchema": {
        "properties": {
          "cf_evaluate": {
            "default": false,
            "type": "boolean"
          },
          "mobile_preset": {
            "enum": [
              "iphone15pro",
              "iphone15promax",
              "ipadprom4",
              "pixel9pro",
              "pixel8a",
              "galaxys24ultra"
            ],
            "type": "string"
          },
          "session_id": {
            "description": "UUID, autogenerated if omitted",
            "type": "string"
          },
          "stable_id": {
            "type": "string"
          },
          "strict": {
            "default": false,
            "type": "boolean"
          },
          "threshold": {
            "default": 0.85,
            "type": "number"
          },
          "url": {
            "type": "string"
          },
          "vpn": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      },
      "name": "spider"
    },
    {
      "description": "Adaptive relocate a previously recorded element via stealth-parse.",
      "inputSchema": {
        "properties": {
          "html": {
            "description": "Raw HTML to search in (alternative to url)",
            "type": "string"
          },
          "session_id": {
            "type": "string"
          },
          "stable_id": {
            "type": "string"
          },
          "threshold": {
            "default": 0.85,
            "type": "number"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "stable_id"
        ],
        "type": "object"
      },
      "name": "relocate"
    },
    {
      "description": "Evaluate Cloudflare Turnstile resilience on an authorized target.",
      "inputSchema": {
        "properties": {
          "session_id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      },
      "name": "cf_evaluate"
    },
    {
      "description": "Run leak-guard / vpn / captcha sidecar health diagnostics.",
      "inputSchema": {
        "properties": {
          "container": {
            "default": "gluetun",
            "type": "string"
          },
          "expected_country": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "doctor"
    },
    {
      "description": "List all site recipes stored in ~/.rev_scraping/sites/.",
      "inputSchema": {
        "properties": {},
        "type": "object"
      },
      "name": "recipe_list"
    },
    {
      "description": "Return the full SiteRecipe JSON for a given domain.",
      "inputSchema": {
        "properties": {
          "domain": {
            "type": "string"
          }
        },
        "required": [
          "domain"
        ],
        "type": "object"
      },
      "name": "recipe_show"
    },
    {
      "description": "Remove a recipe file. Preview unless confirm=true.",
      "inputSchema": {
        "properties": {
          "confirm": {
            "default": false,
            "type": "boolean"
          },
          "domain": {
            "type": "string"
          }
        },
        "required": [
          "domain"
        ],
        "type": "object"
      },
      "name": "recipe_remove"
    },
    {
      "description": "Append a new endpoint to an existing site recipe. Secret-leak rejected.",
      "inputSchema": {
        "properties": {
          "domain": {
            "type": "string"
          },
          "endpoint": {
            "properties": {
              "http_method": {
                "default": "GET",
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              },
              "url_pattern": {
                "type": "string"
              }
            },
            "required": [
              "purpose",
              "path"
            ],
            "type": "object"
          }
        },
        "required": [
          "domain",
          "endpoint"
        ],
        "type": "object"
      },
      "name": "recipe_propose_endpoint"
    },
    {
      "description": "Export all recipes as a base64-encoded JSON array.",
      "inputSchema": {
        "properties": {},
        "type": "object"
      },
      "name": "recipe_export"
    },
    {
      "description": "Import recipes from a base64-encoded JSON array. Secret-rejected and path-traversal guarded.",
      "inputSchema": {
        "properties": {
          "payload": {
            "description": "base64-encoded JSON array of SiteRecipe",
            "type": "string"
          }
        },
        "required": [
          "payload"
        ],
        "type": "object"
      },
      "name": "recipe_import"
    },
    {
      "description": "Phase 1 of 2-phase login: AUP-enforce + spawn rev-auth helper. Returns a session_token. Cookie values are never returned.",
      "inputSchema": {
        "properties": {
          "completion_pattern": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "profile",
          "url"
        ],
        "type": "object"
      },
      "name": "auth_login_start"
    },
    {
      "description": "Phase 2 of 2-phase login: poll until rev-auth finishes, then return ProfileMeta. Single-use session_token. Cookie values never returned.",
      "inputSchema": {
        "properties": {
          "session_token": {
            "type": "string"
          }
        },
        "required": [
          "session_token"
        ],
        "type": "object"
      },
      "name": "auth_login_complete"
    },
    {
      "description": "List all stored auth profiles (ProfileMeta only, cookie values never disclosed).",
      "inputSchema": {
        "properties": {},
        "type": "object"
      },
      "name": "auth_list"
    },
    {
      "description": "Return freshness classification for an auth profile (Valid|PartiallyExpired|AllExpired|Missing).",
      "inputSchema": {
        "properties": {
          "profile": {
            "type": "string"
          }
        },
        "required": [
          "profile"
        ],
        "type": "object"
      },
      "name": "auth_status"
    },
    {
      "description": "Rotate VPN exit (Surfshark via Gluetun).",
      "inputSchema": {
        "properties": {
          "provider": {
            "default": "surfshark",
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "strategy": {
            "default": "lazy-on-fail",
            "enum": [
              "lazy-on-fail",
              "every-n",
              "interval"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "vpn_rotate"
    }
  ]
}
