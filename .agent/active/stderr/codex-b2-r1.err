     2	# shellcheck shell=sh
     3	# SPDX-License-Identifier: MIT
     4	#
     5	# Lane H.6 — `curl | sh` installer for rev-stealth.
     6	#
     7	# Usage:
     8	#   curl -fsSL https://raw.githubusercontent.com/sasuketorii/rev_scraping/main/install.sh | sh
     9	#   curl -fsSL https://raw.githubusercontent.com/sasuketorii/rev_scraping/main/install.sh | sh -s -- --version v1.3.0
    10	#   curl -fsSL https://raw.githubusercontent.com/sasuketorii/rev_scraping/main/install.sh | sh -s -- --prefix /opt/rev-stealth/bin
    11	#   curl -fsSL https://raw.githubusercontent.com/sasuketorii/rev_scraping/main/install.sh | sh -s -- --no-verify  # skip cosign
    12	#
    13	# Security model:
    14	#   - Downloads the release artifact + its `*.sig` + `*-keyless.pem` from
    15	#     `https://github.com/sasuketorii/rev_scraping/releases/download/${VERSION}/`.
    16	#   - Verifies with `cosign verify-blob` using a fixed certificate-identity
    17	#     (GitHub Actions OIDC issuer pinned to the release workflow).
    18	#   - Refuses to install if cosign is unavailable AND `--no-verify` was not
    19	#     explicitly passed (fail-closed default).
    20	#   - Tries `sha256` checksum as a secondary integrity gate.
    21	#
    22	# Strict POSIX sh; no bashisms. Validated under `shellcheck -s sh`.
    23	
    24	set -eu
    25	
    26	# ---------- defaults -------------------------------------------------------
    27	REPO_OWNER="sasuketorii"
    28	REPO_NAME="rev_scraping"
    29	BIN_NAME="rev-stealth"
    30	DEFAULT_VERSION="latest"
    31	DEFAULT_PREFIX="/usr/local/bin"
    32	
    33	# Cosign identity pin (matches release.yml workflow file path + ref).
    34	# `release-please` rewrites the ref pin on each tag.
    35	COSIGN_IDENTITY="https://github.com/${REPO_OWNER}/${REPO_NAME}/.github/workflows/release.yml@refs/tags/v"
    36	COSIGN_OIDC_ISSUER="https://token.actions.githubusercontent.com"
    37	
    38	VERSION="${REV_STEALTH_VERSION:-${DEFAULT_VERSION}}"
    39	PREFIX="${REV_STEALTH_PREFIX:-${DEFAULT_PREFIX}}"
    40	VERIFY="1"
    41	
    42	# ---------- arg parse ------------------------------------------------------
    43	while [ $# -gt 0 ]; do
    44	    case "$1" in
    45	        --version)   VERSION="$2"; shift 2 ;;
    46	        --version=*) VERSION="${1#*=}"; shift ;;
    47	        --prefix)    PREFIX="$2"; shift 2 ;;
    48	        --prefix=*)  PREFIX="${1#*=}"; shift ;;
    49	        --no-verify) VERIFY="0"; shift ;;
    50	        -h|--help)
    51	            sed -n '/^# Usage:/,/^# Security model:/p' "$0" | sed 's/^# //; s/^#$//'
    52	            exit 0
    53	            ;;
    54	        *)
    55	            echo "install.sh: unknown arg: $1" >&2
    56	            exit 64
    57	            ;;
    58	    esac
    59	done
    60	
    61	# ---------- helpers --------------------------------------------------------
    62	log()  { printf '[install.sh] %s\n' "$*"; }
    63	warn() { printf '[install.sh] WARN: %s\n' "$*" >&2; }
    64	die()  { printf '[install.sh] ERROR: %s\n' "$*" >&2; exit 1; }
    65	
    66	need() {
    67	    command -v "$1" >/dev/null 2>&1 || die "missing required tool: $1"
    68	}
    69	
    70	detect_target() {
    71	    os="$(uname -s | tr '[:upper:]' '[:lower:]')"
    72	    arch="$(uname -m)"
    73	    case "${os}-${arch}" in
    74	        linux-x86_64)   echo "x86_64-unknown-linux-musl" ;;
    75	        linux-aarch64)  echo "aarch64-unknown-linux-musl" ;;
    76	        linux-arm64)    echo "aarch64-unknown-linux-musl" ;;
    77	        darwin-x86_64)  echo "x86_64-apple-darwin" ;;
    78	        darwin-arm64)   echo "aarch64-apple-darwin" ;;
    79	        *) die "unsupported platform: ${os}-${arch}" ;;
    80	    esac
    81	}
    82	
    83	resolve_version() {
    84	    if [ "${VERSION}" = "latest" ]; then
    85	        need curl
    86	        VERSION=$(curl -fsSL "https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/releases/latest" \
    87	            | sed -n 's/.*"tag_name":[[:space:]]*"\([^"]*\)".*/\1/p' \
    88	            | head -n 1)
    89	        [ -n "${VERSION}" ] || die "could not resolve latest version"
    90	    fi
    91	    echo "${VERSION}"
    92	}
    93	
    94	# ---------- main -----------------------------------------------------------
    95	need curl
    96	need uname
    97	need tar
    98	
    99	TARGET="$(detect_target)"
   100	VERSION="$(resolve_version)"
   101	log "installing ${BIN_NAME} ${VERSION} for ${TARGET}"
   102	
   103	TMPDIR_REAL="$(mktemp -d)"
   104	trap 'rm -rf "${TMPDIR_REAL}"' EXIT INT TERM
   105	
   106	BASE_URL="https://github.com/${REPO_OWNER}/${REPO_NAME}/releases/download/${VERSION}"
   107	ARCHIVE="${BIN_NAME}-${VERSION}-${TARGET}.tar.gz"
   108	
   109	log "fetching ${BASE_URL}/${ARCHIVE}"
   110	curl -fsSL --proto '=https' --tlsv1.2 -o "${TMPDIR_REAL}/${ARCHIVE}"     "${BASE_URL}/${ARCHIVE}"
   111	curl -fsSL --proto '=https' --tlsv1.2 -o "${TMPDIR_REAL}/${ARCHIVE}.sha256" "${BASE_URL}/${ARCHIVE}.sha256" || warn "no sha256 sidecar"
   112	
   113	# sha256 check (best-effort, soft-fail if sidecar absent).
   114	if [ -s "${TMPDIR_REAL}/${ARCHIVE}.sha256" ]; then
   115	    if command -v sha256sum >/dev/null 2>&1; then
   116	        ( cd "${TMPDIR_REAL}" && sha256sum -c "${ARCHIVE}.sha256" ) || die "sha256 mismatch"
   117	    elif command -v shasum >/dev/null 2>&1; then
   118	        ( cd "${TMPDIR_REAL}" && shasum -a 256 -c "${ARCHIVE}.sha256" ) || die "sha256 mismatch"
   119	    else
   120	        warn "no sha256sum / shasum available; skipping checksum gate"
   121	    fi
   122	    log "sha256 OK"
   123	fi
   124	
   125	# Cosign verification (fail-closed unless --no-verify).
   126	if [ "${VERIFY}" = "1" ]; then
   127	    if command -v cosign >/dev/null 2>&1; then
   128	        curl -fsSL --proto '=https' --tlsv1.2 -o "${TMPDIR_REAL}/${ARCHIVE}.sig" "${BASE_URL}/${ARCHIVE}.sig"
   129	        curl -fsSL --proto '=https' --tlsv1.2 -o "${TMPDIR_REAL}/${ARCHIVE}.cert" "${BASE_URL}/${ARCHIVE}-keyless.pem"
   130	        # Pin to the *exact* tag in the identity to prevent workflow-rename
   131	        # spoofing. Tag format is `v<semver>`.
   132	        cosign verify-blob \
   133	            --certificate-identity "${COSIGN_IDENTITY}${VERSION#v}" \
   134	            --certificate-oidc-issuer "${COSIGN_OIDC_ISSUER}" \
   135	            --signature "${TMPDIR_REAL}/${ARCHIVE}.sig" \
   136	            --certificate "${TMPDIR_REAL}/${ARCHIVE}.cert" \
   137	            "${TMPDIR_REAL}/${ARCHIVE}" \
   138	            || die "cosign verify-blob FAILED — refusing to install"
   139	        log "cosign verification PASS"
   140	    else
   141	        die "cosign not installed; install cosign (https://docs.sigstore.dev/cosign/installation/) or rerun with --no-verify"
   142	    fi
   143	else
   144	    warn "cosign verification SKIPPED (--no-verify). Not recommended."
   145	fi
   146	
   147	# Extract + install. The release tarball is laid out as
   148	#   rev-stealth-${VERSION}-${TARGET}/{rev-stealth,stealth-mcp,rev-auth,README,LICENSE}
   149	# so we resolve the binary by find (handles dirname variations).
   150	tar -xzf "${TMPDIR_REAL}/${ARCHIVE}" -C "${TMPDIR_REAL}"
   151	EXTRACTED_BIN="$(find "${TMPDIR_REAL}" -type f -name "${BIN_NAME}" -perm -u+x -print -quit)"
   152	[ -n "${EXTRACTED_BIN}" ] && [ -x "${EXTRACTED_BIN}" ] \
   153	    || die "archive missing expected binary: ${BIN_NAME}"
   154	
   155	if [ -w "${PREFIX}" ]; then
   156	    install -m 0755 "${EXTRACTED_BIN}" "${PREFIX}/${BIN_NAME}"
   157	else
   158	    log "PREFIX ${PREFIX} not writable; using sudo"
   159	    need sudo
   160	    sudo install -m 0755 "${EXTRACTED_BIN}" "${PREFIX}/${BIN_NAME}"
   161	fi
   162	
   163	log "installed ${PREFIX}/${BIN_NAME}"
   164	log "next steps: ${BIN_NAME} --help"

