name: Release

# Lane H (v1.3) — one-tag release pipeline:
#   - cargo package + publish dry-run (gates manifest correctness)
#   - matrix build for Linux x86_64 + Linux aarch64 + macOS x86_64 + macOS arm64
#   - deb + rpm artifacts (Linux only)
#   - distroless multi-arch OCI image (amd64+arm64) -> ghcr.io
#   - cosign sign-blob for every binary archive (keyless OIDC)
#   - SLSA L3 build-provenance attestation via actions/attest-build-provenance
#   - trivy image scan (HIGH,CRITICAL fail)
#   - GitHub release (draft) populated with all artifacts + signatures
#   - release-please PR automation in a separate job (pre-tag)
#
# Security note: every `run:` step uses only trusted scalars (runner-set env
# like GITHUB_REF_NAME, step outputs, secrets). No user-controlled github.event
# fields are interpolated into shell commands.
#
# External gates (brew install / docker pull / cosign verify / crates.io
# publish) run on real tag push only; PR-level CI exercises dry-run paths.

on:
  push:
    tags:
      - 'v*'
  pull_request:
    paths:
      - '.github/workflows/release.yml'
      - 'Dockerfile.distroless'
      - 'Formula/rev-stealth.rb'
      - 'install.sh'
      - 'crates/stealth-cli/**'
      - 'release-please-config.json'
      - '.release-please-manifest.json'
  workflow_dispatch:

permissions:
  contents: read

env:
  CARGO_TERM_COLOR: always
  RUSTFLAGS: "-D warnings"
  REGISTRY: ghcr.io
  IMAGE_NAME: ${{ github.repository_owner }}/rev-stealth

jobs:
  preflight:
    name: preflight (lint + cargo dry-run)
    runs-on: ubuntu-22.04
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
        with:
          shared-key: ubuntu-22.04-stable
          workspaces: |
            . -> target
      - name: actionlint (workflow syntax)
        uses: raven-actions/actionlint@v2
      - name: shellcheck install.sh
        run: shellcheck -s sh install.sh
      # NOTE: workspace-wide `cargo package` fails because internal path
      # deps (e.g. mobile-fp) intentionally have no version requirement —
      # they're `publish = false`. `rev-stealth` is the only crates.io
      # publish target, so we package + dry-run-publish it explicitly.
      - name: cargo package -p rev-stealth
        run: cargo package -p rev-stealth --allow-dirty --no-verify
      - name: cargo publish dry-run (rev-stealth)
        run: cargo publish --dry-run --allow-dirty -p rev-stealth

  build-binaries:
    name: build (${{ matrix.target }})
    needs: preflight
    runs-on: ${{ matrix.os }}
    timeout-minutes: 60
    permissions:
      contents: read
      id-token: write
      attestations: write
    strategy:
      fail-fast: false
      matrix:
        include:
          - os: ubuntu-22.04
            target: x86_64-unknown-linux-musl
            cross: false
          - os: ubuntu-22.04
            target: aarch64-unknown-linux-musl
            cross: true
          - os: macos-14
            target: x86_64-apple-darwin
            cross: false
          - os: macos-14
            target: aarch64-apple-darwin
            cross: false
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
        with:
          targets: ${{ matrix.target }}
      - uses: Swatinem/rust-cache@v2
        with:
          shared-key: ${{ matrix.target }}-stable
          workspaces: |
            . -> target

      - name: Install cross toolchain (Linux aarch64)
        if: matrix.cross
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends \
            musl-tools gcc-aarch64-linux-gnu
          echo "CARGO_TARGET_AARCH64_UNKNOWN_LINUX_MUSL_LINKER=aarch64-linux-gnu-gcc" >> "$GITHUB_ENV"

      - name: Install musl tools (Linux x86_64)
        if: matrix.os == 'ubuntu-22.04' && !matrix.cross
        run: sudo apt-get update && sudo apt-get install -y --no-install-recommends musl-tools

      - name: cargo build --release
        env:
          BUILD_TARGET: ${{ matrix.target }}
        run: |
          cargo build --release --target "$BUILD_TARGET" \
            --bin rev-stealth --bin stealth-mcp --bin rev-auth

      - name: Stage tarball
        id: stage
        env:
          BUILD_TARGET: ${{ matrix.target }}
          REF_NAME: ${{ github.ref_name }}
          EVENT_NAME: ${{ github.event_name }}
          SHORT_SHA: ${{ github.sha }}
        run: |
          set -eu
          VERSION="$REF_NAME"
          if [ "$EVENT_NAME" != "push" ]; then
            VERSION="dev-${SHORT_SHA:0:8}"
          fi
          NAME="rev-stealth-${VERSION}-${BUILD_TARGET}"
          mkdir -p "dist/${NAME}"
          cp "target/${BUILD_TARGET}/release/rev-stealth"  "dist/${NAME}/"
          cp "target/${BUILD_TARGET}/release/stealth-mcp"  "dist/${NAME}/"
          cp "target/${BUILD_TARGET}/release/rev-auth"     "dist/${NAME}/"
          cp README.md LICENSE                             "dist/${NAME}/"
          tar -czf "dist/${NAME}.tar.gz" -C dist "${NAME}"
          (cd dist && shasum -a 256 "${NAME}.tar.gz" > "${NAME}.tar.gz.sha256")
          echo "archive=dist/${NAME}.tar.gz" >> "$GITHUB_OUTPUT"
          echo "version=${VERSION}"          >> "$GITHUB_OUTPUT"

      - name: Install cosign
        if: github.event_name == 'push'
        uses: sigstore/cosign-installer@v3

      - name: Cosign sign-blob (keyless OIDC)
        if: github.event_name == 'push'
        env:
          COSIGN_YES: "true"
          ARCHIVE: ${{ steps.stage.outputs.archive }}
        run: |
          cosign sign-blob \
            --yes \
            --output-signature "${ARCHIVE}.sig" \
            --output-certificate "${ARCHIVE}-keyless.pem" \
            "${ARCHIVE}"

      - name: Attest build provenance (SLSA L3)
        if: github.event_name == 'push'
        uses: actions/attest-build-provenance@v1
        with:
          subject-path: ${{ steps.stage.outputs.archive }}

      - name: Upload artifacts
        uses: actions/upload-artifact@v4
        with:
          name: bin-${{ matrix.target }}
          path: dist/*
          if-no-files-found: error

  package-deb:
    name: package .deb (${{ matrix.target }})
    needs: build-binaries
    runs-on: ubuntu-22.04
    timeout-minutes: 20
    strategy:
      fail-fast: false
      matrix:
        target: [x86_64-unknown-linux-musl, aarch64-unknown-linux-musl]
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - name: Install cargo-deb
        run: cargo install --locked cargo-deb
      - name: Restore release binary
        uses: actions/download-artifact@v4
        with:
          name: bin-${{ matrix.target }}
          path: dist
      - name: Stage target/release/rev-stealth for cargo-deb
        run: |
          set -eu
          mkdir -p target/release
          ARCHIVE=$(find dist -maxdepth 1 -name '*.tar.gz' -print -quit)
          tar -xzf "${ARCHIVE}" -C dist/
          BIN=$(find dist -type f -name rev-stealth | head -n 1)
          cp "${BIN}" target/release/rev-stealth
      - name: cargo deb --no-build
        run: cargo deb --no-build -p rev-stealth --output dist/
      - uses: actions/upload-artifact@v4
        with:
          name: deb-${{ matrix.target }}
          path: dist/*.deb
          if-no-files-found: error

  package-rpm:
    name: package .rpm (${{ matrix.target }})
    needs: build-binaries
    runs-on: ubuntu-22.04
    timeout-minutes: 20
    strategy:
      fail-fast: false
      matrix:
        target: [x86_64-unknown-linux-musl, aarch64-unknown-linux-musl]
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - name: Install cargo-generate-rpm
        run: cargo install --locked cargo-generate-rpm
      - name: Restore release binary
        uses: actions/download-artifact@v4
        with:
          name: bin-${{ matrix.target }}
          path: dist
      - name: Stage target/release/rev-stealth
        run: |
          set -eu
          mkdir -p target/release
          ARCHIVE=$(find dist -maxdepth 1 -name '*.tar.gz' -print -quit)
          tar -xzf "${ARCHIVE}" -C dist/
          BIN=$(find dist -type f -name rev-stealth | head -n 1)
          cp "${BIN}" target/release/rev-stealth
      - name: cargo generate-rpm
        run: cargo generate-rpm -p rev-stealth --output dist/
      - uses: actions/upload-artifact@v4
        with:
          name: rpm-${{ matrix.target }}
          path: dist/*.rpm
          if-no-files-found: error

  oci-image:
    name: oci image (distroless, multi-arch)
    needs: preflight
    runs-on: ubuntu-22.04
    timeout-minutes: 60
    permissions:
      contents: read
      packages: write
      id-token: write
      attestations: write
    steps:
      - uses: actions/checkout@v4
      - uses: docker/setup-qemu-action@v3
      - uses: docker/setup-buildx-action@v3
      - name: Docker meta
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}
          tags: |
            type=ref,event=tag
            type=ref,event=pr
            type=sha,prefix=sha-
      - name: Login to GHCR
        if: github.event_name == 'push'
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}
      - name: Build (and push on tag) multi-arch image
        id: build
        uses: docker/build-push-action@v6
        with:
          context: .
          file: ./Dockerfile.distroless
          platforms: linux/amd64,linux/arm64
          push: ${{ github.event_name == 'push' }}
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          provenance: true
          sbom: true
      - name: Install trivy
        uses: aquasecurity/setup-trivy@v0.2.0
      - name: trivy image scan (HIGH,CRITICAL)
        if: github.event_name == 'push'
        env:
          IMAGE_REF: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:${{ github.ref_name }}
        run: trivy --config trivy.yaml image "$IMAGE_REF"
      - name: Install cosign
        if: github.event_name == 'push'
        uses: sigstore/cosign-installer@v3
      - name: Cosign sign image (keyless)
        if: github.event_name == 'push'
        env:
          COSIGN_YES: "true"
          IMAGE_REF: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}@${{ steps.build.outputs.digest }}
        run: cosign sign --yes "$IMAGE_REF"
      - name: Attest image provenance (SLSA L3)
        if: github.event_name == 'push'
        uses: actions/attest-build-provenance@v1
        with:
          subject-name: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}
          subject-digest: ${{ steps.build.outputs.digest }}
          push-to-registry: true

  cargo-publish:
    name: cargo publish ${{ github.event_name == 'push' && 'real' || 'dry-run' }}
    needs: preflight
    runs-on: ubuntu-22.04
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - name: cargo publish (dry-run)
        if: github.event_name != 'push'
        run: cargo publish --dry-run --allow-dirty -p rev-stealth
      - name: cargo publish (real)
        if: github.event_name == 'push'
        env:
          CARGO_REGISTRY_TOKEN: ${{ secrets.CARGO_REGISTRY_TOKEN }}
        run: cargo publish --locked -p rev-stealth

  gh-release:
    name: draft GitHub release
    needs: [build-binaries, package-deb, package-rpm, oci-image, cargo-publish]
    if: github.event_name == 'push'
    runs-on: ubuntu-22.04
    timeout-minutes: 15
    permissions:
      contents: write
    steps:

exec
