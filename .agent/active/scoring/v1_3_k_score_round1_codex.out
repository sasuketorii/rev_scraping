             const branch = process.env.BRANCH_PCT;
             const fn = process.env.FN_PCT;
             const lineMin = process.env.LINE_MIN;
             const branchMin = process.env.BRANCH_MIN;
             const fnMin = process.env.FN_MIN;
+            const baseLine = process.env.BASELINE_LINE;
+            let deltaCell = 'n/a (no baseline)';
+            if (baseLine && baseLine.length > 0) {
+              const d = (parseFloat(line) - parseFloat(baseLine)).toFixed(2);
+              const sign = parseFloat(d) >= 0 ? '+' : '';
+              deltaCell = `${sign}${d}% vs main (${baseLine}%)`;
+            }
             const body = [
               '### Coverage (Lane K K.1 soft gate)',
               '',
-              '| metric | value | v1.3 gate |',
-              '| ------ | ----- | --------- |',
-              `| line   | ${line}% | >= ${lineMin}% (soft) |`,
-              `| branch | ${branch}% | >= ${branchMin}% (soft, may be 0 if unsupported) |`,
-              `| fn     | ${fn}% | >= ${fnMin}% (soft) |`,
+              '| metric | value | v1.3 gate | delta |',
+              '| ------ | ----- | --------- | ----- |',
+              `| line   | ${line}% | >= ${lineMin}% (soft) | ${deltaCell} |`,
+              `| branch | ${branch}% | >= ${branchMin}% (soft, may be 0 if unsupported) | — |`,
+              `| fn     | ${fn}% | >= ${fnMin}% (soft) | — |`,
               '',
               '_v1.3 is a soft gate (warn-only). v1.4 promotes to hard gate (85 / 75)._',
             ].join('\n');
             await github.rest.issues.createComment({
