# SPDX-License-Identifier: MIT
# cargo-deny configuration for rev_scraping (P10 security hardening).
# Run with: cargo deny check
# Docs: https://embarkstudios.github.io/cargo-deny/

[graph]
all-features = true

[output]
feature-depth = 1

[licenses]
# Reject crates with no detectable license, default-deny anything not in the
# allow-list, warn on copyleft licenses. Confidence threshold is the standard
# cargo-deny default (0.93 = high-confidence license detection).
confidence-threshold = 0.93
allow = [
    "MIT",
    "Apache-2.0",
    "Apache-2.0 WITH LLVM-exception",
    "BSD-3-Clause",
    "BSD-2-Clause",
    "ISC",
    "Unicode-3.0",
    "MPL-2.0",
    "CDLA-Permissive-2.0",
    # BSL-1.0 (Boost Software License) is OSI-approved and FSF Free/Libre,
    # functionally equivalent to MIT for distribution. Pulled in by
    # `xxhash-rust` (used by stealth-parse / vpn-rotate). Explicitly listed
    # so cargo-deny does not silently classify it.
    "BSL-1.0",
]

[advisories]
db-urls = ["https://github.com/rustsec/advisory-db"]
# `version = 2` enables the post-2024 strict advisory schema where individual
# severity knobs (vulnerability/unmaintained/yanked/notice) are folded into
# `ignore` + `unmaintained` lists.
version = 2
yanked = "deny"
unmaintained = "workspace"
ignore = [
    # Add advisory IDs here only with a documented justification + sunset date.
]

[bans]
multiple-versions = "warn"
wildcards = "deny"
# Internal workspace crates use `{ workspace = true }` which cargo-deny would
# otherwise flag as wildcard deps. This keeps the wildcard ban on external
# crates only — exactly the supply-chain attack surface we care about.
allow-wildcard-paths = true
highlight = "all"
workspace-default-features = "allow"
external-default-features = "allow"
deny = [
    # Known-bad / superseded crates. Add entries with `# reason: ...` comments.
]
skip = []
skip-tree = []

[sources]
unknown-registry = "deny"
unknown-git = "deny"
allow-registry = ["https://github.com/rust-lang/crates.io-index"]
allow-git = []

