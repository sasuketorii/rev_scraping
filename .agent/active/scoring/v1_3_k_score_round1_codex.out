    36	    name: workspace SBOM (CycloneDX + SPDX)
    37	    runs-on: ubuntu-22.04
    38	    timeout-minutes: 25
    39	    steps:
    40	      - uses: actions/checkout@v4
    41	      - uses: dtolnay/rust-toolchain@stable
    42	      - uses: Swatinem/rust-cache@v2
    43	        with:
    44	          shared-key: ubuntu-22.04-stable-sbom
    45	          workspaces: |
    46	            . -> target
    47	      - uses: taiki-e/install-action@v2
    48	        with:
    49	          tool: cargo-cyclonedx
    50	      - name: cargo cyclonedx (workspace, JSON, all features)
    51	        run: |
    52	          set -euo pipefail
    53	          cargo cyclonedx --format json --all
    54	          mkdir -p dist/sbom
    55	          # cargo-cyclonedx writes per-crate bom.json into each crate dir.
    56	          # Copy each into dist/sbom/ with the crate name prefix.
    57	          for f in crates/*/bom.json; do
    58	            test -f "$f" || continue
    59	            crate_dir=$(dirname "$f")
    60	            crate_name=$(basename "$crate_dir")
    61	            cp "$f" "dist/sbom/${crate_name}.cdx.json"
    62	          done
    63	          # Top-level workspace bom (if cargo-cyclonedx emits one).
    64	          if [ -f bom.json ]; then
    65	            cp bom.json dist/sbom/workspace.cdx.json
    66	          fi
    67	
    68	      - name: Install syft (SPDX)
    69	        run: |
    70	          set -euo pipefail
    71	          curl -sSfL https://raw.githubusercontent.com/anchore/syft/main/install.sh \
    72	            | sh -s -- -b /usr/local/bin
    73	
    74	      - name: syft to SPDX JSON
    75	        run: |
    76	          set -euo pipefail
    77	          mkdir -p dist/sbom
    78	          syft scan dir:. -o spdx-json=dist/sbom/workspace.spdx.json
    79	
    80	      - name: Install cosign (tag push only)
    81	        if: github.event_name == 'push' && startsWith(github.ref, 'refs/tags/')
    82	        uses: sigstore/cosign-installer@v3
    83	
    84	      - name: cosign sign-blob (workspace SBOMs)
    85	        if: github.event_name == 'push' && startsWith(github.ref, 'refs/tags/')
    86	        env:
    87	          COSIGN_YES: "true"
    88	        run: |
    89	          set -euo pipefail
    90	          for f in dist/sbom/workspace.cdx.json dist/sbom/workspace.spdx.json; do
    91	            test -f "$f" || continue
    92	            cosign sign-blob --yes \
    93	              --bundle "${f}.cosign.bundle" \
    94	              "$f"
    95	          done
    96	
    97	      - name: Upload SBOM artifact (PR + dispatch)
    98	        if: github.event_name != 'push'
    99	        uses: actions/upload-artifact@v4
   100	        with:
   101	          name: sbom-${{ github.sha }}
   102	          path: dist/sbom/**
   103	          if-no-files-found: error
   104	          retention-days: 14
   105	
   106	      - name: Attach SBOM to GitHub Release (tag)
