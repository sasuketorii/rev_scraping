+      - name: Fetch baseline coverage from main
+        id: baseline
+        if: github.event_name == 'pull_request'
+        continue-on-error: true
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: |
+          set -euo pipefail
+          mkdir -p /tmp/baseline
+          run_id=$(gh run list --branch main --workflow coverage.yml \
+            --status success --limit 1 --json databaseId \
+            -q '.[0].databaseId' 2>/dev/null || echo "")
+          if [ -z "$run_id" ]; then
+            echo "no baseline coverage run found yet"
+            echo "baseline_line=" >> "$GITHUB_OUTPUT"
+            exit 0
+          fi
+          gh run download "$run_id" -n coverage-lcov -D /tmp/baseline \
+            || { echo "baseline artifact unavailable"; exit 0; }
+          if [ -f /tmp/baseline/coverage-summary.json ]; then
+            base_line=$(python3 -c 'import json; d=json.load(open("/tmp/baseline/coverage-summary.json"))["data"][0]["totals"]; print(round(d["lines"]["percent"],2))')
+            echo "baseline_line=$base_line" >> "$GITHUB_OUTPUT"
+          fi
+      - name: Comment on PR with coverage + delta vs main
         if: github.event_name == 'pull_request'
