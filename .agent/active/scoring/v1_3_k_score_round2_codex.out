name: Security

on:
  push:
    branches: [main]
  pull_request:
  schedule:
    - cron: '0 6 * * 1'

env:
  CARGO_TERM_COLOR: always

jobs:
  cargo-deny:
    name: cargo deny check
    runs-on: ubuntu-22.04
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
        with:
          shared-key: ubuntu-22.04-stable
          workspaces: |
            . -> target
      - uses: taiki-e/install-action@v2
        with:
          tool: cargo-deny
      - name: Initialize deny.toml if missing
        if: hashFiles('deny.toml') == ''
        run: cargo deny init
      - name: cargo deny check
        run: cargo deny check

  cargo-audit:
    name: cargo audit
    runs-on: ubuntu-22.04
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
        with:
          shared-key: ubuntu-22.04-stable
          workspaces: |
            . -> target
      - uses: taiki-e/install-action@v2
        with:
          tool: cargo-audit
      - name: cargo audit --deny warnings
        run: cargo audit --deny warnings

  cargo-msrv:
    # Lane K K.2: third gate of the three-point supply-chain check
    # (cargo-deny + cargo-audit + cargo-msrv verify). Confirms the
    # workspace `rust-version = "1.83"` claim is still buildable against
    # the pinned MSRV so dependency bumps don't silently force a newer
    # compiler on consumers.
    name: cargo msrv verify
    runs-on: ubuntu-22.04
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
        with:
          shared-key: ubuntu-22.04-stable
          workspaces: |
            . -> target
      - uses: taiki-e/install-action@v2
        with:
          tool: cargo-msrv
      - name: cargo msrv verify --workspace
        run: cargo msrv verify --workspace --output-format json

  forbid-unsafe-lint:
    # Lane K K.3: enforce `#![forbid(unsafe_code)]` on every crate root.
    # `obscura-bridge` is exempted from the deny-list per spec because it
    # shells out to a vendored binary and may need to grow `unsafe` blocks
    # in the future; the spec calls for `#![deny(unsafe_op_in_unsafe_fn)]`
    # plus a SAFETY doc lint when that happens. At v1.3 boundary no crate
    # actually uses `unsafe`, so the strict `forbid` is applied uniformly
    # and this job ensures no future crate root silently drops the lint.
    name: forbid(unsafe_code) crate-root check
    runs-on: ubuntu-22.04
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@v4
      - name: Verify every crate root + bin entry has #![forbid(unsafe_code)]
        run: |
          set -euo pipefail
          missing=()
          # K.3: lib roots
          for f in crates/*/src/lib.rs; do
            [ -f "$f" ] || continue
            if ! grep -q '#!\[forbid(unsafe_code)\]' "$f"; then
              missing+=("$f")
            fi
          done
          # K.3: every src/main.rs (workspace bin entrypoint)
          for f in crates/*/src/main.rs; do
            [ -f "$f" ] || continue
            if ! grep -q '#!\[forbid(unsafe_code)\]' "$f"; then
              missing+=("$f")
            fi
          done
          # K.3: every src/bin/*.rs (extra workspace bin entrypoints)
          for f in crates/*/src/bin/*.rs; do
            [ -f "$f" ] || continue
            if ! grep -q '#!\[forbid(unsafe_code)\]' "$f"; then
              missing+=("$f")
            fi
          done
          if [ "${#missing[@]}" -gt 0 ]; then
            echo "::error::missing #![forbid(unsafe_code)] in:"
            printf '  - %s\n' "${missing[@]}"
            exit 1
          fi
          n_lib=$(find crates -maxdepth 3 -path 'crates/*/src/lib.rs' | wc -l | tr -d ' ')
          n_main=$(find crates -maxdepth 3 -path 'crates/*/src/main.rs' | wc -l | tr -d ' ')
          n_bin=$(find crates -maxdepth 4 -path 'crates/*/src/bin/*.rs' | wc -l | tr -d ' ')
          echo "OK: ${n_lib} lib roots + ${n_main} main.rs + ${n_bin} bin/*.rs verified."

      - name: SAFETY-doc check for every unsafe block
        # K.3: any future `unsafe { ... }` block must be preceded by a
        # `// SAFETY:` doc-comment line explaining why the invariants
        # are upheld. The check ignores test modules and `unsafe impl`
        # / `unsafe fn` (rust-clippy already handles those via
        # undocumented_unsafe_blocks). v1.3 baseline has zero unsafe
        # blocks, so this is a future-proofing tripwire.
        run: |
          set -euo pipefail
          while IFS= read -r f; do
            # Find `unsafe {` not on a line that already has // SAFETY,
            # and verify the previous non-blank line contains SAFETY:.
            awk '
              /^[[:space:]]*\/\/[[:space:]]*SAFETY[[:space:]]*:/ { has_safety = 1; next }
              /unsafe[[:space:]]*\{/ {
                if (!has_safety) { print FILENAME ":" NR }
              }
              /^[[:space:]]*$/ { next }
              { has_safety = 0 }
            ' "$f"
          done < <(find crates -name '*.rs' -not -path '*/tests/*' -not -path '*/benches/*') \
            | tee /tmp/safety-violations.txt
          if [ -s /tmp/safety-violations.txt ]; then
            echo '::error::unsafe block(s) without // SAFETY: doc:'
            cat /tmp/safety-violations.txt
            exit 1
          fi
          echo "OK: no undocumented unsafe blocks."

  gitleaks:
    name: gitleaks
    runs-on: ubuntu-22.04
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
        with:
          shared-key: ubuntu-22.04-stable
          workspaces: |
            . -> target
      - uses: gitleaks/gitleaks-action@v2

