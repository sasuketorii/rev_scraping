    97	          # v1.3 soft gate: exit 0 unconditionally. v1.4 promote to exit 1 on miss.
    98	          exit 0
    99	      # Fetch main's last recorded coverage from the most recent main-branch
   100	      # workflow run artifact, compute delta, and surface it in the PR
   101	      # comment. If the artifact is unavailable (first run, retention
   102	      # eviction), we omit the delta gracefully instead of failing.
   103	      - name: Fetch baseline coverage from main
   104	        id: baseline
   105	        if: github.event_name == 'pull_request'
   106	        continue-on-error: true
   107	        env:
   108	          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
   109	        run: |
   110	          set -euo pipefail
   111	          mkdir -p /tmp/baseline
   112	          run_id=$(gh run list --branch main --workflow coverage.yml \
   113	            --status success --limit 1 --json databaseId \
   114	            -q '.[0].databaseId' 2>/dev/null || echo "")
   115	          if [ -z "$run_id" ]; then
   116	            echo "no baseline coverage run found yet"
   117	            echo "baseline_line=" >> "$GITHUB_OUTPUT"
   118	            exit 0
   119	          fi
   120	          gh run download "$run_id" -n coverage-lcov -D /tmp/baseline \
   121	            || { echo "baseline artifact unavailable"; exit 0; }
   122	          if [ -f /tmp/baseline/coverage-summary.json ]; then
   123	            base_line=$(python3 -c 'import json; d=json.load(open("/tmp/baseline/coverage-summary.json"))["data"][0]["totals"]; print(round(d["lines"]["percent"],2))')
   124	            echo "baseline_line=$base_line" >> "$GITHUB_OUTPUT"
   125	          fi
   126	      - name: Comment on PR with coverage + delta vs main
   127	        if: github.event_name == 'pull_request'
   128	        uses: actions/github-script@v7
   129	        env:
   130	          LINE_PCT: ${{ steps.gate.outputs.line }}
   131	          BRANCH_PCT: ${{ steps.gate.outputs.branch }}
   132	          FN_PCT: ${{ steps.gate.outputs.fn }}
   133	          LINE_MIN: ${{ env.COVERAGE_LINE_MIN }}
   134	          BRANCH_MIN: ${{ env.COVERAGE_BRANCH_MIN }}
   135	          FN_MIN: ${{ env.COVERAGE_FN_MIN }}
   136	          BASELINE_LINE: ${{ steps.baseline.outputs.baseline_line }}
   137	        with:
   138	          script: |
   139	            const line = process.env.LINE_PCT;
   140	            const branch = process.env.BRANCH_PCT;
   141	            const fn = process.env.FN_PCT;
   142	            const lineMin = process.env.LINE_MIN;
   143	            const branchMin = process.env.BRANCH_MIN;
   144	            const fnMin = process.env.FN_MIN;
   145	            const baseLine = process.env.BASELINE_LINE;
   146	            let deltaCell = 'n/a (no baseline)';
   147	            if (baseLine && baseLine.length > 0) {
   148	              const d = (parseFloat(line) - parseFloat(baseLine)).toFixed(2);
   149	              const sign = parseFloat(d) >= 0 ? '+' : '';
   150	              deltaCell = `${sign}${d}% vs main (${baseLine}%)`;
   151	            }
   152	            const body = [
   153	              '### Coverage (Lane K K.1 soft gate)',
   154	              '',
   155	              '| metric | value | v1.3 gate | delta |',
   156	              '| ------ | ----- | --------- | ----- |',
   157	              `| line   | ${line}% | >= ${lineMin}% (soft) | ${deltaCell} |`,
   158	              `| branch | ${branch}% | >= ${branchMin}% (soft, may be 0 if unsupported) | — |`,
   159	              `| fn     | ${fn}% | >= ${fnMin}% (soft) | — |`,
   160	              '',
   161	              '_v1.3 is a soft gate (warn-only). v1.4 promotes to hard gate (85 / 75)._',
   162	            ].join('\n');
