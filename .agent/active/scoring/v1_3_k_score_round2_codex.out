     3	# Lane K K.1 — `cargo-llvm-cov` soft gate.
     4	#
     5	# v1.3 thresholds: line >= 80% / branch >= 70% (warn-only / soft gate).
     6	# v1.4 thresholds: line >= 85% / branch >= 75% (hard gate, blocks merge).
     7	#
     8	# The job emits an LCOV artifact + a JSON summary + a PR comment with the
     9	# delta vs main. `--fail-under-lines` and `--fail-under-functions` are
    10	# threaded through `cargo llvm-cov` so the same job can flip from soft to
    11	# hard at v1.4 by removing `continue-on-error: true`.
    12	
    13	on:
    14	  push:
    15	    branches: [main]
    16	  pull_request:
    17	
    18	env:
    19	  CARGO_TERM_COLOR: always
    20	  # v1.3 soft gate. Bump to 85 / 75 at v1.4.
    21	  COVERAGE_LINE_MIN: "80"
    22	  COVERAGE_BRANCH_MIN: "70"
    23	  COVERAGE_FN_MIN: "75"
    24	
    25	jobs:
    26	  llvm-cov:
    27	    name: cargo llvm-cov (soft gate v1.3)
    28	    runs-on: ubuntu-22.04
    29	    timeout-minutes: 45
    30	    # v1.3 soft gate: never block merge. Flip to false at v1.4.
    31	    continue-on-error: true
    32	    permissions:
    33	      contents: read
    34	      pull-requests: write
    35	      # Needed for the baseline lookup step to call `gh run list/download`
    36	      # against the previous main-branch coverage run.
    37	      actions: read
