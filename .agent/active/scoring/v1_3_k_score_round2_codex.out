    45	      - uses: Swatinem/rust-cache@v2
    46	        with:
    47	          shared-key: ubuntu-22.04-stable-cov
    48	          workspaces: |
    49	            . -> target
    50	      - uses: taiki-e/install-action@v2
    51	        with:
    52	          tool: cargo-llvm-cov
    53	      - name: cargo llvm-cov --workspace (LCOV)
    54	        # Branch coverage (`--branch`) currently requires nightly per
    55	        # cargo-llvm-cov docs; v1.3 uses stable for reproducibility, so
    56	        # we collect line + function coverage only and leave branch%
    57	        # reported as 0 (the gate step treats 0 as "unsupported, do not
    58	        # warn"). Promotion to nightly + --branch is tracked for v1.4.
    59	        run: |
    60	          set -euo pipefail
    61	          cargo llvm-cov --workspace --no-fail-fast \
    62	            --ignore-filename-regex '(tests?/|benches/|examples/|/build\.rs$|crates/obscura-bridge/)' \
    63	            --lcov --output-path lcov.info
    64	      - name: cargo llvm-cov --workspace (JSON summary)
    65	        run: |
    66	          set -euo pipefail
    67	          cargo llvm-cov report --json --summary-only \
    68	            --output-path coverage-summary.json
    69	      - name: Upload LCOV artifact
    70	        uses: actions/upload-artifact@v4
    71	        with:
    72	          name: coverage-lcov
    73	          path: |
    74	            lcov.info
    75	            coverage-summary.json
    76	          if-no-files-found: error
    77	          retention-days: 14
    78	      - name: Enforce coverage thresholds (soft gate v1.3)
    79	        id: gate
    80	        run: |
    81	          set -euo pipefail
    82	          line_pct=$(python3 -c 'import json; d=json.load(open("coverage-summary.json"))["data"][0]["totals"]; print(round(d["lines"]["percent"],2))')
    83	          fn_pct=$(python3 -c 'import json; d=json.load(open("coverage-summary.json"))["data"][0]["totals"]; print(round(d["functions"]["percent"],2))')
    84	          branch_pct=$(python3 -c 'import json; d=json.load(open("coverage-summary.json"))["data"][0]["totals"]; print(round(d.get("branches",{}).get("percent",0.0),2))')
    85	          {
    86	            echo "line=$line_pct"
    87	            echo "branch=$branch_pct"
    88	            echo "fn=$fn_pct"
    89	          } >> "$GITHUB_OUTPUT"
    90	          echo "::notice title=coverage::line=$line_pct% / branch=$branch_pct% / fn=$fn_pct%"
    91	          awk -v a="$line_pct" -v b="$COVERAGE_LINE_MIN" 'BEGIN{exit !(a+0 < b+0)}' && \
    92	            echo "::warning::line coverage $line_pct% < soft gate ${COVERAGE_LINE_MIN}%"
    93	          awk -v a="$fn_pct" -v b="$COVERAGE_FN_MIN" 'BEGIN{exit !(a+0 < b+0)}' && \
    94	            echo "::warning::function coverage $fn_pct% < soft gate ${COVERAGE_FN_MIN}%"
    95	          awk -v a="$branch_pct" -v b="$COVERAGE_BRANCH_MIN" 'BEGIN{exit !(a+0 < b+0 && a+0 > 0)}' && \
