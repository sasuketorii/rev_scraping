    91	          set -euo pipefail
    92	          missing=()
    93	          # K.3: lib roots
    94	          for f in crates/*/src/lib.rs; do
    95	            [ -f "$f" ] || continue
    96	            if ! grep -q '#!\[forbid(unsafe_code)\]' "$f"; then
    97	              missing+=("$f")
    98	            fi
    99	          done
   100	          # K.3: every src/main.rs (workspace bin entrypoint)
   101	          for f in crates/*/src/main.rs; do
   102	            [ -f "$f" ] || continue
   103	            if ! grep -q '#!\[forbid(unsafe_code)\]' "$f"; then
   104	              missing+=("$f")
   105	            fi
   106	          done
   107	          # K.3: every src/bin/*.rs (extra workspace bin entrypoints)
   108	          for f in crates/*/src/bin/*.rs; do
   109	            [ -f "$f" ] || continue
   110	            if ! grep -q '#!\[forbid(unsafe_code)\]' "$f"; then
   111	              missing+=("$f")
   112	            fi
   113	          done
   114	          if [ "${#missing[@]}" -gt 0 ]; then
   115	            echo "::error::missing #![forbid(unsafe_code)] in:"
   116	            printf '  - %s\n' "${missing[@]}"
   117	            exit 1
   118	          fi
   119	          n_lib=$(find crates -maxdepth 3 -path 'crates/*/src/lib.rs' | wc -l | tr -d ' ')
   120	          n_main=$(find crates -maxdepth 3 -path 'crates/*/src/main.rs' | wc -l | tr -d ' ')
   121	          n_bin=$(find crates -maxdepth 4 -path 'crates/*/src/bin/*.rs' | wc -l | tr -d ' ')
   122	          echo "OK: ${n_lib} lib roots + ${n_main} main.rs + ${n_bin} bin/*.rs verified."
   123	
   124	      - name: SAFETY-doc check for every unsafe block
   125	        # K.3: any future `unsafe { ... }` block must be preceded by a
   126	        # `// SAFETY:` doc-comment line explaining why the invariants
   127	        # are upheld. The check ignores test modules and `unsafe impl`
   128	        # / `unsafe fn` (rust-clippy already handles those via
   129	        # undocumented_unsafe_blocks). v1.3 baseline has zero unsafe
   130	        # blocks, so this is a future-proofing tripwire.
   131	        run: |
   132	          set -euo pipefail
   133	          while IFS= read -r f; do
   134	            # Find `unsafe {` not on a line that already has // SAFETY,
   135	            # and verify the previous non-blank line contains SAFETY:.
   136	            awk '
   137	              /^[[:space:]]*\/\/[[:space:]]*SAFETY[[:space:]]*:/ { has_safety = 1; next }
   138	              /unsafe[[:space:]]*\{/ {
   139	                if (!has_safety) { print FILENAME ":" NR }
   140	              }
   141	              /^[[:space:]]*$/ { next }
   142	              { has_safety = 0 }
   143	            ' "$f"
   144	          done < <(find crates -name '*.rs' -not -path '*/tests/*' -not -path '*/benches/*') \
   145	            | tee /tmp/safety-violations.txt
   146	          if [ -s /tmp/safety-violations.txt ]; then
   147	            echo '::error::unsafe block(s) without // SAFETY: doc:'
   148	            cat /tmp/safety-violations.txt
   149	            exit 1
   150	          fi
   151	          echo "OK: no undocumented unsafe blocks."
