   591	          for crate in stealth-core stealth-auth stealth-sanitize \
   592	                       stealth-agent-contracts stealth-parse stealth-mcp; do
   593	            echo "::group::cargo public-api diff -p $crate"
   594	
   595	            # Pass 1: smoke run, no --deny. Non-zero ⇒ exec failure.
   596	            smoke_rc=0
   597	            cargo public-api --package "$crate" \
   598	              diff "$BASE_SHA..$HEAD_SHA" \
   599	              > "$tmpdir/${crate}.smoke.out" 2> "$tmpdir/${crate}.smoke.err" \
   600	              || smoke_rc=$?
   601	            cat "$tmpdir/${crate}.smoke.out"
   602	            cat "$tmpdir/${crate}.smoke.err" >&2
   603	            if [[ "$smoke_rc" -ne 0 ]]; then
   604	              echo "::error::cargo public-api -p $crate (pass 1, no --deny) exited rc=$smoke_rc — treating as tool/build failure, NOT a diff. Labels do not waive this."
   605	              exec_fail=1
   606	              echo "::endgroup::"
   607	              continue
   608	            fi
   609	
   610	            # Pass 2: deny-all run. Non-zero ⇒ real surface diff.
   611	            deny_rc=0
   612	            cargo public-api --package "$crate" \
   613	              diff --deny=all "$BASE_SHA..$HEAD_SHA" \
   614	              > "$tmpdir/${crate}.deny.out" 2> "$tmpdir/${crate}.deny.err" \
   615	              || deny_rc=$?
   616	            cat "$tmpdir/${crate}.deny.out"
   617	            cat "$tmpdir/${crate}.deny.err" >&2
   618	            if [[ "$deny_rc" -ne 0 ]]; then
   619	              diff_seen=1
   620	            fi
   621	            echo "::endgroup::"
   622	          done
   623	
   624	          if [[ "$exec_fail" -ne 0 ]]; then
   625	            echo "::error::cargo-public-api hard gate cannot evaluate label compliance because at least one crate's pass-1 smoke run failed. Fix the underlying tool/build error; labels do not waive this."
   626	            exit 1
   627	          fi
   628	
   629	          if [[ "$diff_seen" -eq 0 ]]; then
   630	            echo "[cargo-public-api] no public-surface diff vs $BASE_REF — gate PASS."
   631	            exit 0
   632	          fi
   633	
   634	          # Step 2: surface diverged ⇒ a label is mandatory. Read labels from
   635	          # the PR event payload (no extra API call required); fall back to
   636	          # the REST API if the payload is empty (defensive).
   637	          labels_csv="$(printf '%s' "$PR_LABELS_JSON" | python3 -c 'import json,sys; ls=json.load(sys.stdin) or []; print(",".join(l.get("name","") for l in ls))')"
   638	          if [[ -z "$labels_csv" ]]; then
   639	            labels_csv="$(gh api "repos/${GITHUB_REPOSITORY}/issues/${{ github.event.pull_request.number }}/labels" --jq '[.[].name] | join(",")' || echo "")"
   640	          fi
   641	          echo "[cargo-public-api] PR labels = '${labels_csv:-<none>}'"
   642	
   643	          has_additive=0
   644	          has_breaking=0
   645	          IFS=',' read -ra arr <<< "$labels_csv"
   646	          for l in "${arr[@]}"; do
   647	            case "$l" in
   648	              api-additive)  has_additive=1 ;;
   649	              api-breaking)  has_breaking=1 ;;
   650	            esac
   651	          done
   652	
   653	          if [[ "$has_additive" -eq 0 && "$has_breaking" -eq 0 ]]; then
   654	            echo "::error::cargo-public-api detected a public-surface diff vs $BASE_REF but no \`api-additive\` or \`api-breaking\` PR label is set."
   655	            echo "::error::Decide: pure additions (new pub item, no removal/rename) ⇒ apply \`api-additive\`."
   656	            echo "::error::Decide: any removal, rename, signature change, or visibility narrowing ⇒ apply \`api-breaking\` AND bump per docs/compat.md."
   657	            exit 1
   658	          fi
   659	
   660	          if [[ "$has_additive" -eq 1 && "$has_breaking" -eq 1 ]]; then
   661	            echo "::error::Both \`api-additive\` and \`api-breaking\` labels are set; choose exactly one (a PR is either additive or breaking)."
   662	            exit 1
   663	          fi
   664	
   665	          echo "[cargo-public-api] surface diverged; one explicit label found ⇒ gate PASS (additive=$has_additive, breaking=$has_breaking)."
   666	
   667	  # I.5: MCP tool-schema breaking-change detector. Mirrors mcp-schema-lint
   668	  # but specifically asserts the canonical 16-tool list (Lane I.1 snapshot)
   669	  # has not been mutated. Drift requires `mcp-schema-breaking` PR label.
   670	  mcp-schema-breaking-detector:
   671	    name: MCP tool schema breaking-change
   672	    runs-on: ubuntu-22.04
   673	    timeout-minutes: 15
   674	    steps:
   675	      - uses: actions/checkout@v4
   676	        with:
   677	          fetch-depth: 0
   678	      - uses: dtolnay/rust-toolchain@stable
   679	      - uses: Swatinem/rust-cache@v2
   680	        with:
   681	          shared-key: ubuntu-22.04-stable
   682	          workspaces: |
   683	            . -> target
   684	      - name: gen_reference freshness
   685	        run: cargo run -q -p stealth-mcp --bin gen_reference -- --check
   686	      - name: fetch base ref
   687	        if: github.event_name == 'pull_request'
   688	        env:
   689	          BASE_REF: ${{ github.event.pull_request.base.ref }}
   690	        run: git fetch --no-tags --depth=200 origin "$BASE_REF"
   691	      - name: mcp-schema-breaking diff vs base (label-aware)
   692	        env:
   693	          BASE_REF: origin/${{ github.event.pull_request.base.ref || 'main' }}
   694	          PR_LABELS_JSON: ${{ toJson(github.event.pull_request.labels) }}
   695	          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
   696	        run: |
   697	          set -euo pipefail
   698	          # R2 label gate. The script uses a 3-valued exit-code contract:
   699	          #   0 — surface unchanged
   700	          #   2 — INTENTIONAL breaking diff (label waiver applies)
   701	          #   any other nonzero — script execution failure (NEVER waiveable)
   702	          # `$?` after `if/fi` returns 0 from the un-taken branch (bash spec);
   703	          # capture via `|| rc=$?` instead so the real exit code survives.
   704	          rc=0
   705	          ./scripts/mcp-schema-breaking.sh --check || rc=$?
   706	          if [[ "$rc" -eq 0 ]]; then
   707	            exit 0
   708	          fi
   709	          if [[ "$rc" -ne 2 ]]; then
   710	            echo "::error::mcp-schema-breaking.sh exited rc=$rc (script execution failure, not a breaking diff). Labels do not waive this. Fix the underlying error."
   711	            exit "$rc"
   712	          fi
   713	          if [[ "${GITHUB_EVENT_NAME:-}" != "pull_request" ]]; then
   714	            exit "$rc"
   715	          fi
   716	          labels_csv="$(printf '%s' "$PR_LABELS_JSON" | python3 -c 'import json,sys; ls=json.load(sys.stdin) or []; print(",".join(l.get("name","") for l in ls))')"
   717	          echo "[mcp-schema-breaking] PR labels = '${labels_csv:-<none>}'"
   718	          has_breaking=0
   719	          IFS=',' read -ra arr <<< "$labels_csv"
   720	          for l in "${arr[@]}"; do
   721	            [[ "$l" == "mcp-schema-breaking" ]] && has_breaking=1
   722	          done
   723	          if [[ "$has_breaking" -eq 1 ]]; then
   724	            echo "::warning::MCP schema breaking change detected and explicit \`mcp-schema-breaking\` label is set; gate PASS."
   725	            exit 0
   726	          fi
   727	          echo "::error::MCP tool-schema breaking change requires the \`mcp-schema-breaking\` PR label (and a 2-major bump per docs/compat.md)."
   728	          exit "$rc"
   800	  # I.8 (R2): fixture tests for scripts/mcp-schema-breaking.sh. Asserts the
   801	  # 3-valued exit-code contract (0/2/other) and the four breaking-change
   802	  # detectors (tool removal, required-arg tightening, input enum narrowing,
   803	  # output property removal / output enum narrowing) against synthetic
   804	  # schema_version=3 snapshot blobs. Catches regressions in the detector
   805	  # itself before they let a real breaking PR through.
   806	  mcp-schema-breaking-fixture-tests:
   807	    name: MCP schema breaking detector — fixture tests
   808	    runs-on: ubuntu-22.04
   809	    timeout-minutes: 5
   810	    steps:
   811	      - uses: actions/checkout@v4
   812	      - name: run fixture tests
   813	        run: bash scripts/cli-public-api-snapshot.test.sh
   814	
   815	  # I.7 (R2): keep-a-changelog 1.1 structural lint for
   816	  # CHANGELOG.rev_scraping.md. Mirrors the release-please-config.json
   817	  # `changelog-path` setting and gates the `## [Unreleased]` cursor that
   818	  # release-please relies on to compute the next bump. A malformed file
   819	  # would fail release-please at release time instead of at PR time, so
   820	  # we shift the check left.
   821	  changelog-lint:
   822	    name: CHANGELOG keep-a-changelog lint
   823	    runs-on: ubuntu-22.04
   824	    timeout-minutes: 5
   825	    steps:
   826	      - uses: actions/checkout@v4
   827	      - name: changelog structural lint
   828	        run: python3 scripts/changelog-keepachangelog-lint.py CHANGELOG.rev_scraping.md

