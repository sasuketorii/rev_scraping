#!/usr/bin/env bash
# Lane I.1 — capture the rev-stealth CLI public surface as deterministic JSON.
#
# Output: .agent/v1.3/cli-public-api.snapshot.json
#
# Modes:
#   ./scripts/cli-public-api-snapshot.sh           # regenerate snapshot
#   ./scripts/cli-public-api-snapshot.sh --check   # exit 1 if drift detected
#
# Public-surface coverage (per v1.3 ExecPlan Lane I.1 + R2 expansion):
#   - every subcommand + nested subcommand (depth 1 & 2)
#   - every flag (long + short), default value, value-set when enum,
#     env-var binding (captured across wrapped help lines)
#   - every documented env var (REV_STEALTH_OBSCURA, REV_SCRAPING_*, etc.)
#   - every documented exit code from --help bodies (0/1/3/7/10)
#   - MCP tool surface (16 tools: names + required input-schema fields +
#     R2: input-schema enum constraints + output-schema top-level property
#     names + output-schema enum constraints sourced from
#     docs/json-schemas/<tool>.output.json)
#   - R2: full 26-variant ErrorKind closed-set (wire_name strings) extracted
#     from crates/stealth-agent-contracts/src/error.rs
#   - R2: every `#[deprecated]` attribute's `replace_with=…` (or "Use …" /
#     "Prefer …" / "replaced by …") replacement hint, indexed by source
#     path:line so silent removal of the replacement string is caught.
#   - rev-stealth --version string
#
# Schema version: R2 bumps `$schema_version` from 2 → 3 (additive — fields
# only appended). Snapshot consumers must re-parse on bump.
#
# Schema-stable JSON: keys sorted alphabetically at every level. Drift = any
# byte-level diff against the committed snapshot.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

SNAPSHOT_PATH=".agent/v1.3/cli-public-api.snapshot.json"
BIN="${REV_STEALTH_BIN:-./target/debug/rev-stealth}"

if [[ ! -x "$BIN" ]]; then
  echo "[snapshot] building stealth-cli (debug)..." >&2
  cargo build -p rev-stealth >&2
fi

# All top-level subcommands declared in the workspace today. We use `__` as the
# helpfile separator (never appears in clap subcommand names) so multi-hyphen
# commands like `cf-evaluate` survive round-tripping.
TOP_CMDS=(captcha browser vpn doctor spider relocate cf-evaluate auth measure config hermes)

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

"$BIN" --help > "$tmpdir/help__ROOT.txt" 2>&1 || true

for cmd in "${TOP_CMDS[@]}"; do
  "$BIN" "$cmd" --help > "$tmpdir/help__${cmd}.txt" 2>&1 || true
  awk '/^Commands:/{f=1;next} /^Options:/{f=0} f' "$tmpdir/help__${cmd}.txt" \
    | awk '{print $1}' \
    | { grep -Ev '^(help)?$' || true; } \
    | while read -r sub; do
        [[ -n "$sub" ]] || continue
        "$BIN" "$cmd" "$sub" --help \
          > "$tmpdir/help__${cmd}__${sub}.txt" 2>&1 || true
      done
done

VERSION_LINE="$("$BIN" --version 2>&1 | tr -d '\n')"

python3 - "$tmpdir" "$SNAPSHOT_PATH" "$VERSION_LINE" <<'PY'
import json, os, re, sys, subprocess
from pathlib import Path

tmpdir, snapshot_path, version_line = sys.argv[1], sys.argv[2], sys.argv[3]
tmp = Path(tmpdir)

ENV_VARS = sorted([
    "REV_STEALTH_OBSCURA",
    "REV_SCRAPING_HOME",
    "REV_SCRAPING_POLICY",
    "REV_SCRAPING_AUTHORIZED",
    "REV_SCRAPING_AUTH_DIR",
    "REV_SCRAPING_AUTH_PASSPHRASE",
    "REV_SCRAPING_PROFILES_ROOT",
    "REV_SCRAPING_AUP_ACK",
    "REV_SCRAPING_CONFIG_LENIENT",
    "REV_SCRAPING_VPN_INSTANCES",
    "REV_SCRAPING_REQUIRE_VPN",
])

EXIT_CODES = {
    "0":  "success",
    "1":  "generic CLI / validation error",
    "3":  "permanent runtime failure (browser launch, VPS deploy readiness)",
    "7":  "doctor fail-closed (leak detected)",
    "10": "relocate Ambiguous result under --strict",
}

FLAG_RE = re.compile(r"--[a-zA-Z0-9][a-zA-Z0-9_-]*")
SHORT_RE = re.compile(r"(?<![-\w])-[a-zA-Z](?![-\w])")
ENV_RE = re.compile(r"\[env:\s*([A-Z0-9_]+)=")
DEFAULT_RE = re.compile(r"\[default:\s*([^\]]*)\]")
POSSIBLE_RE = re.compile(r"\[possible values:\s*([^\]]+)\]")

def parse_help(text):
    """Extract usage, flags (with multi-line continuation), nested cmds."""
    usage = ""
    nested = []
    raw_lines = text.splitlines()

    # Locate Options: / Commands: sections.
    sections = {}
    for idx, line in enumerate(raw_lines):
        s = line.strip()
        if s.startswith("Usage:"):
            usage = s[len("Usage:"):].strip()
        if s == "Options:":
            sections["options"] = idx
        elif s == "Commands:":
            sections["commands"] = idx

    # Nested subcommands: scan the Commands: block.
    if "commands" in sections:
        start = sections["commands"] + 1
        for line in raw_lines[start:]:
            stripped = line.strip()
            if not stripped or stripped.startswith("-") or stripped.endswith(":"):
                if stripped == "Options:" or stripped.endswith(":"):
                    break
                continue
            tok = stripped.split(None, 1)[0]
            if tok and tok != "help" and not tok.startswith("-"):
                nested.append(tok)

    # Flags: iterate Options: block. A flag spans from the line starting with
    # "--" (or "-X, --") until the next flag-introducing line OR a blank line
    # followed by a non-indented section header. We collect every continuation
    # line into the flag's "block" so [env:...], [default:...], and
    # [possible values:...] tokens are captured even when wrapped.
    flags_by_name = {}
    if "options" in sections:
        start = sections["options"] + 1
        # Detect indentation of a flag line: clap uses "      --flag" (6 spaces)
        # or "  -X, --flag". We treat any line whose stripped form begins with
        # "-" as a flag-start line.
        i = start
        while i < len(raw_lines):
            line = raw_lines[i]
            stripped = line.strip()
            if stripped == "Options:" or stripped == "Commands:":
                i += 1
                continue
            if stripped and stripped.startswith("-"):
                # Accumulate block until next flag-start or end.
                block_lines = [line]
                j = i + 1
                while j < len(raw_lines):
                    nxt = raw_lines[j]
                    nxt_stripped = nxt.strip()
                    if nxt_stripped.startswith("-") and (
                        FLAG_RE.search(nxt) or SHORT_RE.search(nxt)
                    ):
                        # Heuristic: next line is a new flag if it has -short
                        # or --long AND starts with a dash after the leading
                        # whitespace (clap convention).
                        # Guard against description text that begins with "-":
                        # require ≤ 8 leading spaces (clap flag-line indent).
                        leading = len(nxt) - len(nxt.lstrip(" "))
                        if leading <= 8:
                            break
                    block_lines.append(nxt)
                    j += 1
                block = "\n".join(block_lines)
                long_flags = sorted(set(FLAG_RE.findall(block_lines[0])))
                # Short forms only from the first line (clap puts both forms
                # on the head line, never wrapped).
                short_forms = sorted(set(SHORT_RE.findall(block_lines[0])))
                env_match = ENV_RE.search(block)
                default_match = DEFAULT_RE.search(block)
                possible_match = POSSIBLE_RE.search(block)
                for f in long_flags:
                    entry = {"flag": f}
                    if short_forms:
                        entry["short"] = short_forms[0]
                    if env_match:
                        entry["env"] = env_match.group(1)
                    if default_match:
                        entry["default"] = default_match.group(1).strip()
                    if possible_match:
                        entry["values"] = sorted(
                            v.strip() for v in possible_match.group(1).split(",")
                        )
                    prev = flags_by_name.get(f)
                    if not prev or len(entry) > len(prev):
                        flags_by_name[f] = entry
                i = j
            else:
                i += 1

    return {
        "usage": usage,
        "flags": sorted(flags_by_name.values(), key=lambda x: x["flag"]),
        "subcommands": sorted(set(nested)),
    }

root_help = parse_help((tmp / "help__ROOT.txt").read_text())

commands = {}
for help_file in sorted(tmp.glob("help__*.txt")):
    stem = help_file.stem.removeprefix("help__")
    if stem == "ROOT":
        continue
    if "__" in stem:
        cmd, sub = stem.split("__", 1)
    else:
        cmd, sub = stem, None
    commands.setdefault(cmd, {"help": {}, "subcommands": {}})
    parsed = parse_help(help_file.read_text())
    if sub is None:
        commands[cmd]["help"] = parsed
    else:
        commands[cmd]["subcommands"][sub] = parsed

# MCP tool surface — parse tools.rs for `name: "<tool>"` AND each
# tool's required-arg names. We extract the schema's "required" array as a
# best-effort proxy for the public input contract.
tools_src = Path("crates/stealth-mcp/src/tools.rs").read_text()
tool_names = sorted(set(re.findall(r'name:\s*"([a-z_][a-z0-9_]*)"', tools_src)))

# Extract required arrays by scanning ToolDefinition blocks. We look for the
# nearest "required": [...] literal after each name and parse strings out.
def extract_required(src, name):
    """Extract the top-level `"required": [...]` array of the tool's
    input_schema, bounded to *this* tool's block.

    Strategy: locate `name: "<name>"`, then bound the window from the next
    `input_schema: json!({` to the matching `})`. Inside that window, only the
    *first* `"required": [...]` after `"properties":` decreases nesting depth
    counts as the top-level required (nested object schemas may also use
    `"required"`, e.g. `recipe_propose_endpoint.properties.endpoint.required`).

exec
/bin/bash -lc "sed -n '260,620p' .github/workflows/ci.yml" in $REPO_ROOT
 succeeded in 0ms:
          REV_SCRAPING_RUN_OBSCURA: "1"
        run: |
          export OBSCURA_BIN="$(pwd)/vendor/obscura/target/release/obscura"
          export REV_STEALTH_OBSCURA="$OBSCURA_BIN"
          cargo test --workspace -- --ignored cdp_shim_e2e
      - name: Upload logs on failure
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: cdp-shim-logs
          path: |
            target/**/*.log
            target/**/*.stderr
          if-no-files-found: ignore

  mcp-schema-lint:
    # Lane E P11: freshness gate for docs/MCP_REFERENCE.md.
    #
    # The generator binary (`stealth-mcp/src/bin/gen_reference.rs`) renders
    # the reference document from `tool_definitions()` and
    # `all_error_kind_docs()`. In `--check` mode it exits 1 if the committed
    # file disagrees with a fresh render. This complements (does not
    # replace) the `mcp_reference_freshness` regression test in the workspace
    # test suite; running it as its own job gives a clearer failure surface
    # when a contributor forgets to regenerate the doc.
    name: MCP reference freshness
    runs-on: ubuntu-22.04
    timeout-minutes: 25
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
        with:
          shared-key: ubuntu-22.04-stable
          workspaces: |
            . -> target
      - name: cargo run -p stealth-mcp --bin gen_reference -- --check
        run: cargo run -p stealth-mcp --bin gen_reference -- --check

  config-cli-smoke:
    # Lane E P11: smoke-test `rev-stealth config init --target=policy
    # --non-interactive --force` inside a throwaway $HOME so the CI verifies
    # the non-interactive init path stays exit-0 on a fresh profile. The
    # `--non-interactive` flag is the contract documented in P6.2 and must
    # never block on stdin.
    name: config CLI non-interactive smoke
    runs-on: ubuntu-22.04
    timeout-minutes: 25
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
        with:
          shared-key: ubuntu-22.04-stable
          workspaces: |
            . -> target
      - name: cargo build -p rev-stealth --bin rev-stealth
        run: cargo build -p rev-stealth --bin rev-stealth
      - name: config init --target=policy --non-interactive --force
        run: |
          set -euxo pipefail
          TMPHOME="$(mktemp -d)"
          export HOME="$TMPHOME"
          ./target/debug/rev-stealth config init \
            --target=policy --non-interactive --force
          # Verify the policy file was materialized inside the throwaway HOME.
          test -f "$TMPHOME/.rev_scraping/policy.toml"

  hermes-contract:
    # Lane E P11: run the Hermes (rev-scraping-mcp) plugin contract tests.
    # 20-test python suite under dist/hermes/rev-scraping-mcp/tests/ that
    # gates the stealth-mcp <-> Hermes wire shape (lifecycle, schema bridge,
    # tool proxy). Pure stdlib `unittest`; no extra pip install needed.
    name: Hermes plugin contract tests
    runs-on: ubuntu-22.04
    timeout-minutes: 25
    steps:
      - uses: actions/checkout@v4
      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - name: python3 -m unittest discover dist/hermes/rev-scraping-mcp/tests
        run: python3 -m unittest discover dist/hermes/rev-scraping-mcp/tests

  systemd-analyze:
    # Lane E P11: lint the shipped systemd units.
    #
    # We pin `ubuntu-24.04` (systemd 255) because the shipped VPN unit at
    # `dist/systemd/system/rev-stealth-vpn@.service` uses
    # `LoadCredentialEncrypted=` and the `%d` credential specifier, both of
    # which require systemd >=252. `ubuntu-22.04` (systemd 249) would let
    # the directives parse as unknown and still report success in some
    # cases, masking real breakage. See `docs/deploy/vps.md` for the
    # runtime requirement that mirrors this CI pin.
    #
    # `verify` is run against every `.service` AND `.timer` file we ship so
    # the doctor timer is also covered, not just the services.
    name: systemd-analyze verify
    runs-on: ubuntu-24.04
    timeout-minutes: 25
    steps:
      - uses: actions/checkout@v4
      - name: Confirm systemd >= 252
        run: |
          set -euxo pipefail
          ver="$(systemctl --version | awk 'NR==1{print $2}')"
          echo "host systemd version: $ver"
          if [ "$ver" -lt 252 ]; then
            echo "systemd $ver too old for LoadCredentialEncrypted= / %d" >&2
            exit 1
          fi
      - name: systemd-analyze verify (services + timer)
        run: |
          set -euxo pipefail
          # Collect every unit file we ship under dist/systemd/system/. We
          # globstar both *.service and *.timer so the doctor timer is in
          # scope alongside the services.
          shopt -s nullglob
          units=( dist/systemd/system/*.service dist/systemd/system/*.timer )
          if [ "${#units[@]}" -eq 0 ]; then
            echo "no systemd units found under dist/systemd/system/" >&2
            exit 1
          fi
          echo "verifying: ${units[*]}"
          systemd-analyze verify "${units[@]}"

  headless-auth:
    # Lane E P11: headless authenticated-spider smoke. The real test path
    # needs Chrome + Xvfb on Linux (or macOS), which the basic ubuntu
    # runner can support, but the underlying coverage is gated on harness
    # bits not yet in this lane. We keep the job as a placeholder so the
    # workflow matrix exposes "headless-auth" in the run graph and the
    # follow-up lane can flip `if: false` to enable it without renaming a
    # required check.
    name: headless authenticated smoke (skipped)
    runs-on: ubuntu-22.04
    timeout-minutes: 25
    steps:
      - uses: actions/checkout@v4
      - name: Annotate skip reason
        run: |
          echo "::notice title=headless-auth::skipped; opt-in gated below."
      - name: placeholder (opt-in)
        if: false
        run: |
          echo "headless-auth would run here"

  test-spider-fallback:
    name: E2E e2e_spider_fallback
    needs: build-obscura
    runs-on: ubuntu-22.04
    timeout-minutes: 45
    continue-on-error: true
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
        with:
          shared-key: ubuntu-22.04-stable
          workspaces: |
            . -> target
      - name: Install Chrome (Linux)
        if: runner.os == 'Linux'
        run: |
          wget -qO- https://dl-ssl.google.com/linux/linux_signing_key.pub | sudo gpg --dearmor -o /usr/share/keyrings/google-chrome.gpg
          echo "deb [signed-by=/usr/share/keyrings/google-chrome.gpg] http://dl.google.com/linux/chrome/deb/ stable main" | sudo tee /etc/apt/sources.list.d/google-chrome.list
          sudo apt-get update && sudo apt-get install -y google-chrome-stable
      - name: Download obscura binary
        uses: actions/download-artifact@v4
        with:
          name: obscura-binary
          path: vendor/obscura/target/release/
      - name: chmod +x obscura
        run: chmod +x vendor/obscura/target/release/obscura
      - name: cargo test -- --ignored e2e_spider_fallback
        env:
          REV_SCRAPING_RUN_OBSCURA: "1"
        run: |
          export OBSCURA_BIN="$(pwd)/vendor/obscura/target/release/obscura"
          export REV_STEALTH_OBSCURA="$OBSCURA_BIN"
          cargo test --workspace -- --ignored e2e_spider_fallback
      - name: Upload logs on failure
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: spider-fallback-logs
          path: |
            target/**/*.log
            target/**/*.stderr
          if-no-files-found: ignore

  # =========================================================================
  # Lane I — API stability & semver (v1.3)
  # =========================================================================
  #
  # I.1: cli-public-api snapshot drift gate. Drift = any byte-level diff
  # against `.agent/v1.3/cli-public-api.snapshot.json`. To merge a drifting
  # PR, the contributor must regenerate the snapshot, commit the diff, and
  # apply the `api-additive` (new flag/cmd/env) or `api-breaking` (removed,
  # renamed, semantically changed) PR label.
  cli-public-api-snapshot:
    name: CLI public-API snapshot drift
    runs-on: ubuntu-22.04
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
        with:
          shared-key: ubuntu-22.04-stable
          workspaces: |
            . -> target
      - name: cargo build -p rev-stealth
        run: cargo build -p rev-stealth
      - name: regenerate + check snapshot (label-aware)
        env:
          PR_LABELS_JSON: ${{ toJson(github.event.pull_request.labels) }}
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          # R2 label-aware mode: the script itself stays drift-strict; here we
          # add a label gate so a drift PR must declare additive vs breaking
          # vs mcp-schema-breaking, mirroring cargo-public-api-diff.
          #
          # NOTE: do NOT capture `$?` after an `if ...; then ...; fi` block —
          # bash returns 0 from the un-taken branch, masking the failing exit
          # code. Use `|| drift_rc=$?` to capture the script's real status.
          drift_rc=0
          ./scripts/cli-public-api-snapshot.sh --check || drift_rc=$?
          if [[ "$drift_rc" -eq 0 ]]; then
            echo "[cli-public-api-snapshot] surface unchanged; label check not required."
            exit 0
          fi
          if [[ "${GITHUB_EVENT_NAME:-}" != "pull_request" ]]; then
            exit "$drift_rc"
          fi
          labels_csv="$(printf '%s' "$PR_LABELS_JSON" | python3 -c 'import json,sys; ls=json.load(sys.stdin) or []; print(",".join(l.get("name","") for l in ls))')"
          echo "[cli-public-api-snapshot] PR labels = '${labels_csv:-<none>}'"
          allowed=0
          IFS=',' read -ra arr <<< "$labels_csv"
          for l in "${arr[@]}"; do
            case "$l" in
              api-additive|api-breaking|mcp-schema-breaking) allowed=1 ;;
            esac
          done
          if [[ "$allowed" -eq 1 ]]; then
            echo "::warning::snapshot drift detected but an explicit compat label is set; PR may regenerate the snapshot and merge."
            exit 0
          fi
          echo "::error::CLI public-API snapshot drift requires one of: api-additive, api-breaking, mcp-schema-breaking."
          exit "$drift_rc"

  # I.2: cargo-public-api Rust API diff gate (HARD).
  #
  # R2 hardening (Lane I fix-up): promoted from advisory to hard gate. When the
  # rustdoc-JSON-derived public surface of any covered crate changes against
  # the PR base, the PR MUST carry exactly one of the labels
  # `api-additive` (new pub items) or `api-breaking` (removed/renamed/retyped
  # pub items). The label check runs unconditionally on PR; the diff step then
  # fails closed if a drift exists without the corresponding label.
  #
  # Rationale: the v1.3 R1 advisory mode meant a reviewer could miss a silent
  # `pub` removal. The R2 hard gate forces an explicit ack via PR label and
  # makes the snapshot pipeline (Lane I.1) and Rust pub-API pipeline (I.2)
  # symmetric in enforcement strength.
  cargo-public-api-diff:
    name: cargo-public-api diff (hard gate)
    runs-on: ubuntu-22.04
    timeout-minutes: 30
    # NOTE: continue-on-error intentionally OMITTED — this is now blocking.
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      # cargo-public-api consumes rustdoc JSON, whose schema changes per
      # nightly. Pin the nightly to the date that cargo-public-api 0.39.x is
      # validated against (see
      # https://github.com/cargo-public-api/cargo-public-api/blob/main/scripts/release-helper/src/version_info.rs).
      # Floating `nightly` can break this job between cargo-public-api
      # releases. Re-pin in lockstep when bumping cargo-public-api in v1.4.
      - uses: dtolnay/rust-toolchain@master
        with:
          toolchain: nightly-2024-10-13
      - uses: Swatinem/rust-cache@v2
        with:
          shared-key: ubuntu-22.04-nightly-2024-10-13
          workspaces: |
            . -> target
      - name: install cargo-public-api
        run: cargo install cargo-public-api --locked --version 0.39.0
      - name: fetch base ref
        if: github.event_name == 'pull_request'
        env:
          BASE_REF: ${{ github.event.pull_request.base.ref }}
        run: |
          set -euo pipefail
          git fetch --no-tags --depth=200 origin "$BASE_REF"
      - name: diff against base + enforce label
        if: github.event_name == 'pull_request'
        env:
          BASE_REF: ${{ github.event.pull_request.base.ref }}
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          PR_LABELS_JSON: ${{ toJson(github.event.pull_request.labels) }}
        run: |
          set -euo pipefail
          # cargo-public-api 0.39+ expects a commit range `<base>..<head>`.
          BASE_SHA="$(git rev-parse "origin/$BASE_REF")"
          HEAD_SHA="$(git rev-parse HEAD)"

          # cargo-public-api 0.39.0 returns rc=1 for BOTH "surface diverged
          # under --deny=all" AND "rustdoc/build failure". To distinguish
          # diff-vs-exec-failure we run two passes per crate:
          #
          #   Pass 1: `cargo public-api --package <crate> diff <range>`
          #           — no --deny. rc != 0 ⇒ tool/build/range failure
          #             (a real diff is allowed; the tool only emits the diff
          #              to stdout and exits 0 without --deny).
          #   Pass 2: `cargo public-api --package <crate> diff --deny=all <range>`
          #           — `--deny` MUST come AFTER `diff` (0.39 clap rejects
          #             `--deny` as a top-level option). rc != 0 ⇒ surface
          #             diverged.
          #
          # If pass 1 is healthy and pass 2 is non-zero, we know it is a real
          # diff and the label gate applies. If pass 1 fails, the gate fails
          # closed — labels cannot waive a broken invocation.
          diff_seen=0
          exec_fail=0
          tmpdir="$(mktemp -d)"
          for crate in stealth-core stealth-auth stealth-sanitize \
                       stealth-agent-contracts stealth-parse stealth-mcp; do
            echo "::group::cargo public-api diff -p $crate"

            # Pass 1: smoke run, no --deny. Non-zero ⇒ exec failure.
            smoke_rc=0
            cargo public-api --package "$crate" \
              diff "$BASE_SHA..$HEAD_SHA" \
              > "$tmpdir/${crate}.smoke.out" 2> "$tmpdir/${crate}.smoke.err" \
              || smoke_rc=$?
            cat "$tmpdir/${crate}.smoke.out"
            cat "$tmpdir/${crate}.smoke.err" >&2
            if [[ "$smoke_rc" -ne 0 ]]; then
              echo "::error::cargo public-api -p $crate (pass 1, no --deny) exited rc=$smoke_rc — treating as tool/build failure, NOT a diff. Labels do not waive this."
              exec_fail=1
              echo "::endgroup::"
              continue
            fi

            # Pass 2: deny-all run. Non-zero ⇒ real surface diff.
            deny_rc=0
            cargo public-api --package "$crate" \
              diff --deny=all "$BASE_SHA..$HEAD_SHA" \
              > "$tmpdir/${crate}.deny.out" 2> "$tmpdir/${crate}.deny.err" \
              || deny_rc=$?
            cat "$tmpdir/${crate}.deny.out"
            cat "$tmpdir/${crate}.deny.err" >&2
            if [[ "$deny_rc" -ne 0 ]]; then
              diff_seen=1
            fi

exec
/bin/bash -lc "sed -n '240,620p' scripts/cli-public-api-snapshot.sh" in $REPO_ROOT
