   164	count_field() { echo "$diff_report" | python3 -c "import json,sys; print(len(json.load(sys.stdin).get('$1', [])))"; }
   165	added_count="$(count_field added)"
   166	removed_count="$(count_field removed)"
   167	tightened_count="$(count_field tightened)"
   168	relaxed_count="$(count_field relaxed)"
   169	input_enum_narrowed_count="$(count_field input_enum_narrowed)"
   170	output_prop_removed_count="$(count_field output_prop_removed)"
