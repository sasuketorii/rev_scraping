   261	fi
   262	
   263	if [[ "$added_count" -eq 0 && "$removed_count" -eq 0 \
   264	      && "$tightened_count" -eq 0 && "$relaxed_count" -eq 0 \
   265	      && "$input_enum_narrowed_count" -eq 0 \
   266	      && "$output_prop_removed_count" -eq 0 \
