     1	#!/usr/bin/env bash
     2	# Lane I.5 — MCP tool-schema breaking-change detector.
     3	#
     4	# Drift model: a tool is "in the surface" if it appears in the BASE branch's
     5	# committed snapshot (e.g. main). A removal/rename only becomes invisible if
     6	# the contributor regenerates the snapshot in their PR — so a meaningful
     7	# detector MUST compare the live (PR head) tool list against the BASE
     8	# branch's `.agent/v1.3/cli-public-api.snapshot.json`, not against the
     9	# PR's own (potentially regenerated) copy.
    10	#
    11	# Behavior (R2 contract — 3-valued exit code):
    12	#   - removed-or-renamed tool / tightened required-args ⇒ exit 2 ⇒
    13	#     INTENTIONAL breaking diff ⇒ PR must carry `mcp-schema-breaking`.
    14	#   - added tool ⇒ exit 0 ⇒ PR carries `api-additive`.
    15	#   - unchanged ⇒ exit 0.
    16	#   - any other nonzero ⇒ script execution failure (bash/python/jq/etc.);
    17	#     the CI wrapper MUST NOT honor a label waiver in that case.
    18	#
    19	# Modes:
    20	#   ./scripts/mcp-schema-breaking.sh           # human-readable
    21	#   ./scripts/mcp-schema-breaking.sh --check   # exit-coded for CI
    22	#
    23	# CI usage: the workflow fetches the PR base ref, then invokes this script
    24	# with `BASE_REF=origin/<base>` in the environment. Local invocation defaults
    25	# to comparing against `origin/main` (or `main` when origin is absent).
    26	
    27	set -euo pipefail
    28	
    29	# Repo-root resolution. Default: this script's parent directory (the
    30	# rev_scraping checkout that ships it). Override via
    31	# MCP_SCHEMA_BREAKING_REPO_ROOT for fixture / dry-run scenarios where the
    32	# caller wants to point the detector at a synthetic snapshot tree (see
    33	# scripts/cli-public-api-snapshot.test.sh).
    34	REPO_ROOT="${MCP_SCHEMA_BREAKING_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
    35	cd "$REPO_ROOT"
    36	
    37	SNAPSHOT_PATH=".agent/v1.3/cli-public-api.snapshot.json"
    38	BASE_REF="${BASE_REF:-origin/main}"
    39	
    40	# Resolve the base-branch snapshot. If the base ref is unavailable (fresh
    41	# fork checkout, first commit on a branch), fall back to local HEAD~1; this
    42	# still catches "remove a tool in a single PR" within a feature branch's
    43	# own history. If even that fails, exit 0 with an info note.
    44	resolve_base_snapshot() {
    45	  local ref="$1"
    46	  if git show "$ref:$SNAPSHOT_PATH" >/dev/null 2>&1; then
    47	    git show "$ref:$SNAPSHOT_PATH"
    48	    return 0
    49	  fi
    50	  return 1
    51	}
    52	
    53	base_blob=""
    54	if resolved=$(resolve_base_snapshot "$BASE_REF" 2>/dev/null); then
    55	  base_blob="$resolved"
    56	elif resolved=$(resolve_base_snapshot "HEAD~1" 2>/dev/null); then
    57	  base_blob="$resolved"
    58	  echo "[mcp-schema-breaking] note: base ref $BASE_REF unreachable; using HEAD~1" >&2
    59	else
    60	  echo "[mcp-schema-breaking] note: no base snapshot reachable; skipping diff (first PR introducing the snapshot, or shallow checkout)." >&2
    61	  if [[ "${1:-}" == "--check" ]]; then
    62	    exit 0
    63	  fi
    64	  exit 0
    65	fi
    66	
    67	# Compare via the live (PR head) snapshot. R2 widens the diff to cover four
    68	# breaking-change kinds:
    69	#   1. tool removal/rename
    70	#   2. tightened required-args (was optional, now required)
    71	#   3. input-schema enum NARROWING (a previously-accepted value vanishes)
    72	#   4. output-schema property removal (a documented response field vanishes,
    73	#      so existing callers that read it will break) AND output enum narrowing
    74	# Plus the additive/relaxed signals for advisory output. Snapshot
    75	# `$schema_version` >= 3 carries the input_enums/output blocks; we fall back
    76	# to the v2-compatible name+required diff when the base snapshot predates v3.
    77	
    78	live_blob="$(cat "$SNAPSHOT_PATH")"
    79	
    80	diff_report="$(python3 - "$base_blob" "$live_blob" <<'PY'
    81	import json, sys
    82	
    83	base = json.loads(sys.argv[1])
    84	live = json.loads(sys.argv[2])
    85	
    86	base_tools = set(base["mcp_tools"]["names"])
    87	live_tools = set(live["mcp_tools"]["names"])
    88	added = sorted(live_tools - base_tools)
    89	removed = sorted(base_tools - live_tools)
    90	
    91	base_schemas = base.get("mcp_tools", {}).get("schemas", {})
    92	live_schemas = live.get("mcp_tools", {}).get("schemas", {})
    93	tightened = []          # list of [tool, newly-required-arg]
    94	relaxed = []            # list of [tool, removed-required-arg]
    95	input_enum_narrowed = [] # [tool, prop, removed_value]
    96	output_prop_removed = []  # [tool, removed_property]
    97	output_enum_narrowed = []  # [tool, path, removed_value]
    98	
    99	def _required(schemas, tool):
   100	    return set(schemas.get(tool, {}).get("required", []) or [])
   101	
   102	def _input_enums(schemas, tool):
   103	    return schemas.get(tool, {}).get("input_enums", {}) or {}
   104	
   105	def _output(schemas, tool):
   106	    return schemas.get(tool, {}).get("output", {}) or {}
   107	
   108	base_schema_version = base.get("$schema_version", 1)
   109	live_schema_version = live.get("$schema_version", 1)
   110	schema_v3 = base_schema_version >= 3 and live_schema_version >= 3
   111	
   112	for tool in sorted(live_tools & base_tools):
   113	    base_req = _required(base_schemas, tool)
   114	    live_req = _required(live_schemas, tool)
   115	    for arg in sorted(live_req - base_req):
   116	        tightened.append([tool, arg])
   117	    for arg in sorted(base_req - live_req):
   118	        relaxed.append([tool, arg])
   119	
   120	    if schema_v3:
   121	        # Input enum narrowing: a value present in BASE but absent in LIVE
   122	        # ⇒ a caller that previously sent that value will now be rejected.
   123	        b_in = _input_enums(base_schemas, tool)
   124	        l_in = _input_enums(live_schemas, tool)
   125	        for prop in sorted(set(b_in) & set(l_in)):
   126	            bvals = set(b_in[prop] or [])
   127	            lvals = set(l_in[prop] or [])
   128	            for v in sorted(bvals - lvals):
   129	                input_enum_narrowed.append([tool, prop, v])
   130	
   131	        # Output property removal: a documented response field disappears.
   132	        b_out = _output(base_schemas, tool)
   133	        l_out = _output(live_schemas, tool)
   134	        b_props = set(b_out.get("properties", []) or [])
   135	        l_props = set(l_out.get("properties", []) or [])
   136	        for prop in sorted(b_props - l_props):
   137	            output_prop_removed.append([tool, prop])
   138	
   139	        # Output enum narrowing: a value previously emitted may now be
   140	        # impossible, but callers built `if x in {…}` against the old set
   141	        # will silently miss the now-removed branch. We treat this as
   142	        # breaking conservatively.
   143	        b_oe = b_out.get("enums", {}) or {}
   144	        l_oe = l_out.get("enums", {}) or {}
   145	        for path in sorted(set(b_oe) & set(l_oe)):
   146	            bvals = set(b_oe[path] or [])
   147	            lvals = set(l_oe[path] or [])
   148	            for v in sorted(bvals - lvals):
   149	                output_enum_narrowed.append([tool, path, v])
   150	
   151	print(json.dumps({
   152	    "added": added,
   153	    "removed": removed,
   154	    "tightened": tightened,
   155	    "relaxed": relaxed,
   156	    "input_enum_narrowed": input_enum_narrowed,
   157	    "output_prop_removed": output_prop_removed,
   158	    "output_enum_narrowed": output_enum_narrowed,
   159	    "schema_v3": schema_v3,
   160	}))
   161	PY
   162	)"
