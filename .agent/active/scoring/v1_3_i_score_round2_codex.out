   456	  # I.1: cli-public-api snapshot drift gate. Drift = any byte-level diff
   457	  # against `.agent/v1.3/cli-public-api.snapshot.json`. To merge a drifting
   458	  # PR, the contributor must regenerate the snapshot, commit the diff, and
   459	  # apply the `api-additive` (new flag/cmd/env) or `api-breaking` (removed,
   460	  # renamed, semantically changed) PR label.
   461	  cli-public-api-snapshot:
   462	    name: CLI public-API snapshot drift
   463	    runs-on: ubuntu-22.04
   464	    timeout-minutes: 20
   465	    steps:
   466	      - uses: actions/checkout@v4
   467	        with:
   468	          fetch-depth: 0
   469	      - uses: dtolnay/rust-toolchain@stable
   470	      - uses: Swatinem/rust-cache@v2
   471	        with:
   472	          shared-key: ubuntu-22.04-stable
   473	          workspaces: |
   474	            . -> target
   475	      - name: cargo build -p rev-stealth
   476	        run: cargo build -p rev-stealth
   477	      - name: regenerate + check snapshot (label-aware)
   478	        env:
   479	          PR_LABELS_JSON: ${{ toJson(github.event.pull_request.labels) }}
   480	          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
   481	        run: |
   482	          set -euo pipefail
   483	          # R2 label-aware mode: the script itself stays drift-strict; here we
   484	          # add a label gate so a drift PR must declare additive vs breaking
   485	          # vs mcp-schema-breaking, mirroring cargo-public-api-diff.
   486	          #
   487	          # NOTE: do NOT capture `$?` after an `if ...; then ...; fi` block —
   488	          # bash returns 0 from the un-taken branch, masking the failing exit
   489	          # code. Use `|| drift_rc=$?` to capture the script's real status.
   490	          drift_rc=0
   491	          ./scripts/cli-public-api-snapshot.sh --check || drift_rc=$?
   492	          if [[ "$drift_rc" -eq 0 ]]; then
   493	            echo "[cli-public-api-snapshot] surface unchanged; label check not required."
   494	            exit 0
   495	          fi
   496	          if [[ "${GITHUB_EVENT_NAME:-}" != "pull_request" ]]; then
   497	            exit "$drift_rc"
   498	          fi
   499	          labels_csv="$(printf '%s' "$PR_LABELS_JSON" | python3 -c 'import json,sys; ls=json.load(sys.stdin) or []; print(",".join(l.get("name","") for l in ls))')"
   500	          echo "[cli-public-api-snapshot] PR labels = '${labels_csv:-<none>}'"
   501	          allowed=0
   502	          IFS=',' read -ra arr <<< "$labels_csv"
   503	          for l in "${arr[@]}"; do
   504	            case "$l" in
   505	              api-additive|api-breaking|mcp-schema-breaking) allowed=1 ;;
   506	            esac
   507	          done
   508	          if [[ "$allowed" -eq 1 ]]; then
   509	            echo "::warning::snapshot drift detected but an explicit compat label is set; PR may regenerate the snapshot and merge."
   510	            exit 0
   511	          fi
   512	          echo "::error::CLI public-API snapshot drift requires one of: api-additive, api-breaking, mcp-schema-breaking."
   513	          exit "$drift_rc"
   514	
   515	  # I.2: cargo-public-api Rust API diff gate (HARD).
   516	  #
   528	  cargo-public-api-diff:
   529	    name: cargo-public-api diff (hard gate)
   530	    runs-on: ubuntu-22.04
   531	    timeout-minutes: 30
   532	    # NOTE: continue-on-error intentionally OMITTED — this is now blocking.
   533	    steps:
   534	      - uses: actions/checkout@v4
   535	        with:
   536	          fetch-depth: 0
   537	      # cargo-public-api consumes rustdoc JSON, whose schema changes per
   538	      # nightly. Pin the nightly to the date that cargo-public-api 0.39.x is
   539	      # validated against (see
   540	      # https://github.com/cargo-public-api/cargo-public-api/blob/main/scripts/release-helper/src/version_info.rs).
   541	      # Floating `nightly` can break this job between cargo-public-api
   542	      # releases. Re-pin in lockstep when bumping cargo-public-api in v1.4.
   543	      - uses: dtolnay/rust-toolchain@master
   544	        with:
   545	          toolchain: nightly-2024-10-13
   546	      - uses: Swatinem/rust-cache@v2
   547	        with:
   548	          shared-key: ubuntu-22.04-nightly-2024-10-13
   549	          workspaces: |
   550	            . -> target
   551	      - name: install cargo-public-api
   552	        run: cargo install cargo-public-api --locked --version 0.39.0
   553	      - name: fetch base ref
   554	        if: github.event_name == 'pull_request'
   555	        env:
   556	          BASE_REF: ${{ github.event.pull_request.base.ref }}
   557	        run: |
   558	          set -euo pipefail
   559	          git fetch --no-tags --depth=200 origin "$BASE_REF"
   560	      - name: diff against base + enforce label
   561	        if: github.event_name == 'pull_request'
   562	        env:
   563	          BASE_REF: ${{ github.event.pull_request.base.ref }}
   564	          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
   565	          PR_LABELS_JSON: ${{ toJson(github.event.pull_request.labels) }}
   566	        run: |
   567	          set -euo pipefail
   568	          # cargo-public-api 0.39+ expects a commit range `<base>..<head>`.
   569	          BASE_SHA="$(git rev-parse "origin/$BASE_REF")"
   570	          HEAD_SHA="$(git rev-parse HEAD)"
   571	
   572	          # cargo-public-api 0.39.0 returns rc=1 for BOTH "surface diverged
   573	          # under --deny=all" AND "rustdoc/build failure". To distinguish
   574	          # diff-vs-exec-failure we run two passes per crate:
   575	          #
   576	          #   Pass 1: `cargo public-api --package <crate> diff <range>`
   577	          #           — no --deny. rc != 0 ⇒ tool/build/range failure
   578	          #             (a real diff is allowed; the tool only emits the diff
   579	          #              to stdout and exits 0 without --deny).
   580	          #   Pass 2: `cargo public-api --package <crate> diff --deny=all <range>`
   581	          #           — `--deny` MUST come AFTER `diff` (0.39 clap rejects
   582	          #             `--deny` as a top-level option). rc != 0 ⇒ surface
   583	          #             diverged.
   584	          #
   585	          # If pass 1 is healthy and pass 2 is non-zero, we know it is a real
   586	          # diff and the label gate applies. If pass 1 fails, the gate fails
   587	          # closed — labels cannot waive a broken invocation.
   588	          diff_seen=0
   589	          exec_fail=0
