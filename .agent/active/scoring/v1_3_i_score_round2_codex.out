  # I.5: MCP tool-schema breaking-change detector. Mirrors mcp-schema-lint
  # but specifically asserts the canonical 16-tool list (Lane I.1 snapshot)
  # has not been mutated. Drift requires `mcp-schema-breaking` PR label.
  mcp-schema-breaking-detector:
    name: MCP tool schema breaking-change
    runs-on: ubuntu-22.04
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
        with:
          shared-key: ubuntu-22.04-stable
          workspaces: |
            . -> target
      - name: gen_reference freshness
        run: cargo run -q -p stealth-mcp --bin gen_reference -- --check
      - name: fetch base ref
        if: github.event_name == 'pull_request'
        env:
          BASE_REF: ${{ github.event.pull_request.base.ref }}
        run: git fetch --no-tags --depth=200 origin "$BASE_REF"
      - name: mcp-schema-breaking diff vs base (label-aware)
        env:
          BASE_REF: origin/${{ github.event.pull_request.base.ref || 'main' }}
          PR_LABELS_JSON: ${{ toJson(github.event.pull_request.labels) }}
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          # R2 label gate. The script uses a 3-valued exit-code contract:
          #   0 — surface unchanged
          #   2 — INTENTIONAL breaking diff (label waiver applies)
          #   any other nonzero — script execution failure (NEVER waiveable)
          # `$?` after `if/fi` returns 0 from the un-taken branch (bash spec);
          # capture via `|| rc=$?` instead so the real exit code survives.
          rc=0
          ./scripts/mcp-schema-breaking.sh --check || rc=$?
          if [[ "$rc" -eq 0 ]]; then
            exit 0
          fi
          if [[ "$rc" -ne 2 ]]; then
            echo "::error::mcp-schema-breaking.sh exited rc=$rc (script execution failure, not a breaking diff). Labels do not waive this. Fix the underlying error."
            exit "$rc"
          fi
          if [[ "${GITHUB_EVENT_NAME:-}" != "pull_request" ]]; then
            exit "$rc"
          fi
          labels_csv="$(printf '%s' "$PR_LABELS_JSON" | python3 -c 'import json,sys; ls=json.load(sys.stdin) or []; print(",".join(l.get("name","") for l in ls))')"
          echo "[mcp-schema-breaking] PR labels = '${labels_csv:-<none>}'"
          has_breaking=0
          IFS=',' read -ra arr <<< "$labels_csv"
          for l in "${arr[@]}"; do
            [[ "$l" == "mcp-schema-breaking" ]] && has_breaking=1
          done
          if [[ "$has_breaking" -eq 1 ]]; then
            echo "::warning::MCP schema breaking change detected and explicit \`mcp-schema-breaking\` label is set; gate PASS."
            exit 0
          fi
          echo "::error::MCP tool-schema breaking change requires the \`mcp-schema-breaking\` PR label (and a 2-major bump per docs/compat.md)."
          exit "$rc"

  # I.6: see crates/stealth-cli/tests/deprecated_completeness.rs (unit test).

  # Lane G.3 (v1.3 Black-Belt CLI): shell-completion drift gate.
  #
  # Regenerates `target/completions/{bash,zsh,fish,nushell}/rev-stealth.*` via
  # `scripts/gen_completions.sh` and fails if the committed scripts disagree
  # with a fresh render. The script invokes the hidden
  # `rev-stealth completions <shell>` subcommand, which reads the clap
  # CommandFactory tree — so the gate also covers --help drift in
  # subcommands/flags reachable from completion.
  completion-drift:
    name: shell-completion drift
    runs-on: ubuntu-22.04
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
        with:
          shared-key: ubuntu-22.04-stable
          workspaces: |
            . -> target
      - name: assert all 4 completion files are tracked
        # Round-1 reviewer (G.3) finding #1: `git diff --exit-code` alone
        # ignores untracked files, so a contributor could accidentally delete
        # the committed completions and the gate would still pass after regen.
        # Enumerate the 4 expected files and require each to be tracked BEFORE
        # we regenerate.
        run: |
          set -euo pipefail
          missing=0
          for f in \
              target/completions/bash/rev-stealth.bash \
              target/completions/zsh/rev-stealth.zsh \
              target/completions/fish/rev-stealth.fish \
              target/completions/nushell/rev-stealth.nu; do
            if ! git ls-files --error-unmatch -- "$f" >/dev/null 2>&1; then
              echo "::error::expected completion file is not tracked: $f" >&2
              missing=1
            fi
          done
          if [[ "$missing" -eq 1 ]]; then
            echo "::error::commit the missing target/completions/ files (regen via ./scripts/gen_completions.sh)." >&2
            exit 1
          fi
      - name: regenerate completions
        run: ./scripts/gen_completions.sh
      - name: diff committed vs regenerated (modifications)
        run: |
          set -euo pipefail
          if ! git diff --exit-code -- target/completions/; then
            echo "::error::shell completion scripts drifted (modified content). Run \`./scripts/gen_completions.sh\` and commit the result." >&2
            exit 1
          fi
      - name: diff committed vs regenerated (untracked / additions)
        # Defensive sibling to the previous step: `git diff --exit-code` does
        # not flag untracked files, so a regen producing a *new* file (e.g.
        # add a future shell) would silently pass the diff above. `git status
        # --porcelain` lists tracked-modified AND untracked entries; we fail
        # if anything under target/completions/ is reported.
        run: |
          set -euo pipefail
          drift="$(git status --porcelain -- target/completions/)"
          if [[ -n "$drift" ]]; then
            echo "::error::untracked / unexpected completion files detected:" >&2
            echo "$drift" >&2
            echo "::error::commit them via ./scripts/gen_completions.sh + git add." >&2
            exit 1
          fi

  # I.8 (R2): fixture tests for scripts/mcp-schema-breaking.sh. Asserts the
  # 3-valued exit-code contract (0/2/other) and the four breaking-change
  # detectors (tool removal, required-arg tightening, input enum narrowing,
  # output property removal / output enum narrowing) against synthetic
  # schema_version=3 snapshot blobs. Catches regressions in the detector
  # itself before they let a real breaking PR through.
  mcp-schema-breaking-fixture-tests:
    name: MCP schema breaking detector — fixture tests
    runs-on: ubuntu-22.04
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@v4
      - name: run fixture tests
        run: bash scripts/cli-public-api-snapshot.test.sh

  # I.7 (R2): keep-a-changelog 1.1 structural lint for
  # CHANGELOG.rev_scraping.md. Mirrors the release-please-config.json
  # `changelog-path` setting and gates the `## [Unreleased]` cursor that
  # release-please relies on to compute the next bump. A malformed file
  # would fail release-please at release time instead of at PR time, so
  # we shift the check left.
  changelog-lint:
    name: CHANGELOG keep-a-changelog lint
    runs-on: ubuntu-22.04
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@v4
      - name: changelog structural lint
        run: python3 scripts/changelog-keepachangelog-lint.py CHANGELOG.rev_scraping.md

