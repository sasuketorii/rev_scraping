   268	  live_count="$(python3 -c "import json; print(len(json.load(open('$SNAPSHOT_PATH'))['mcp_tools']['names']))")"
   269	  schema_v3="$(echo "$diff_report" | python3 -c "import json,sys; print(json.load(sys.stdin).get('schema_v3', False))")"
