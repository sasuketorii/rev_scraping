import json
p='.agent/v1.3/cli-public-api.snapshot.json'
d=json.load(open(p))
print('schema', d.get('"'$schema_version'"'))
print('mcp count', d.get('mcp_tools',{}).get('count'), len(d.get('mcp_tools',{}).get('names',[])))
print('error count', d.get('error_kinds',{}).get('count'), len(d.get('error_kinds',{}).get('variants',[])))
print('deprecated attrs', len(d.get('deprecated_attrs',[])))
# validate schemas have expected keys and summarize missing outputs/enums
schemas=d.get('mcp_tools',{}).get('schemas',{})
missing=[]
empty_outputs=[]
for name in d.get('mcp_tools',{}).get('names',[]):
    s=schemas.get(name,{})
    for k in ('required','input_enums','output'):
        if k not in s: missing.append((name,k))
    out=s.get('output',{})
    if not out.get('properties') and not out.get('enums') and not out.get('required'):
        empty_outputs.append(name)
print('schema entries', len(schemas), 'missing', missing[:10], 'empty_output_count', len(empty_outputs))
print('empty_outputs', ','.join(empty_outputs[:20]))
# first few error kinds
print('error sample', d.get('error_kinds',{}).get('variants',[])[:5])
PY" in $REPO_ROOT
