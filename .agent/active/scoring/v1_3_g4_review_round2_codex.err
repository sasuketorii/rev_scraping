  1701	/// Render a `ValidationReport` to a string that lists ONLY the structural
  1702	/// fingerprints (`code` + `path`), never the raw `message` body — toml
  1703	/// diagnostics can quote the offending source line, which would leak any
  1704	/// secret the operator just tried to set. Use this on every user-facing
  1705	/// surface of set / edit / migrate.
  1706	fn render_redacted_report(report: &ValidationReport) -> String {
  1707	    if report.errors.is_empty() {
  1708	        return "ok".to_string();
  1709	    }
  1710	    report
  1711	        .errors
  1712	        .iter()
  1713	        .map(|i| format!("[{:?}] @ {}", i.code, i.path))
  1714	        .collect::<Vec<_>>()
  1715	        .join("; ")
  1716	}
