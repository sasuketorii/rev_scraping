   363	#[allow(clippy::too_many_arguments)]
   364	fn spawn_rev_auth_login(
   365	    format: OutputFormat,
   366	    op: &str,
   367	    profile: &str,
   368	    url: &str,
   369	    domain: &str,
   370	    completion_pattern: Option<&str>,
   371	    obscura_bin: Option<&std::path::Path>,
   372	    rev_auth_bin: Option<&std::path::Path>,
   373	    aad_context: &str,
   374	) -> i32 {
   375	    let helper = match rev_auth_bin
   376	        .map(std::path::Path::to_path_buf)
   377	        .or_else(|| find_in_path("rev-auth"))
   378	    {
   379	        Some(p) => p,
   380	        None => {
   381	            emit_err(
   382	                format,
   383	                op,
   384	                EXIT_PERMANENT,
   385	                "rev-auth binary not found in PATH (use --rev-auth-bin)",
   386	            );
   387	            return EXIT_PERMANENT;
   388	        }
   389	    };
   390	    let mut cmd = ProcessCommand::new(&helper);
   391	    cmd.arg("login")
   392	        .arg("--profile")
   393	        .arg(profile)
   394	        .arg("--url")
   395	        .arg(url)
   396	        .arg("--domain")
   397	        .arg(domain)
   398	        .arg("--aad-context")
   399	        .arg(aad_context);
   400	    if let Some(p) = completion_pattern {
   401	        cmd.arg("--completion-pattern").arg(p);
   402	    }
   403	    if let Some(p) = obscura_bin {
   404	        cmd.arg("--obscura-bin").arg(p);
   405	    }
   406	    // stdin/stdout/stderr inherited — rev-auth prints its own JSON on success.
   407	    match cmd.status() {
