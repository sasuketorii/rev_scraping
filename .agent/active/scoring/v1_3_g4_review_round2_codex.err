   322	/// v1.1.0 (P16): extended doctor diagnostic result.
   323	#[derive(Serialize, Debug, Clone)]
   324	pub struct DeepReport {
   325	    pub obscura_binary: DeepCheck,
   326	    pub vpn_pool_instances: DeepCheck,
   327	    pub sites_recipes: DeepCheck,
   328	    pub auth_profiles: DeepCheck,
   329	    pub auth_key_source: DeepCheck,
   330	}
   331	
   332	/// One row of the deep report. `status` is one of "pass" / "warn" / "fail".
   333	#[derive(Serialize, Debug, Clone)]
   334	pub struct DeepCheck {
   335	    pub name: String,
   336	    pub status: DeepStatus,
   337	    pub detail: String,
   338	}
   339	
   340	#[derive(Serialize, Debug, Clone, Copy, PartialEq, Eq)]
   341	#[serde(rename_all = "lowercase")]
   342	pub enum DeepStatus {
   343	    Pass,
   344	    Warn,
   345	    Fail,
   346	}
   347	
   348	impl DeepReport {
   349	    pub fn has_fail(&self) -> bool {
   350	        [
   351	            &self.obscura_binary,
   352	            &self.vpn_pool_instances,
   353	            &self.sites_recipes,
   354	            &self.auth_profiles,
   355	            &self.auth_key_source,
   356	        ]
   357	        .iter()
   358	        .any(|c| c.status == DeepStatus::Fail)
   359	    }
   360	
   361	    #[allow(dead_code)]
   362	    pub fn has_warn(&self) -> bool {
   363	        [
   364	            &self.obscura_binary,
   365	            &self.vpn_pool_instances,
   366	            &self.sites_recipes,
   367	            &self.auth_profiles,
   368	            &self.auth_key_source,
   369	        ]
   370	        .iter()
   371	        .any(|c| c.status == DeepStatus::Warn)
   372	    }
   373	}
   374	
   375	async fn run_deep_diagnostics() -> DeepReport {
   376	    DeepReport {
   377	        obscura_binary: check_obscura_binary(),
   378	        vpn_pool_instances: check_vpn_pool().await,
   379	        sites_recipes: check_sites_recipes(),
   380	        auth_profiles: check_auth_profiles(),
   381	        auth_key_source: check_auth_key_source(),
   382	    }

