   115	
   116	/// Local-only, deterministic fingerprint heuristics. Does not perform any
   117	/// network I/O. Returns a JSON object that the caller embeds under
   118	/// `local`.
   119	pub(crate) fn build_local_measurement(url: &url::Url, ua: &str) -> serde_json::Value {
   120	    let scheme = url.scheme();
   121	    let host = url.host_str().unwrap_or("");
   122	    let sec_ch_ua_valid = validate_sec_ch_ua(ua);
   123	    // Trivial deterministic "bot score": higher when the UA looks like an
   124	    // automation placeholder or the URL targets plain http.
   125	    let mut bot_score: u8 = 0;
   126	    if ua.to_ascii_lowercase().contains("headless") || ua.to_ascii_lowercase().contains("bot") {
   127	        bot_score = bot_score.saturating_add(60);
   128	    }
   129	    if scheme != "https" {
   130	        bot_score = bot_score.saturating_add(20);
   131	    }
   132	    if !sec_ch_ua_valid {
   133	        bot_score = bot_score.saturating_add(20);
   134	    }
   135	    json!({
   136	        "scheme": scheme,
   137	        "host": host,
   138	        "sec_ch_ua_valid": sec_ch_ua_valid,
   139	        "ja4_placeholder": synthetic_ja4(ua),
   140	        "bot_score": bot_score,
   141	    })
   142	}
   143	
   144	fn validate_sec_ch_ua(ua: &str) -> bool {
   145	    // Very small heuristic: a "valid" UA contains a slash-version and at
   146	    // least one parenthesised platform descriptor. Used as a smoke
   147	    // signal, not a full parser.
   148	    ua.contains('/') && ua.contains('(')
   149	}
   150	
   151	fn synthetic_ja4(ua: &str) -> String {
   152	    // Deterministic 8-char checksum-style stub so callers can diff across
   153	    // runs without us shipping an actual JA4 implementation. Real JA4
   154	    // requires a live TLS handshake (deferred to --enable-external).
   155	    let mut h: u32 = 5381;
   156	    for b in ua.bytes() {
   157	        h = h.wrapping_mul(33).wrapping_add(b as u32);
   158	    }
   159	    format!("ja4-stub-{h:08x}")
   160	}
   161	
   162	fn emit_ok(format: OutputFormat, op: &str, payload: serde_json::Value) {
   163	    match format {
   164	        OutputFormat::Json => {
   165	            println!(
   166	                "{}",
   167	                json!({ "ok": true, "operation": op, "result": payload })
   168	            );
   169	        }
   170	        OutputFormat::Human => {
   171	            println!("[OK] {op}");
   172	            if let Ok(s) = serde_json::to_string_pretty(&payload) {
   173	                println!("{s}");
   174	            }
   175	        }
   176	    }
   177	}
   178	
   179	fn emit_err(format: OutputFormat, op: &str, exit: i32, msg: &str) {
   180	    match format {
   181	        OutputFormat::Json => {
   182	            println!(
   183	                "{}",
   184	                json!({
   185	                    "ok": false,
   186	                    "operation": op,
   187	                    "exit_code": exit,
   188	                    "error": msg,
   189	                })
   190	            );

