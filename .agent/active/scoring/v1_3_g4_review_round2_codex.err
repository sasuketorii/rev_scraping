   565	fn map_store_error(error: &AuthStoreError) -> (i32, String) {
   566	    match error {
   567	        AuthStoreError::NotFound(p) => (EXIT_AUTH_EXPIRED, format!("profile not found: {p}")),
   568	        AuthStoreError::BadKeyOrTamper => (EXIT_LEAK, error.to_string()),
   569	        AuthStoreError::ProfileHashMismatch => (EXIT_LEAK, error.to_string()),
   570	        AuthStoreError::KeyringUnavailable(_) => (EXIT_PERMANENT, error.to_string()),
   571	        AuthStoreError::Io(_) => (EXIT_PERMANENT, error.to_string()),
   572	        AuthStoreError::Serde(_) => (EXIT_PERMANENT, error.to_string()),
   573	        AuthStoreError::Crypto(_) => (EXIT_PERMANENT, error.to_string()),
   574	    }
   575	}
