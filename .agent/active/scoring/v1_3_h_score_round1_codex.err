# SPDX-License-Identifier: MIT
#
# `rev-stealth-cli` is the crates.io publish front for the rev-stealth CLI.
# It exists so `cargo install rev-stealth-cli` works for end users, while the
# internal workspace member `stealth-cli` stays `publish = false` (avoids
# rename churn across ~13 workspace.dependencies references).
#
# Lane H (v1.3) plumbing-only:
#   - This crate ships a placeholder `main.rs` so `cargo publish --dry-run`
#     validates the manifest metadata (name, license, description, repo, etc.).
#   - Wiring to the real CLI entrypoint (a `stealth_cli::run()` lib target on
#     the internal crate, OR a release-time codegen step) is deferred to the
#     v1.3.0 release cut. At that point `stealth-cli` will expose a public
#     `run()` and this wrapper will become a one-line shim. See
#     `.agent/active/v1_3_uplift_execplan_rev1.md` Lane H for context.
#
# Binary name remains `rev-stealth` (matches Homebrew formula, deb/rpm
# install path `/usr/local/bin/rev-stealth`, and Docker `CMD`).

[package]
name = "rev-stealth-cli"
version.workspace = true
edition.workspace = true
rust-version.workspace = true
license.workspace = true
authors.workspace = true
description = "rev-stealth — stealth web scraping & MCP CLI for AI agent developers (Claude Code / Cursor / Hermes). Thin publish wrapper for `cargo install rev-stealth-cli`."
repository = "https://github.com/sasuketorii/rev_scraping"
homepage = "https://github.com/sasuketorii/rev_scraping"
documentation = "https://sasuketorii.github.io/rev_scraping/"
readme = "README.md"
keywords = ["scraping", "stealth", "mcp", "cli", "agent"]
categories = ["command-line-utilities", "web-programming"]
publish = true

[[bin]]
# Lane H plumbing-only: stub binary name is intentionally distinct from
# the real workspace `rev-stealth` (owned by `stealth-cli`) to avoid a
# `cargo build --workspace` output-filename collision. At the v1.3.0
# release cut, this entry will be renamed to `rev-stealth` once
# `stealth-cli`'s bin is moved behind a lib target.
name = "rev-stealth-cli-stub"
path = "src/main.rs"

[dependencies]
# Lane H plumbing-only: no internal workspace deps yet (would break
# `cargo publish --dry-run` because `stealth-cli` is `publish = false`).
# Real entrypoint wiring happens at v1.3.0 release cut.

[lints]
workspace = true

# -----------------------------------------------------------------------------
# H.2 — cargo-deb metadata (Debian 12 / Ubuntu 22.04 + 24.04)
# -----------------------------------------------------------------------------
# Build with: `cargo deb -p rev-stealth-cli --no-build`
#   (release.yml runs `cargo build --release --bin rev-stealth` first, then
#    `cargo deb --no-build` to avoid double-compilation across the matrix.)
#
# `--no-build` requires the binary at `target/release/rev-stealth`; the wrapper
# crate's own placeholder binary is overridden at release time when this
# wrapper is wired to the internal `stealth-cli` entrypoint.
[package.metadata.deb]
name = "rev-stealth"
maintainer = "Sasuke Torii <security-alert.reproduce897@passmail.com>"
copyright = "2026, Sasuke Torii <security-alert.reproduce897@passmail.com>"
license-file = ["../../LICENSE", "4"]
extended-description = """\
rev-stealth is a stealth web scraping and Model Context Protocol (MCP) \
command-line tool designed for AI agent developers (Claude Code, Cursor, \
Hermes). It provides captcha bypass, browser fingerprint control, VPN \
rotation, content sanitization, and an MCP server in a single binary."""
section = "utils"
priority = "optional"
# Distribution-specific runtime deps are intentionally lean. Chromium is
# *not* a hard dep: see Formula caveats. dpkg `Depends:` uses libc6 only;
# the binary is otherwise statically linked via musl in CI (release.yml).
depends = "libc6 (>= 2.31)"
assets = [
    # [source, target, perms]
    ["../../target/release/rev-stealth", "usr/bin/", "755"],
    ["../../README.md", "usr/share/doc/rev-stealth/README", "644"],
    ["../../LICENSE", "usr/share/doc/rev-stealth/LICENSE", "644"],
]
# Shell completions + man pages are wired at release time by the
# `cargo xtask manpages` step in release.yml (Lane G G.3 + G.8).

# -----------------------------------------------------------------------------
# H.3 — cargo-generate-rpm metadata (RHEL 9 / Fedora 41)
# -----------------------------------------------------------------------------
# Build with: `cargo generate-rpm -p rev-stealth-cli`
#   (also expects `target/release/rev-stealth` pre-built.)
[package.metadata.generate-rpm]
name = "rev-stealth"
license = "MIT"
summary = "Stealth web scraping & MCP CLI for AI agent developers"
# Lean runtime deps; glibc only.
requires = { glibc = ">= 2.34" }
assets = [
    { source = "../../target/release/rev-stealth", dest = "/usr/bin/rev-stealth", mode = "755" },
    { source = "../../README.md", dest = "/usr/share/doc/rev-stealth/README", mode = "644", doc = true },
    { source = "../../LICENSE", dest = "/usr/share/doc/rev-stealth/LICENSE", mode = "644", doc = true },
]

