{
  "diff": "--- a/$REPO_ROOT/crates/stealth-cli/../../templates/policy.toml\n+++ b//tmp/rev-config-diff.3lqz8t\n@@ -1,171 +1,1 @@\n-# SPDX-License-Identifier: MIT\n+schema_version = 1\n-# Source: extended for rev_scraping v1.0.0 (Phase 8 — per-site proxy routing)\n-#\n-# rev_scraping policy file.\n-#\n-# Copy to ~/.rev_scraping/policy.toml and tighten the permissions:\n-#\n-#   mkdir -p ~/.rev_scraping\n-#   cp templates/policy.toml ~/.rev_scraping/policy.toml\n-#   chmod 600 ~/.rev_scraping/policy.toml\n-#\n-# Override precedence (highest first):\n-#   1. REV_SCRAPING_REQUIRE_VPN=1 env var (cannot be loosened)\n-#   2. --require-vpn CLI flag\n-#   3. --allow-no-vpn CLI flag (rejected when env=1)\n-#   4. policy.toml::require_vpn\n-#   5. Built-in default = true (fail-closed)\n-\n-# Default: require VPN for all fetcher commands (spider / cf-evaluate /\n-# relocate --url). Fail-closed.\n-require_vpn = true\n-\n-# Block fetch if the VPN exit IP is NOT in this country. Either an\n-# ISO-2 alpha code (\"JP\") or the long form (\"Japan\") works on either\n-# side — `leak_guard::country_matches` accepts both forms via a small\n-# alias table (Japan↔JP, United States↔US) plus case-insensitive\n-# equality for everything else. Comment out to skip the country check.\n-vpn_required_country = \"Japan\"\n-\n-# Multi-instance Gluetun pool. Each entry: container name + host-side\n-# HTTP proxy port + host-side control-API port. Mirrors the\n-# `VPN_INSTANCES` env var format\n-# (vpn-1:8001:8881,vpn-2:8002:8882,...). The env var, when set, wins\n-# over the values here so a single .env can drive both the compose\n-# template and the leak-guard probe.\n-\n-[[vpn_instances]]\n-name = \"vpn-1\"\n-http_proxy_port = 8001\n-control_port = 8881\n-\n-[[vpn_instances]]\n-name = \"vpn-2\"\n-http_proxy_port = 8002\n-control_port = 8882\n-\n-[[vpn_instances]]\n-name = \"vpn-3\"\n-http_proxy_port = 8003\n-control_port = 8883\n-\n-# =====================================================================\n-# Phase 8 — Per-site proxy routing\n-# ---------------------------------------------------------------------\n-# Everything below this banner is OPTIONAL. Omitting the entire\n-# `[proxies.*]` / `[fallback_chain]` block keeps Phase 6d behaviour:\n-# Surfshark tier (from `vpn_instances` above) is the only proxy and\n-# `direct` is only legal when `require_vpn = false`.\n-#\n-# CRITICAL SECRET RULE: any `url = \"...\"` containing a literal username\n-# or password is REJECTED at load. Use `${ENV_VAR}` placeholders and\n-# list the env vars in `auth_env = [...]`. Missing env vars on a tier\n-# with `enabled_by_default = false` silently disable that tier; missing\n-# env vars on a default-on tier are a fatal config error.\n-# =====================================================================\n-\n-# ---------------------------------------------------------------------\n-# [proxies.<name>] — named proxy tier slots.\n-#\n-# `name` is the identifier referenced from `authorized.toml ::\n-# proxy_tier` and from `[fallback_chain] auto = [...]`. Reserved names:\n-#   - \"direct\"  : always implicitly available; redefine only to attach\n-#                 `no_proxy` globs.\n-#   - \"auto\"    : forbidden as a tier name (it's a resolution mode).\n-#\n-# Required fields: `type`, `strength`.\n-# Conditional:     `url`           if type ∈ {http, socks5}\n-#                  `instances_from` if type = http-pool\n-#                  `auth_env`      if `url` contains `${VAR}`\n-#\n-# `strength` (ordering used by `min_proxy_strength` gate in\n-# authorized.toml): none < datacenter < residential < mobile.\n-# ---------------------------------------------------------------------\n-\n-[proxies.direct]\n-type = \"none\"\n-strength = \"none\"\n-# Optional host globs that should always bypass any proxy even when a\n-# higher tier is selected. Useful for `*.lan`, `localhost`, internal\n-# corporate IPs, etc.\n-no_proxy = [\"localhost\", \"127.0.0.1\", \"::1\"]\n-\n-[proxies.surfshark]\n-type = \"http-pool\"\n-# v2 grammar: the only legal value is the symbolic reference below.\n-# Future versions may allow naming a second pool.\n-instances_from = \"policy.vpn_instances\"\n-strength = \"datacenter\"\n-\n-# Cloudflare WARP example (commented out; uncomment after `warp-cli\n-# mode proxy && warp-cli connect`). Resolver health-checks via a single\n-# TCP-connect on first use; if WARP isn't running the tier is marked\n-# unavailable without erroring out.\n-#\n-# [proxies.warp]\n-# type = \"socks5\"\n-# url = \"socks5://127.0.0.1:40000\"\n-# strength = \"datacenter\"\n-# no_proxy = []\n-\n-# IPRoyal residential example (commented out — paid tier).\n-# `enabled_by_default = false` means the tier stays DISABLED until both\n-# env vars are set in the process environment AND a target explicitly\n-# references `proxy_tier = \"iproyal\"` (or `iproyal` is listed in\n-# `[fallback_chain] auto`). This is the \"ship the wiring, don't bill\n-# anyone by accident\" pattern.\n-#\n-# [proxies.iproyal]\n-# type = \"http\"\n-# url = \"http://${IPROYAL_USER}:${IPROYAL_PASS}@residential.iproyal.com:12321\"\n-# auth_env = [\"IPROYAL_USER\", \"IPROYAL_PASS\"]\n-# strength = \"residential\"\n-# enabled_by_default = false\n-# rotation = \"per-session\"        # one of: per-request | per-session | sticky\n-# country_filter = [\"JP\", \"US\"]   # informational; provider-side username syntax\n-\n-# Other commercial providers follow the same schema — copy the\n-# iproyal block and change url/auth_env/strength as appropriate.\n-# Examples (kept in comments only; no implicit activation):\n-#\n-#   [proxies.brightdata]\n-#   type = \"http\"\n-#   url = \"http://${BRD_USER}-country-jp:${BRD_PASS}@brd.superproxy.io:22225\"\n-#   auth_env = [\"BRD_USER\", \"BRD_PASS\"]\n-#   strength = \"residential\"\n-#   enabled_by_default = false\n-#\n-#   [proxies.oxylabs]\n-#   type = \"http\"\n-#   url = \"http://customer-${OXY_USER}-cc-jp:${OXY_PASS}@pr.oxylabs.io:7777\"\n-#   auth_env = [\"OXY_USER\", \"OXY_PASS\"]\n-#   strength = \"residential\"\n-#   enabled_by_default = false\n-\n-# ---------------------------------------------------------------------\n-# [fallback_chain] — auto-mode tier ordering.\n-#\n-# Used when a target's `proxy_tier = \"auto\"` (or omitted entirely).\n-# Listed tiers are tried in order; the first `fail_signals` hit\n-# rotates to the next tier. A tier with `enabled_by_default = false`\n-# whose env vars are unset is silently skipped. The chain is further\n-# filtered per-target by `min_proxy_strength`.\n-#\n-# Paid tiers MUST be added here explicitly — never implicitly. If you\n-# want IPRoyal in the auto chain, list it below AND ensure the env\n-# vars are exported.\n-# ---------------------------------------------------------------------\n-\n-[fallback_chain]\n-# Default chain if a target uses `proxy_tier = \"auto\"`. Order matters.\n-auto = [\"direct\", \"surfshark\"]\n-# Signals that consume one tier-attempt and advance to the next.\n-# Anything else (e.g. http_500, dns_failure of a non-proxy host) is\n-# returned to the caller without rotating.\n-fail_signals = [\"timeout\", \"http_403\", \"http_429\", \"tls_handshake_failed\", \"connection_refused\"]\n-# Per-tier attempt count before advancing.\n-max_attempts_per_tier = 1\n-# Minimum sleep between tier attempts (mitigates request-storm signals).\n-cooldown_ms_between_tiers = 250\n-# Days a recipe-recorded tier blacklist entry stays effective.\n-blacklist_ttl_days = 14\n"
}

