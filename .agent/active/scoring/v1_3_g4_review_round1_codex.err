    38	#[derive(Args, Debug, Clone, Default)]
    39	pub struct OutputFormatOverride {
    40	    /// Output format for this subcommand: `human` (default) or `json`.
    41	    /// Shadows the global `--format` for this invocation. Same value enum
    42	    /// as the global flag; the JSON output is documented under
    43	    /// `docs/json-schemas/cli/<subcommand>.output.json`.
    44	    #[arg(long = "output-format", value_enum)]
    45	    pub output_format: Option<OutputFormat>,
    46	}
    47	
    48	impl OutputFormatOverride {
    49	    /// Resolve the effective output format: the local override if present,
    50	    /// otherwise the global `--format` value.
    51	    pub fn resolve(&self, global: OutputFormat) -> OutputFormat {
    52	        self.output_format.unwrap_or(global)
    53	    }
    54	}

