   609	fn run_show(locs: &ConfigLocations, format: ConfigFormat) -> i32 {
   610	    let value = build_show_value(locs);
   611	    emit(&value, format);
   612	    0
   613	}
   614	
   615	/// Build the merged JSON view used by both `show` and `get`. Secret-looking
   616	/// env values are pre-redacted here so no caller can accidentally surface
   617	/// raw secrets.
   618	pub fn build_show_value(locs: &ConfigLocations) -> JsonValue {
   619	    // Reviewer round-1 finding: redaction MUST be recursive over every parsed
   620	    // config layer, not only env collection. Site recipes / policy URLs /
   621	    // authorized.toml can carry header tokens, basic-auth credentials, or
   622	    // bearer strings — any object key matching `key_looks_secret` has its
   623	    // leaf value replaced before serialization.
   624	    let policy = redact_json_tree(&read_toml_as_json(&locs.policy));
   625	    let authorized = redact_json_tree(&read_toml_as_json(&locs.authorized));
   626	    let sites = redact_json_tree(&read_sites_dir(&locs.sites_dir));
   627	    let env = collect_redacted_env();
   628	    json!({
   629	        "policy": policy,
   630	        "authorized": authorized,
   631	        "sites": sites,
   632	        "env": env,
   633	    })
   634	}
   635	
   636	/// Walk a JSON tree and replace any leaf whose ancestor object key looks like
   637	/// a secret with the `<redacted>` sentinel. Arrays are descended into but
   638	/// their indices do not themselves carry "secret-shaped" keys.
   639	pub fn redact_json_tree(value: &JsonValue) -> JsonValue {
   640	    match value {
   641	        JsonValue::Object(map) => {
   642	            let mut out = serde_json::Map::with_capacity(map.len());
   643	            for (k, v) in map {
   644	                if key_looks_secret(k) {
   645	                    out.insert(k.clone(), JsonValue::String(REDACTED.to_string()));
   646	                } else {
   647	                    out.insert(k.clone(), redact_json_tree(v));
   648	                }
   649	            }
   650	            JsonValue::Object(out)
   651	        }
   652	        JsonValue::Array(arr) => JsonValue::Array(arr.iter().map(redact_json_tree).collect()),
   653	        other => other.clone(),
   654	    }
   655	}
   656	
   657	fn read_toml_as_json(path: &Path) -> JsonValue {
   658	    if !path.exists() {
   659	        return JsonValue::Null;
   660	    }
   661	    let Ok(text) = std::fs::read_to_string(path) else {
   662	        return JsonValue::Null;
   663	    };
   664	    match toml::from_str::<toml::Value>(&text) {
   665	        Ok(v) => serde_json::to_value(v).unwrap_or(JsonValue::Null),
   666	        Err(e) => json!({ "_parse_error": e.to_string() }),
   667	    }
   668	}
   669	
   670	fn read_sites_dir(dir: &Path) -> JsonValue {
   671	    if !dir.is_dir() {
   672	        return JsonValue::Null;
   673	    }
   674	    let mut entries: BTreeMap<String, JsonValue> = BTreeMap::new();
   675	    let Ok(rd) = std::fs::read_dir(dir) else {
   676	        return JsonValue::Null;
   677	    };
   678	    for entry in rd.flatten() {
   679	        let path = entry.path();
   680	        if path.extension().and_then(|s| s.to_str()) != Some("toml") {
   681	            continue;
   682	        }
   683	        let name = path
   684	            .file_name()
   685	            .and_then(|s| s.to_str())
   686	            .unwrap_or("")
   687	            .to_string();
   688	        entries.insert(name, read_toml_as_json(&path));
   689	    }
   690	    serde_json::to_value(entries).unwrap_or(JsonValue::Null)
   691	}
   692	
   693	/// Surface the tracked env subset, redacting any value whose key matches a
   694	/// secret-looking pattern. The redaction policy is conservative on purpose:
   695	/// when unsure, redact.
   696	fn collect_redacted_env() -> JsonValue {
   697	    let mut out: BTreeMap<String, JsonValue> = BTreeMap::new();
   698	    for key in TRACKED_ENV {
   699	        match std::env::var(key) {
   700	            Ok(value) => {
   701	                let surfaced = if key_looks_secret(key) {
   702	                    REDACTED.to_string()
   703	                } else {
   704	                    value
   705	                };
   706	                out.insert((*key).to_string(), JsonValue::String(surfaced));
   707	            }
   708	            Err(_) => {
   709	                out.insert((*key).to_string(), JsonValue::Null);
   710	            }
   711	        }
   712	    }
   713	    // Sweep the live env for anything secret-looking that callers will
   714	    // recognize, but only surface that they exist — never the value.
   715	    for (k, _v) in std::env::vars() {
   716	        if key_looks_secret(&k) && !out.contains_key(&k) {
   717	            out.insert(k, JsonValue::String(REDACTED.to_string()));
   718	        }
   719	    }
   720	    serde_json::to_value(out).unwrap_or(JsonValue::Null)
   721	}
   722	
   723	/// Conservative secret-key heuristic. Case-insensitive substring match on
   724	/// well-known credential nouns. Returns true → value MUST be redacted.
   725	pub fn key_looks_secret(key: &str) -> bool {
   726	    let k = key.to_ascii_lowercase();
   727	    const NEEDLES: &[&str] = &[
   728	        "password",
   729	        "passwd",
   730	        "secret",
   731	        "token",
   732	        "api_key",
   733	        "apikey",
   734	        "cookie",
   735	        "auth",
   736	        "credential",
   737	        "private_key",
   738	    ];
   739	    NEEDLES.iter().any(|n| k.contains(n))
   740	}
   741	
   742	// ---------- paths ----------------------------------------------------------
   743	
   744	#[derive(Debug, Serialize)]
   745	pub struct PathEntry {
   746	    pub label: &'static str,
   747	    pub path: String,
   748	    pub exists: bool,
   749	    pub is_dir: bool,
   750	    pub mode_octal: Option<String>,
   751	}
   752	
   753	fn run_paths(locs: &ConfigLocations, format: ConfigFormat) -> i32 {
   754	    let entries = build_path_entries(locs);
   755	    let value = serde_json::to_value(&entries).unwrap_or(JsonValue::Null);
   756	    if format == ConfigFormat::Text {
   757	        for e in &entries {
   758	            let mode = e.mode_octal.as_deref().unwrap_or("----");
   759	            let kind = if e.is_dir { "dir " } else { "file" };
   760	            let exist = if e.exists { "OK " } else { "MISS" };
   761	            println!("{:<18} {} {} {} {}", e.label, exist, kind, mode, e.path);
   762	        }
   763	    } else {
   764	        emit(&value, format);
   765	    }
   766	    0
   767	}
   768	
   769	pub fn build_path_entries(locs: &ConfigLocations) -> Vec<PathEntry> {
   770	    vec![
   771	        path_entry("policy", &locs.policy),
   772	        path_entry("authorized", &locs.authorized),
   773	        path_entry("sites_dir", &locs.sites_dir),
   774	        path_entry("templates_policy", &locs.templates_policy),
   775	    ]
   776	}
   777	
   778	fn path_entry(label: &'static str, path: &Path) -> PathEntry {
   779	    let absolute = std::fs::canonicalize(path)
   780	        .unwrap_or_else(|_| path.to_path_buf())
   781	        .to_string_lossy()
   782	        .into_owned();
   783	    let exists = path.exists();
   784	    let is_dir = path.is_dir();
   785	    let mode_octal = mode_octal_for(path);
   786	    PathEntry {
   787	        label,
   788	        path: absolute,
   789	        exists,
   790	        is_dir,
   791	        mode_octal,
   792	    }
   793	}
   794	
   795	#[cfg(unix)]
   796	fn mode_octal_for(path: &Path) -> Option<String> {
   797	    use std::os::unix::fs::PermissionsExt;
   798	    let meta = std::fs::metadata(path).ok()?;
   799	    Some(format!("{:o}", meta.permissions().mode() & 0o7777))
   800	}
   801	
   802	#[cfg(not(unix))]
   803	fn mode_octal_for(_path: &Path) -> Option<String> {
   804	    None
   805	}
   806	
   807	// ---------- validate -------------------------------------------------------
   808	
   809	fn run_validate(locs: &ConfigLocations, format: ConfigFormat) -> i32 {
   810	    let mut all_reports: Vec<(String, ValidationReport)> = Vec::new();
   811	    let mut read_errors: Vec<(String, String)> = Vec::new();
   812	    let opts = ValidateOptions::strict();
   813	    // Reviewer round-1 finding: an unreadable-but-present file MUST NOT be
   814	    // silently skipped. Convert read errors into a synthetic failing report
   815	    // so `validate` cannot return 0 for a file the operator demonstrably
   816	    // intended to check.
   817	    if locs.policy.exists() {
   818	        match std::fs::read_to_string(&locs.policy) {
   819	            Ok(text) => all_reports.push((
   820	                locs.policy.display().to_string(),
   821	                validate_toml_against::<Policy>(&text, &opts),
   822	            )),
   823	            Err(e) => read_errors.push((locs.policy.display().to_string(), e.to_string())),
   824	        }
   825	    }
   826	    if locs.authorized.exists() {
   827	        match std::fs::read_to_string(&locs.authorized) {
   828	            Ok(text) => all_reports.push((
   829	                locs.authorized.display().to_string(),
   830	                validate_authorized_toml(&text, &opts),
   831	            )),
   832	            Err(e) => read_errors.push((locs.authorized.display().to_string(), e.to_string())),
   833	        }
   834	    }
   835	    let any_err = all_reports.iter().any(|(_, r)| !r.is_ok()) || !read_errors.is_empty();
   836	    if format == ConfigFormat::Text {
   837	        for (path, r) in &all_reports {
   838	            if r.is_ok() {
   839	                println!("OK   {path}");
   840	            } else {
   841	                for issue in &r.errors {
   842	                    println!(
   843	                        "FAIL {path}: [{:?}] {} @ {}",
   844	                        issue.code, issue.message, issue.path
   845	                    );
   846	                }
   847	            }
   848	        }
   849	        for (path, err) in &read_errors {
   850	            println!("FAIL {path}: [ReadError] {err}");
   851	        }
   852	        if all_reports.is_empty() && read_errors.is_empty() {
   853	            println!("OK   (no live config files present)");
   854	        }
   855	    } else {
   856	        let payload = json!({
   857	            "ok": !any_err,
   858	            "reports": all_reports
   859	                .iter()
   860	                .map(|(p, r)| {
   861	                    json!({
   862	                        "path": p,
   863	                        "ok": r.is_ok(),
   864	                        "errors": r.errors.iter().map(|i| json!({
   865	                            "path": i.path,
   866	                            "code": format!("{:?}", i.code),
   867	                            "message": i.message,
   868	                            "hint": i.hint,
   869	                        })).collect::<Vec<_>>(),
   870	                    })
   871	                })
   872	                .collect::<Vec<_>>(),
   873	            "read_errors": read_errors
   874	                .iter()
   875	                .map(|(p, e)| json!({ "path": p, "error": e }))
   876	                .collect::<Vec<_>>(),
   877	        });
   878	        emit(&payload, format);
   879	    }
   880	    if any_err {
   881	        1
   882	    } else {
   883	        0
   884	    }
   885	}
   886	
   887	// ---------- diff -----------------------------------------------------------
   888	
   889	fn run_diff(live: &Path, baseline: &Path, format: ConfigFormat) -> i32 {
   890	    let live_text = std::fs::read_to_string(live).unwrap_or_default();
   891	    let base_text = std::fs::read_to_string(baseline).unwrap_or_default();
   892	    let diff = unified_diff(
   893	        &base_text,
   894	        &live_text,
   895	        &baseline.display().to_string(),
   896	        &live.display().to_string(),
   897	    );
   898	    if format == ConfigFormat::Text {
   899	        print!("{diff}");
   900	    } else {
   901	        emit(&json!({ "diff": diff }), format);
   902	    }
   903	    0
   904	}
   905	
   906	/// Minimal unified-diff producer. Emits `--- a/<base>` / `+++ b/<live>`
   907	/// headers and a single hunk covering the whole file. Sufficient for the
   908	/// operator-facing `config diff` use case (we are not implementing full
   909	/// Myers diff here); reviewers should see the headers and per-line +/- in
   910	/// stable order.
   911	pub fn unified_diff(base: &str, live: &str, base_label: &str, live_label: &str) -> String {
   912	    let base_lines: Vec<&str> = base.lines().collect();
   913	    let live_lines: Vec<&str> = live.lines().collect();
   914	    let mut out = String::new();
   915	    out.push_str(&format!("--- a/{base_label}\n"));
   916	    out.push_str(&format!("+++ b/{live_label}\n"));
   917	    out.push_str(&format!(
   918	        "@@ -1,{} +1,{} @@\n",
   919	        base_lines.len().max(1),
   920	        live_lines.len().max(1)
   921	    ));
   922	    let max = base_lines.len().max(live_lines.len());
   923	    for i in 0..max {
   924	        match (base_lines.get(i), live_lines.get(i)) {
   925	            (Some(b), Some(l)) if b == l => {
   926	                out.push(' ');
   927	                out.push_str(b);
   928	                out.push('\n');
   929	            }
   930	            (Some(b), Some(l)) => {
   931	                out.push('-');
   932	                out.push_str(b);
   933	                out.push('\n');
   934	                out.push('+');
   935	                out.push_str(l);
   936	                out.push('\n');
   937	            }
   938	            (Some(b), None) => {
   939	                out.push('-');
   940	                out.push_str(b);
   941	                out.push('\n');
   942	            }
   943	            (None, Some(l)) => {
   944	                out.push('+');
   945	                out.push_str(l);
   946	                out.push('\n');
   947	            }
   948	            (None, None) => {}
   949	        }
   950	    }
   951	    out
   952	}
   953	
   954	// ---------- get ------------------------------------------------------------
   955	
   956	fn run_get(locs: &ConfigLocations, key: &str, format: ConfigFormat) -> i32 {
   957	    let merged = build_show_value(locs);
   958	    match resolve_dotted(&merged, key) {
   959	        Some(value) => {
   960	            let redacted = redact_if_secret(key, &value);
   961	            if format == ConfigFormat::Text {
   962	                match &redacted {
   963	                    JsonValue::String(s) => println!("{s}"),
   964	                    other => println!("{other}"),
   965	                }
   966	            } else {
   967	                emit(&json!({ "key": key, "value": redacted }), format);
   968	            }
   969	            0
   970	        }
   971	        None => {
   972	            if format == ConfigFormat::Text {
   973	                eprintln!("key not found: {key}");
   974	            } else {
   975	                emit(
   976	                    &json!({ "key": key, "value": null, "error": "not_found" }),
   977	                    format,
   978	                );
   979	            }
   980	            1
   981	        }
   982	    }
   983	}
   984	
   985	/// Resolve a dotted JSON path. Segments are looked up as object keys; numeric
   986	/// segments index into arrays. Returns `None` for missing keys.
   987	pub fn resolve_dotted(root: &JsonValue, key: &str) -> Option<JsonValue> {
   988	    let mut cur: &JsonValue = root;
   989	    for seg in key.split('.') {
   990	        cur = match cur {
   991	            JsonValue::Object(map) => map.get(seg)?,
   992	            JsonValue::Array(arr) => {
   993	                let idx: usize = seg.parse().ok()?;
   994	                arr.get(idx)?
   995	            }
   996	            _ => return None,
   997	        };
   998	    }
   999	    Some(cur.clone())
  1000	}
  1001	
  1002	fn redact_if_secret(key: &str, value: &JsonValue) -> JsonValue {
  1003	    // If any path segment looks secret, redact the leaf value.
  1004	    let secret = key.split('.').any(key_looks_secret);
  1005	    if secret {
  1006	        JsonValue::String(REDACTED.to_string())
  1007	    } else {
  1008	        value.clone()
  1009	    }
  1010	}
  1011	
  1012	// ---------- emit -----------------------------------------------------------
  1013	
  1014	fn emit(value: &JsonValue, format: ConfigFormat) {
  1015	    match format {
  1016	        ConfigFormat::Json => {
  1017	            println!(
  1018	                "{}",
  1019	                serde_json::to_string_pretty(value).unwrap_or_default()
  1020	            );
  1021	        }
  1022	        ConfigFormat::Yaml => {
  1023	            println!(
  1024	                "{}",
  1025	                serde_yaml::to_string(value).unwrap_or_else(|e| format!("# yaml-error: {e}"))
  1026	            );
  1027	        }
  1028	        ConfigFormat::Text => {
  1029	            // Text-mode for `show`/`get` falls back to pretty JSON since the
  1030	            // merged view is intrinsically nested. `paths` / `validate` /
  1031	            // `diff` already handle text mode themselves.
  1032	            println!(
  1033	                "{}",
  1034	                serde_json::to_string_pretty(value).unwrap_or_default()
  1035	            );
  1036	        }
  1037	    }
  1038	}

codex
One schema concern is worth validating against live behavior: the new config schema describes action-tagged objects, but the existing config emitter may still print raw payloads without an `action` discriminator. I’m sampling the local binary output to confirm whether that is a real mismatch.
