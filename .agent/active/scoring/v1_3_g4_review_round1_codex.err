    42	#[derive(Parser, Debug)]
    43	#[command(
    44	    name = "rev-stealth",
    45	    version,
    46	    about = "Defender-facing evaluation toolkit: captcha resilience / browser stealth / VPN rotation / adaptive scraping (authorized targets only)",
    47	    long_about = None,
