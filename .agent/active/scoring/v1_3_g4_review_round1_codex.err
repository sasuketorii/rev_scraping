    49	struct Cli {
    50	    /// Output format for agent / human consumers. Default `human`; pass
    51	    /// `json` for machine-parseable output.
    52	    ///
    53	    /// v1.3 Lane G.4: the global flag remains `--format` (Human|Json) for
    54	    /// backward compatibility with v1.2.x. Most subcommands also expose a
    55	    /// per-subcommand `--output-format` flag with the same value enum, which
    56	    /// shadows the global within the subtree. Two subcommands extend the
    57	    /// enum locally — `doctor --output-format {json|text}` and
    58	    /// `config --output-format {text|json|yaml}` — because those surfaces
    59	    /// pre-date the unified flag. The full matrix and JSON schemas live
    60	    /// under `docs/json-schemas/cli/`.
    61	    #[arg(long, value_enum, default_value_t = OutputFormat::Human, global = true)]
    62	    format: OutputFormat,
    63	
    64	    /// Verbose logging (`-v`, `-vv`, `-vvv`).
    65	    #[arg(short, long, action = clap::ArgAction::Count, global = true)]
    66	    verbose: u8,
    67	
    68	    #[command(subcommand)]
    69	    command: Command,
    70	}
    71	
    72	#[derive(Copy, Clone, Debug, ValueEnum)]
    73	pub(crate) enum OutputFormat {
    74	    Human,
    75	    Json,
    76	}
