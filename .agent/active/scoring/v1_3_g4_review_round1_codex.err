   337	#[derive(clap::Args, Debug)]
   338	struct CompletionsArgs {
   339	    /// Target shell. Supported: bash, zsh, fish, nushell (elvish is intentionally
   340	    /// excluded from the v1.3 supported matrix — add if/when CI gains coverage).
   341	    #[arg(value_enum)]
   342	    shell: CompletionShell,
   343	}
   344	
   345	#[derive(Copy, Clone, Debug, clap::ValueEnum)]
   346	enum CompletionShell {
   347	    Bash,
   348	    Zsh,
   349	    Fish,
   350	    Nushell,
   351	}
   352	
   353	fn init_tracing(verbose: u8) {
   354	    let level = match verbose {
   355	        0 => "warn",
   356	        1 => "info",
   357	        2 => "debug",
   358	        _ => "trace",
   359	    };
   360	    let _ = tracing_subscriber::fmt()
   361	        .with_env_filter(
   362	            tracing_subscriber::EnvFilter::try_from_default_env()
   363	                .unwrap_or_else(|_| tracing_subscriber::EnvFilter::new(level)),
   364	        )
   365	        .with_target(false)
   366	        .try_init();
   367	}
   368	
   369	/// CLI entrypoint exposed for both the local `main.rs` forwarder and
   370	/// downstream embedders that want to drive `rev-stealth` programmatically.
   371	///
   372	/// Returns the process exit code as an `i32` matching
   373	/// [`stealth_core::ExitCode`]. Builds an owned multi-thread Tokio runtime
   374	/// per call; do not call from inside an existing Tokio runtime.
   375	pub fn run() -> i32 {
   376	    let runtime = tokio::runtime::Builder::new_multi_thread()
   377	        .enable_all()
   378	        .build()
   379	        .expect("build tokio runtime for rev-stealth CLI");
   380	    runtime.block_on(run_async())
   381	}
   382	
   383	/// Async core of [`run`]. Parses argv, initialises tracing, and dispatches
   384	/// to the requested subcommand. Returns the exit code without calling
   385	/// `std::process::exit` so callers can perform cleanup.
   386	pub async fn run_async() -> i32 {
   387	    let cli = Cli::parse();
   388	    init_tracing(cli.verbose);
   389	
   390	    // v1.3 Lane G.4: each subcommand that owns an Args struct now flattens an
   391	    // `OutputFormatOverride` shim, so `--output-format` works both at the root
   392	    // (via global `--format`'s positional-tolerant alias is *not* used — global
   393	    // remains `--format`) and per-subcommand. The shim resolves to the global
   394	    // value when the user did not pass `--output-format`.
   395	    match cli.command {
   396	        Command::Captcha {
   397	            action,
   398	            output_format,
   399	        } => captcha_cmd::run(output_format.resolve(cli.format), action)
   400	            .await
   401	            .as_i32(),
   402	        Command::Browser {
   403	            action,
   404	            output_format,
   405	        } => browser_cmd::run(output_format.resolve(cli.format), action)
   406	            .await
   407	            .as_i32(),
   408	        Command::Vpn {
   409	            action,
   410	            output_format,
   411	        } => vpn_cmd::run(output_format.resolve(cli.format), action)
   412	            .await
   413	            .as_i32(),
   414	        Command::Doctor(args) => doctor::run(cli.format, args).await.as_i32(),
   415	        Command::Spider(args) => {
   416	            let fmt = args.output_format.resolve(cli.format);
   417	            commands::spider::run(fmt, args).await
   418	        }
   419	        Command::Relocate(args) => {
   420	            let fmt = args.output_format.resolve(cli.format);
   421	            commands::relocate::run(fmt, args).await
   422	        }
   423	        Command::CfEvaluate(args) => {
   424	            let fmt = args.output_format.resolve(cli.format);
   425	            commands::cf_evaluate::run(fmt, args).await
   426	        }
   427	        Command::Auth(args) => {
   428	            let fmt = args.output_format.resolve(cli.format);
   429	            commands::auth::run(fmt, args).await
   430	        }
   431	        Command::Measure(args) => {
   432	            let fmt = args.output_format.resolve(cli.format);
   433	            commands::measure::run(fmt, args).await
   434	        }
   435	        Command::Config(args) => commands::config_cli::run(cli.format, args).await,
   436	        Command::Hermes(args) => {
   437	            let fmt = args.output_format.resolve(cli.format);
   438	            commands::hermes::run(fmt, args).await
   439	        }
   440	        Command::Completions(args) => {
   441	            generate_completions(args.shell);
   442	            0
   443	        }
   444	    }
   445	}
   446	
   447	/// Generate a shell completion script for the requested shell and write it to
   448	/// stdout. Lane G.3 (v1.3 Black-Belt CLI) — drives the
   449	/// `scripts/gen_completions.sh` build-time generator and the `completion-drift`
   450	/// CI gate. Reads the clap `Command` tree directly via `CommandFactory` so the
   451	/// completion stays in lockstep with the actual `--help` surface.
   452	///
   453	/// The internal `completions` subcommand itself is stripped from the tree
   454	/// before generation: it is `#[command(hide=true)]` so it is suppressed from
   455	/// `--help`, but `clap_complete::generate` (round 1 reviewer finding) still
   456	/// emits it as a tab-completion suggestion. Filtering at generation time keeps
   457	/// user-facing shell completion in lockstep with `--help`'s public surface.
   458	fn generate_completions(shell: CompletionShell) {
   459	    use clap::CommandFactory;
   460	    let mut cmd = strip_internal_subcommands(Cli::command());
   461	    let bin_name = "rev-stealth";
   462	    let stdout = &mut std::io::stdout();
   463	    match shell {
   464	        CompletionShell::Bash => {
   465	            clap_complete::generate(clap_complete::shells::Bash, &mut cmd, bin_name, stdout);
   466	        }
   467	        CompletionShell::Zsh => {
   468	            clap_complete::generate(clap_complete::shells::Zsh, &mut cmd, bin_name, stdout);
   469	        }
   470	        CompletionShell::Fish => {
