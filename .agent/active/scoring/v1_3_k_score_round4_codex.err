=================================================================\n-# Phase 8 — Per-site proxy routing\n-# ---------------------------------------------------------------------\n-# Everything below this banner is OPTIONAL. Omitting the entire\n-# `[proxies.*]` / `[fallback_chain]` block keeps Phase 6d behaviour:\n-# Surfshark tier (from `vpn_instances` above) is the only proxy and\n-# `direct` is only legal when `require_vpn = false`.\n-#\n-# CRITICAL SECRET RULE: any `url = \"...\"` containing a literal username\n-# or password is REJECTED at load. Use `${ENV_VAR}` placeholders and\n-# list the env vars in `auth_env = [...]`. Missing env vars on a tier\n-# with `enabled_by_default = false` silently disable that tier; missing\n-# env vars on a default-on tier are a fatal config error.\n-# =====================================================================\n-\n-# ---------------------------------------------------------------------\n-# [proxies.<name>] — named proxy tier slots.\n-#\n-# `name` is the identifier referenced from `authorized.toml ::\n-# proxy_tier` and from `[fallback_chain] auto = [...]`. Reserved names:\n-#   - \"direct\"  : always implicitly available; redefine only to attach\n-#                 `no_proxy` globs.\n-#   - \"auto\"    : forbidden as a tier name (it's a resolution mode).\n-#\n-# Required fields: `type`, `strength`.\n-# Conditional:     `url`           if type ∈ {http, socks5}\n-#                  `instances_from` if type = http-pool\n-#                  `auth_env`      if `url` contains `${VAR}`\n-#\n-# `strength` (ordering used by `min_proxy_strength` gate in\n-# authorized.toml): none < datacenter < residential < mobile.\n-# ---------------------------------------------------------------------\n-\n-[proxies.direct]\n-type = \"none\"\n-strength = \"none\"\n-# Optional host globs that should always bypass any proxy even when a\n-# higher tier is selected. Useful for `*.lan`, `localhost`, internal\n-# corporate IPs, etc.\n-no_proxy = [\"localhost\", \"127.0.0.1\", \"::1\"]\n-\n-[proxies.surfshark]\n-type = \"http-pool\"\n-# v2 grammar: the only legal value is the symbolic reference below.\n-# Future versions may allow naming a second pool.\n-instances_from = \"policy.vpn_instances\"\n-strength = \"datacenter\"\n-\n-# Cloudflare WARP example (commented out; uncomment after `warp-cli\n-# mode proxy && warp-cli connect`). Resolver health-checks via a single\n-# TCP-connect on first use; if WARP isn't running the tier is marked\n-# unavailable without erroring out.\n-#\n-# [proxies.warp]\n-# type = \"socks5\"\n-# url = \"socks5://127.0.0.1:40000\"\n-# strength = \"datacenter\"\n-# no_proxy = []\n-\n-# IPRoyal residential example (commented out — paid tier).\n-# `enabled_by_default = false` means the tier stays DISABLED until both\n-# env vars are set in the process environment AND a target explicitly\n-# references `proxy_tier = \"iproyal\"` (or `iproyal` is listed in\n-# `[fallback_chain] auto`). This is the \"ship the wiring, don't bill\n-# anyone by accident\" pattern.\n-#\n-# [proxies.iproyal]\n-# type = \"http\"\n-# url = \"http://${IPROYAL_USER}:${IPROYAL_PASS}@residential.iproyal.com:12321\"\n-# auth_env = [\"IPROYAL_USER\", \"IPROYAL_PASS\"]\n-# strength = \"residential\"\n-# enabled_by_default = false\n-# rotation = \"per-session\"        # one of: per-request | per-session | sticky\n-# country_filter = [\"JP\", \"US\"]   # informational; provider-side username syntax\n-\n-# Other commercial providers follow the same schema — copy the\n-# iproyal block and change url/auth_env/strength as appropriate.\n-# Examples (kept in comments only; no implicit activation):\n-#\n-#   [proxies.brightdata]\n-#   type = \"http\"\n-#   url = \"http://${BRD_USER}-country-jp:${BRD_PASS}@brd.superproxy.io:22225\"\n-#   auth_env = [\"BRD_USER\", \"BRD_PASS\"]\n-#   strength = \"residential\"\n-#   enabled_by_default = false\n-#\n-#   [proxies.oxylabs]\n-#   type = \"http\"\n-#   url = \"http://customer-${OXY_USER}-cc-jp:${OXY_PASS}@pr.oxylabs.io:7777\"\n-#   auth_env = [\"OXY_USER\", \"OXY_PASS\"]\n-#   strength = \"residential\"\n-#   enabled_by_default = false\n-\n-# ---------------------------------------------------------------------\n-# [fallback_chain] — auto-mode tier ordering.\n-#\n-# Used when a target's `proxy_tier = \"auto\"` (or omitted entirely).\n-# Listed tiers are tried in order; the first `fail_signals` hit\n-# rotates to the next tier. A tier with `enabled_by_default = false`\n-# whose env vars are unset is silently skipped. The chain is further\n-# filtered per-target by `min_proxy_strength`.\n-#\n-# Paid tiers MUST be added here explicitly — never implicitly. If you\n-# want IPRoyal in the auto chain, list it below AND ensure the env\n-# vars are exported.\n-# ---------------------------------------------------------------------\n-\n-[fallback_chain]\n-# Default chain if a target uses `proxy_tier = \"auto\"`. Order matters.\n-auto = [\"direct\", \"surfshark\"]\n-# Signals that consume one tier-attempt and advance to the next.\n-# Anything else (e.g. http_500, dns_failure of a non-proxy host) is\n-# returned to the caller without rotating.\n-fail_signals = [\"timeout\", \"http_403\", \"http_429\", \"tls_handshake_failed\", \"connection_refused\"]\n-# Per-tier attempt count before advancing.\n-max_attempts_per_tier = 1\n-# Minimum sleep between tier attempts (mitigates request-storm signals).\n-cooldown_ms_between_tiers = 250\n-# Days a recipe-recorded tier blacklist entry stays effective.\n-blacklist_ttl_days = 14\n"
