  # I.1: cli-public-api snapshot drift gate. Drift = any byte-level diff
  # against `.agent/v1.3/cli-public-api.snapshot.json`. To merge a drifting
  # PR, the contributor must regenerate the snapshot, commit the diff, and
  # apply the `api-additive` (new flag/cmd/env) or `api-breaking` (removed,
  # renamed, semantically changed) PR label.
  cli-public-api-snapshot:
    name: CLI public-API snapshot drift
    runs-on: ubuntu-22.04
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
        with:
          shared-key: ubuntu-22.04-stable
          workspaces: |
            . -> target
      - name: cargo build -p rev-stealth
        run: cargo build -p rev-stealth
      - name: regenerate + check snapshot (HARD — drift always fails)
        run: |
          set -euo pipefail
          # R2 hardening (Codex R2 scoring finding): a contributor MUST commit
          # the regenerated snapshot in the same PR as the change that mutated
          # the public surface — labels NEVER waive this. Why: if the snapshot
          # gate could be waived with `api-additive`, the BASE-vs-HEAD
          # mcp-schema-breaking detector would diff a stale base snapshot
          # against the same stale live snapshot, miss the real breaking
          # change, and let the PR merge with the wrong label.
          #
          # Acceptable PR flow:
          #   1. mutate CLI / MCP source
          #   2. `./scripts/cli-public-api-snapshot.sh` to regenerate
          #   3. commit the snapshot diff in the same PR
          #   4. add `api-additive` / `api-breaking` / `mcp-schema-breaking`
          #      based on the regenerated diff (label classifies; it does
          #      not waive the regeneration requirement).
          ./scripts/cli-public-api-snapshot.sh --check

  # I.2: cargo-public-api Rust API diff gate (HARD).
  #
  # R2 hardening (Lane I fix-up): promoted from advisory to hard gate. When the
  # rustdoc-JSON-derived public surface of any covered crate changes against
  # the PR base, the PR MUST carry exactly one of the labels
  # `api-additive` (new pub items) or `api-breaking` (removed/renamed/retyped
  # pub items). The label check runs unconditionally on PR; the diff step then
  # fails closed if a drift exists without the corresponding label.
  #
  # Rationale: the v1.3 R1 advisory mode meant a reviewer could miss a silent
  # `pub` removal. The R2 hard gate forces an explicit ack via PR label and
  # makes the snapshot pipeline (Lane I.1) and Rust pub-API pipeline (I.2)
  # symmetric in enforcement strength.
  cargo-public-api-diff:
    name: cargo-public-api diff (hard gate)
    runs-on: ubuntu-22.04
    timeout-minutes: 30
    # NOTE: continue-on-error intentionally OMITTED — this is now blocking.
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      # cargo-public-api consumes rustdoc JSON, whose schema changes per
      # nightly. Pin the nightly to the date that cargo-public-api 0.39.x is
      # validated against (see
      # https://github.com/cargo-public-api/cargo-public-api/blob/main/scripts/release-helper/src/version_info.rs).
      # Floating `nightly` can break this job between cargo-public-api
      # releases. Re-pin in lockstep when bumping cargo-public-api in v1.4.
      - uses: dtolnay/rust-toolchain@master
        with:
          toolchain: nightly-2024-10-13
      - uses: Swatinem/rust-cache@v2
        with:
          shared-key: ubuntu-22.04-nightly-2024-10-13
          workspaces: |
            . -> target
      - name: install cargo-public-api
        run: cargo install cargo-public-api --locked --version 0.39.0
      - name: fetch base ref
        if: github.event_name == 'pull_request'
        env:
          BASE_REF: ${{ github.event.pull_request.base.ref }}
        run: |
          set -euo pipefail
          git fetch --no-tags --depth=200 origin "$BASE_REF"
      - name: diff against base + enforce label
        if: github.event_name == 'pull_request'
        env:
          BASE_REF: ${{ github.event.pull_request.base.ref }}
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          PR_LABELS_JSON: ${{ toJson(github.event.pull_request.labels) }}
        run: |
          set -euo pipefail
          # cargo-public-api 0.39+ expects a commit range `<base>..<head>`.
          BASE_SHA="$(git rev-parse "origin/$BASE_REF")"
          HEAD_SHA="$(git rev-parse HEAD)"

          # cargo-public-api 0.39.0 returns rc=1 for BOTH "surface diverged
          # under --deny=all" AND "rustdoc/build failure". To distinguish
          # diff-vs-exec-failure we run two passes per crate:
          #
          #   Pass 1: `cargo public-api --package <crate> diff <range>`
          #           — no --deny. rc != 0 ⇒ tool/build/range failure
          #             (a real diff is allowed; the tool only emits the diff
          #              to stdout and exits 0 without --deny).
          #   Pass 2: `cargo public-api --package <crate> diff --deny=all <range>`
          #           — `--deny` MUST come AFTER `diff` (0.39 clap rejects
          #             `--deny` as a top-level option). rc != 0 ⇒ surface
          #             diverged.
          #
          # If pass 1 is healthy and pass 2 is non-zero, we know it is a real
          # diff and the label gate applies. If pass 1 fails, the gate fails
          # closed — labels cannot waive a broken invocation.
          #
          # Workspace coverage (Codex R2 scoring finding): enumerate ALL
          # workspace members that have library targets via cargo metadata
          # instead of hand-listing six. binary-only crates (no [lib]) are
          # silently dropped by cargo-public-api, so we filter to lib targets.
          diff_seen=0
          exec_fail=0
          tmpdir="$(mktemp -d)"
          # Process-substitution pipelines do NOT propagate exit status under
          # `set -euo pipefail` (Codex R2 hardening finding). Materialize the
          # crate list to a temp file with explicit exit-code checks at each
          # stage so a metadata/helper failure cannot pretend "no diff".
          metadata_json="$tmpdir/cargo-metadata.json"
          if ! cargo metadata --no-deps --format-version=1 > "$metadata_json"; then
            echo "::error::cargo metadata --no-deps failed; cannot enumerate workspace lib crates."
            exit 1
          fi
          crate_list="$tmpdir/workspace-libs.txt"
          if ! python3 scripts/workspace-lib-crates.py < "$metadata_json" > "$crate_list"; then
            echo "::error::scripts/workspace-lib-crates.py failed; cannot enumerate workspace lib crates."
            exit 1
          fi
          mapfile -t WORKSPACE_LIBS < "$crate_list"
          if [[ "${#WORKSPACE_LIBS[@]}" -eq 0 ]]; then
            echo "::error::workspace lib crate list is empty — refusing to fall through with zero coverage. Inspect $crate_list."
            exit 1
          fi
          echo "[cargo-public-api] workspace lib crates (${#WORKSPACE_LIBS[@]}): ${WORKSPACE_LIBS[*]}"
          for crate in "${WORKSPACE_LIBS[@]}"; do
            echo "::group::cargo public-api diff -p $crate"

            # Pass 1: smoke run, no --deny. Non-zero ⇒ exec failure.
            smoke_rc=0
            cargo public-api --package "$crate" \
              diff "$BASE_SHA..$HEAD_SHA" \
              > "$tmpdir/${crate}.smoke.out" 2> "$tmpdir/${crate}.smoke.err" \
              || smoke_rc=$?
            cat "$tmpdir/${crate}.smoke.out"
            cat "$tmpdir/${crate}.smoke.err" >&2
            if [[ "$smoke_rc" -ne 0 ]]; then
              echo "::error::cargo public-api -p $crate (pass 1, no --deny) exited rc=$smoke_rc — treating as tool/build failure, NOT a diff. Labels do not waive this."
              exec_fail=1
              echo "::endgroup::"
              continue
            fi

            # Pass 2: deny-all run. Non-zero ⇒ real surface diff.
            deny_rc=0
            cargo public-api --package "$crate" \
              diff --deny=all "$BASE_SHA..$HEAD_SHA" \
              > "$tmpdir/${crate}.deny.out" 2> "$tmpdir/${crate}.deny.err" \
              || deny_rc=$?
            cat "$tmpdir/${crate}.deny.out"
            cat "$tmpdir/${crate}.deny.err" >&2
            if [[ "$deny_rc" -ne 0 ]]; then
              diff_seen=1
            fi
            echo "::endgroup::"
          done

          if [[ "$exec_fail" -ne 0 ]]; then
            echo "::error::cargo-public-api hard gate cannot evaluate label compliance because at least one crate's pass-1 smoke run failed. Fix the underlying tool/build error; labels do not waive this."
            exit 1
          fi

          if [[ "$diff_seen" -eq 0 ]]; then
            echo "[cargo-public-api] no public-surface diff vs $BASE_REF — gate PASS."
            exit 0
          fi

          # Step 2: surface diverged ⇒ a label is mandatory. Read labels from
          # the PR event payload (no extra API call required); fall back to
          # the REST API if the payload is empty (defensive).
          labels_csv="$(printf '%s' "$PR_LABELS_JSON" | python3 -c 'import json,sys; ls=json.load(sys.stdin) or []; print(",".join(l.get("name","") for l in ls))')"
          if [[ -z "$labels_csv" ]]; then
            labels_csv="$(gh api "repos/${GITHUB_REPOSITORY}/issues/${{ github.event.pull_request.number }}/labels" --jq '[.[].name] | join(",")' || echo "")"
          fi
          echo "[cargo-public-api] PR labels = '${labels_csv:-<none>}'"

          has_additive=0
          has_breaking=0
          IFS=',' read -ra arr <<< "$labels_csv"
          for l in "${arr[@]}"; do
            case "$l" in
              api-additive)  has_additive=1 ;;
              api-breaking)  has_breaking=1 ;;
            esac
          done

          if [[ "$has_additive" -eq 0 && "$has_breaking" -eq 0 ]]; then
            echo "::error::cargo-public-api detected a public-surface diff vs $BASE_REF but no \`api-additive\` or \`api-breaking\` PR label is set."
            echo "::error::Decide: pure additions (new pub item, no removal/rename) ⇒ apply \`api-additive\`."
            echo "::error::Decide: any removal, rename, signature change, or visibility narrowing ⇒ apply \`api-breaking\` AND bump per docs/compat.md."
            exit 1
          fi

          if [[ "$has_additive" -eq 1 && "$has_breaking" -eq 1 ]]; then
            echo "::error::Both \`api-additive\` and \`api-breaking\` labels are set; choose exactly one (a PR is either additive or breaking)."
            exit 1
          fi

          echo "[cargo-public-api] surface diverged; one explicit label found ⇒ gate PASS (additive=$has_additive, breaking=$has_breaking)."

  # I.5: MCP tool-schema breaking-change detector. Mirrors mcp-schema-lint
  # but specifically asserts the canonical 16-tool list (Lane I.1 snapshot)
  # has not been mutated. Drift requires `mcp-schema-breaking` PR label.
  mcp-schema-breaking-detector:

