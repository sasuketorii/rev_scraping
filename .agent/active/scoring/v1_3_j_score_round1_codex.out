[book]
title = "rev_scraping — The Black-Belt CLI for AI Agents"
description = "Agent-first documentation for rev-stealth: install, integrate, scrape — without the Crawl4AI / Playwright MCP friction."
authors = ["rev_scraping contributors"]
language = "en"
src = "src"
# Note: full i18n via `mdbook-i18n-helpers` PO files is deferred to v1.4
