# and src/ja/, both linked from SUMMARY.md.

[build]
build-dir = "../../target/book"
create-missing = false

[output.html]
default-theme = "light"
preferred-dark-theme = "navy"
git-repository-url = "https://github.com/sasuketorii/rev_scraping"
edit-url-template = "https://github.com/sasuketorii/rev_scraping/edit/main/docs/book/{path}"
mathjax-support = false
no-section-label = false
site-url = "/rev_scraping/"

[output.html.fold]
