name: Docs (mdBook + rustdoc) → GitHub Pages

on:
  push:
    branches: [main]
    tags: ['v*']
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 1

      - name: Install mdBook
        run: |
          set -euo pipefail
          MDBOOK_VERSION=v0.5.3
          curl -fsSL \
            "https://github.com/rust-lang/mdBook/releases/download/${MDBOOK_VERSION}/mdbook-${MDBOOK_VERSION}-x86_64-unknown-linux-gnu.tar.gz" \
            | tar -xz -C /usr/local/bin

      - name: Install Rust toolchain
        uses: dtolnay/rust-toolchain@stable

      - name: Build mdBook
        working-directory: docs/book
        run: mdbook build

      - name: Build rustdoc (best-effort; warnings non-blocking in v1.3)
        # Lane J.5 staged rollout: rustdoc is published as auxiliary reference,
        # not a release gate. Intra-doc-link warnings in vendored or in-flight
        # crates do not block the mdBook deploy. Tighten to `-D warnings` in
        # v1.4 once every workspace crate has reached the
        # `#![deny(missing_docs)]` bar (currently only stealth-agent-contracts).
        run: cargo doc --workspace --no-deps || true

      - name: Assemble Pages payload
        run: |
          set -euo pipefail
          mkdir -p _site
          cp -R target/book/* _site/

