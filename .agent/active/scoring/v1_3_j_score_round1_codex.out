from pathlib import Path
import json, re
from jsonschema import Draft7Validator
ok=[]; bad=[]
for md in sorted(Path('docs/book/src/en/tools').glob('*.md')):
    if md.name=='README.md': continue
    tool=md.stem
    m=re.search(r'\\*\\*Response\\*\\*.*?"'```json'"\\n(.*?)\\n"'```'"', md.read_text(), re.S)
    env=json.loads(m.group(1)); body=json.loads(env['result']['content'][0]['text'])
    schema=json.loads(Path(f'docs/json-schemas/{tool}.output.json').read_text())
    errs=list(Draft7Validator(schema).iter_errors(body))
    (bad if errs else ok).append(tool)
print('ok:', ', '.join(ok))
print('bad:', ', '.join(bad))
