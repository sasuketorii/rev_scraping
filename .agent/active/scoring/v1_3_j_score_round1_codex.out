from pathlib import Path
import json, re, sys
from jsonschema import Draft7Validator
ok=[]; bad=[]; missing=[]
for md in sorted(Path('docs/book/src/en/tools').glob('*.md')):
    if md.name=='README.md':
        continue
    tool=md.stem
    text=md.read_text()
    m=re.search(r'\\*\\*Response\\*\\*.*?"'```json'"\\n(.*?)\\n"'```'"', text, re.S)
    if not m:
        missing.append(tool); continue
    env=json.loads(m.group(1))
    body=json.loads(env['result']['content'][0]['text'])
    schema=json.loads(Path(f'docs/json-schemas/{tool}.output.json').read_text())
    errs=list(Draft7Validator(schema).iter_errors(body))
    if errs:
        bad.append((tool, errs[0].message, list(errs[0].path)))
    else:
        ok.append(tool)
print('ok_count',len(ok), ok)
print('missing', missing)
print('bad_count',len(bad))
for b in bad:
    print(b)
