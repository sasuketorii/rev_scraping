     1	name: Coverage
     2	
     3	# Lane K K.1 — `cargo-llvm-cov` soft gate.
     4	#
     5	# v1.3 thresholds: line >= 80% (warn-only / soft gate, primary metric).
     6	# v1.3 branch and function thresholds are TRACKED-ONLY and DO NOT
     7	# constitute v1.3 acceptance:
     8	#   - branch (target 70%): cargo-llvm-cov branch coverage requires
     9	#     nightly toolchain per its docs; v1.3 uses stable for repro, so
    10	#     branch% is reported (often 0 = unsupported) but never warns.
    11	#     Promotion to nightly + --branch is scheduled for v1.4.
    12	#   - function (target 75%): warn-only, informational.
    13	# v1.4 thresholds: line >= 85% / branch >= 75% (hard gate, blocks merge).
    14	#
    15	# The job emits an LCOV artifact + a JSON summary + a PR comment with the
    16	# delta vs main. `--fail-under-lines` and `--fail-under-functions` are
    17	# threaded through `cargo llvm-cov` so the same job can flip from soft to
    18	# hard at v1.4 by removing `continue-on-error: true`.
    19	
    20	on:
    21	  push:
    22	    branches: [main]
    23	  pull_request:
    24	
    25	env:
    26	  CARGO_TERM_COLOR: always
    27	  # v1.3 soft gate. Bump to 85 / 75 at v1.4.
    28	  COVERAGE_LINE_MIN: "80"
    29	  COVERAGE_BRANCH_MIN: "70"
    30	  COVERAGE_FN_MIN: "75"
    31	
    32	jobs:
    33	  llvm-cov:
    34	    name: cargo llvm-cov (soft gate v1.3)
    35	    runs-on: ubuntu-22.04
    36	    timeout-minutes: 45
    37	    # v1.3 soft gate: never block merge. Flip to false at v1.4.
    38	    continue-on-error: true
    39	    permissions:
    40	      contents: read
    41	      pull-requests: write
    42	      # Needed for the baseline lookup step to call `gh run list/download`
    43	      # against the previous main-branch coverage run.
    44	      actions: read
    45	    steps:
    46	      - uses: actions/checkout@v4
    47	        with:
    48	          fetch-depth: 0
    49	      - uses: dtolnay/rust-toolchain@stable
    50	        with:
    51	          components: llvm-tools-preview
    52	      - uses: Swatinem/rust-cache@v2
    53	        with:
    54	          shared-key: ubuntu-22.04-stable-cov
    55	          workspaces: |
    56	            . -> target
    57	      - uses: taiki-e/install-action@v2
    58	        with:
    59	          tool: cargo-llvm-cov
    60	      - name: cargo llvm-cov --workspace (LCOV)
    61	        # Branch coverage (`--branch`) currently requires nightly per
    62	        # cargo-llvm-cov docs; v1.3 uses stable for reproducibility, so
    63	        # we collect line + function coverage only and leave branch%
    64	        # reported as 0 (the gate step treats 0 as "unsupported, do not
    65	        # warn"). Promotion to nightly + --branch is tracked for v1.4.
    66	        run: |
    67	          set -euo pipefail
    68	          cargo llvm-cov --workspace --no-fail-fast \
    69	            --ignore-filename-regex '(tests?/|benches/|examples/|/build\.rs$|crates/obscura-bridge/)' \
    70	            --lcov --output-path lcov.info
    71	      - name: cargo llvm-cov --workspace (JSON summary)
    72	        run: |
    73	          set -euo pipefail
    74	          cargo llvm-cov report --json --summary-only \
    75	            --output-path coverage-summary.json
    76	      - name: Upload LCOV artifact
    77	        uses: actions/upload-artifact@v4
    78	        with:
    79	          name: coverage-lcov
    80	          path: |
    81	            lcov.info
    82	            coverage-summary.json
    83	          if-no-files-found: error
    84	          retention-days: 14
    85	      - name: Enforce coverage thresholds (soft gate v1.3)
    86	        id: gate
    87	        run: |
    88	          set -euo pipefail
    89	          line_pct=$(python3 -c 'import json; d=json.load(open("coverage-summary.json"))["data"][0]["totals"]; print(round(d["lines"]["percent"],2))')
    90	          fn_pct=$(python3 -c 'import json; d=json.load(open("coverage-summary.json"))["data"][0]["totals"]; print(round(d["functions"]["percent"],2))')
    91	          branch_pct=$(python3 -c 'import json; d=json.load(open("coverage-summary.json"))["data"][0]["totals"]; print(round(d.get("branches",{}).get("percent",0.0),2))')
    92	          {
    93	            echo "line=$line_pct"
    94	            echo "branch=$branch_pct"
    95	            echo "fn=$fn_pct"
    96	          } >> "$GITHUB_OUTPUT"
    97	          echo "::notice title=coverage::line=$line_pct% / branch=$branch_pct% / fn=$fn_pct%"
    98	          awk -v a="$line_pct" -v b="$COVERAGE_LINE_MIN" 'BEGIN{exit !(a+0 < b+0)}' && \
    99	            echo "::warning::line coverage $line_pct% < soft gate ${COVERAGE_LINE_MIN}%"
   100	          awk -v a="$fn_pct" -v b="$COVERAGE_FN_MIN" 'BEGIN{exit !(a+0 < b+0)}' && \
   101	            echo "::warning::function coverage $fn_pct% < soft gate ${COVERAGE_FN_MIN}%"
   102	          # Branch warning suppressed for v1.3: cargo-llvm-cov branch
   103	          # coverage needs nightly; stable reports 0%. Re-enable in v1.4
   104	          # alongside nightly toolchain promotion.
   105	          # v1.3 soft gate: exit 0 unconditionally. v1.4 promote to exit 1 on miss.
   106	          exit 0
   107	      # Fetch main's last recorded coverage from the most recent main-branch
   108	      # workflow run artifact, compute delta, and surface it in the PR
   109	      # comment. If the artifact is unavailable (first run, retention
   110	      # eviction), we omit the delta gracefully instead of failing.
   111	      - name: Fetch baseline coverage from main
   112	        id: baseline
   113	        if: github.event_name == 'pull_request'
   114	        continue-on-error: true
   115	        env:
   116	          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
   117	        run: |
   118	          set -euo pipefail
   119	          mkdir -p /tmp/baseline
   120	          run_id=$(gh run list --branch main --workflow coverage.yml \
   121	            --status success --limit 1 --json databaseId \
   122	            -q '.[0].databaseId' 2>/dev/null || echo "")
   123	          if [ -z "$run_id" ]; then
   124	            echo "no baseline coverage run found yet"
   125	            echo "baseline_line=" >> "$GITHUB_OUTPUT"
   126	            exit 0
   127	          fi
   128	          gh run download "$run_id" -n coverage-lcov -D /tmp/baseline \
   129	            || { echo "baseline artifact unavailable"; exit 0; }
   130	          if [ -f /tmp/baseline/coverage-summary.json ]; then
   131	            base_line=$(python3 -c 'import json; d=json.load(open("/tmp/baseline/coverage-summary.json"))["data"][0]["totals"]; print(round(d["lines"]["percent"],2))')
   132	            echo "baseline_line=$base_line" >> "$GITHUB_OUTPUT"
   133	          fi
   134	      - name: Comment on PR with coverage + delta vs main
   135	        if: github.event_name == 'pull_request'
   136	        uses: actions/github-script@v7
   137	        env:
   138	          LINE_PCT: ${{ steps.gate.outputs.line }}
   139	          BRANCH_PCT: ${{ steps.gate.outputs.branch }}
   140	          FN_PCT: ${{ steps.gate.outputs.fn }}
   141	          LINE_MIN: ${{ env.COVERAGE_LINE_MIN }}
   142	          BRANCH_MIN: ${{ env.COVERAGE_BRANCH_MIN }}
   143	          FN_MIN: ${{ env.COVERAGE_FN_MIN }}
   144	          BASELINE_LINE: ${{ steps.baseline.outputs.baseline_line }}
   145	        with:
   146	          script: |
   147	            const line = process.env.LINE_PCT;
   148	            const branch = process.env.BRANCH_PCT;
   149	            const fn = process.env.FN_PCT;
   150	            const lineMin = process.env.LINE_MIN;
   151	            const branchMin = process.env.BRANCH_MIN;
   152	            const fnMin = process.env.FN_MIN;
   153	            const baseLine = process.env.BASELINE_LINE;
   154	            let deltaCell = 'n/a (no baseline)';
   155	            if (baseLine && baseLine.length > 0) {
   156	              const d = (parseFloat(line) - parseFloat(baseLine)).toFixed(2);
   157	              const sign = parseFloat(d) >= 0 ? '+' : '';
   158	              deltaCell = `${sign}${d}% vs main (${baseLine}%)`;
   159	            }
   160	            const body = [
   161	              '### Coverage (Lane K K.1 soft gate)',
   162	              '',
   163	              '| metric | value | v1.3 gate | delta |',
   164	              '| ------ | ----- | --------- | ----- |',
   165	              `| line   | ${line}% | >= ${lineMin}% (soft) | ${deltaCell} |`,
   166	              `| branch | ${branch}% | >= ${branchMin}% (soft, may be 0 if unsupported) | — |`,
   167	              `| fn     | ${fn}% | >= ${fnMin}% (soft) | — |`,
   168	              '',
   169	              '_v1.3 is a soft gate (warn-only). v1.4 promotes to hard gate (85 / 75)._',
   170	            ].join('\n');
   171	            await github.rest.issues.createComment({
   172	              owner: context.repo.owner,
   173	              repo: context.repo.repo,
   174	              issue_number: context.issue.number,
   175	              body,
   176	            });

