.agent/active/scoring/v1_3_k_score_round1_codex.out:2359:# Lane K K.1 — `cargo-llvm-cov` soft gate.
.agent/active/scoring/v1_3_k_score_round1_codex.out:2392:      # against the previous main-branch coverage run.
.agent/active/scoring/v1_3_k_score_round1_codex.out:2410:        # Branch coverage (`--branch`) currently requires nightly per
.agent/active/scoring/v1_3_k_score_round1_codex.out:2412:        # we collect line + function coverage only and leave branch%
.agent/active/scoring/v1_3_k_score_round1_codex.out:2424:            --output-path coverage-summary.json
.agent/active/scoring/v1_3_k_score_round1_codex.out:2428:          name: coverage-lcov
.agent/active/scoring/v1_3_k_score_round1_codex.out:2431:            coverage-summary.json
.agent/active/scoring/v1_3_k_score_round1_codex.out:2434:      - name: Enforce coverage thresholds (soft gate v1.3)
.agent/active/scoring/v1_3_k_score_round1_codex.out:2438:          line_pct=$(python3 -c 'import json; d=json.load(open("coverage-summary.json"))["data"][0]["totals"]; print(round(d["lines"]["percent"],2))')
.agent/active/scoring/v1_3_k_score_round1_codex.out:2439:          fn_pct=$(python3 -c 'import json; d=json.load(open("coverage-summary.json"))["data"][0]["totals"]; print(round(d["functions"]["percent"],2))')
.agent/active/scoring/v1_3_k_score_round1_codex.out:2440:          branch_pct=$(python3 -c 'import json; d=json.load(open("coverage-summary.json"))["data"][0]["totals"]; print(round(d.get("branches",{}).get("percent",0.0),2))')
.agent/active/scoring/v1_3_k_score_round1_codex.out:2444:          echo "::notice title=coverage::line=$line_pct% / branch=$branch_pct% / fn=$fn_pct%"
.agent/active/scoring/v1_3_k_score_round1_codex.out:2446:            echo "::warning::line coverage $line_pct% < soft gate ${COVERAGE_LINE_MIN}%"
.agent/active/scoring/v1_3_k_score_round1_codex.out:2448:            echo "::warning::function coverage $fn_pct% < soft gate ${COVERAGE_FN_MIN}%"
.agent/active/scoring/v1_3_k_score_round1_codex.out:2450:            echo "::warning::branch coverage $branch_pct% < soft gate ${COVERAGE_BRANCH_MIN}%"
.agent/active/scoring/v1_3_k_score_round1_codex.out:2453:      # Fetch main's last recorded coverage from the most recent main-branch
.agent/active/scoring/v1_3_k_score_round1_codex.out:2457:      - name: Fetch baseline coverage from main
.agent/active/scoring/v1_3_k_score_round1_codex.out:2466:          run_id=$(gh run list --branch main --workflow coverage.yml \
.agent/active/scoring/v1_3_k_score_round1_codex.out:2470:            echo "no baseline coverage run found yet"
.agent/active/scoring/v1_3_k_score_round1_codex.out:2474:          gh run download "$run_id" -n coverage-lcov -D /tmp/baseline \
.agent/active/scoring/v1_3_k_score_round1_codex.out:2476:          if [ -f /tmp/baseline/coverage-summary.json ]; then
.agent/active/scoring/v1_3_k_score_round1_codex.out:2477:            base_line=$(python3 -c 'import json; d=json.load(open("/tmp/baseline/coverage-summary.json"))["data"][0]["totals"]; print(round(d["lines"]["percent"],2))')
.agent/active/scoring/v1_3_k_score_round1_codex.out:2480:      - name: Comment on PR with coverage + delta vs main
.agent/active/scoring/v1_3_k_score_round1_codex.out:2507:              '### Coverage (Lane K K.1 soft gate)',
.agent/active/scoring/v1_3_k_score_round1_codex.out:2578:    # Lane K K.2: third gate of the three-point supply-chain check
.agent/active/scoring/v1_3_k_score_round1_codex.out:2601:    # Lane K K.3: enforce `#![forbid(unsafe_code)]` on every crate root.
