     1	name: Bench
     2	
     3	# Lane K K.7 — criterion microbench gate.
     4	#
     5	# v1.3 scope: run the in-tree criterion benches on PR and emit a JSON
     6	# artifact. A follow-up integration (bencher.dev or iai-callgrind in
     7	# offline mode) consumes the artifact to post a per-PR diff comment;
     8	# regression > 10% triggers a "bench-regression" label.
     9	#
    10	# v1.3 is informational-only (continue-on-error: true). v1.4 promotes
    11	# the > 10% rule to a hard gate.
    12	
    13	on:
    14	  pull_request:
    15	    paths:
    16	      - 'crates/**'
    17	      - 'Cargo.toml'
    18	      - 'Cargo.lock'
    19	      - '.github/workflows/bench.yml'
    20	  workflow_dispatch:
    21	
    22	env:
    23	  CARGO_TERM_COLOR: always
    24	
    25	jobs:
    26	  criterion:
    27	    # K.7 5 hot paths: sanitize_walk + canary_scan, aead encrypt+decrypt,
    28	    # mcp dispatch (ping/initialize/tools_list), recipe_load scaling.
    29	    name: cargo bench (${{ matrix.bench.crate }} / ${{ matrix.bench.name }})
    30	    runs-on: ubuntu-22.04
    31	    timeout-minutes: 30
    32	    continue-on-error: true
    33	    strategy:
    34	      fail-fast: false
    35	      matrix:
    36	        bench:
    37	          - { crate: stealth-sanitize, name: sanitize_hotpath }
    38	          - { crate: stealth-auth,     name: aead_hotpath }
    39	          - { crate: stealth-mcp,      name: dispatch_hotpath }
    40	          - { crate: stealth-sites,    name: recipe_load_hotpath }
    41	    steps:
    42	      - uses: actions/checkout@v4
    43	      - uses: dtolnay/rust-toolchain@stable
    44	      - uses: Swatinem/rust-cache@v2
    45	        with:
    46	          shared-key: ubuntu-22.04-stable-bench-${{ matrix.bench.crate }}
    47	          workspaces: |
    48	            . -> target
    49	      - name: cargo bench --no-run
    50	        run: cargo bench -p ${{ matrix.bench.crate }} --bench ${{ matrix.bench.name }} --no-run
    51	      - name: cargo bench (criterion, short)
    52	        run: |
    53	          set -euo pipefail
    54	          cargo bench -p ${{ matrix.bench.crate }} --bench ${{ matrix.bench.name }} -- \
    55	            --warm-up-time 1 --measurement-time 3 --noplot \
    56	            --output-format bencher \
    57	            | tee bench-bencher-${{ matrix.bench.crate }}-${{ matrix.bench.name }}.txt
    58	      - name: Upload criterion JSON
    59	        uses: actions/upload-artifact@v4
    60	        with:
    61	          name: criterion-${{ matrix.bench.crate }}-${{ matrix.bench.name }}-${{ github.sha }}
    62	          path: |
    63	            bench-bencher-${{ matrix.bench.crate }}-${{ matrix.bench.name }}.txt
    64	            target/criterion/**/estimates.json
    65	          if-no-files-found: ignore
    66	          retention-days: 14

